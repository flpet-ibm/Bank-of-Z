 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* INQACC - Inquire Account                                       */
 /* Reads account data from DB2 ACCOUNT table via a cursor.        */
 /* If ACCNO=99999999 gets the last account (highest number).      */
 /***************************************************************** */
*PROCESS SYSTEM(CICS) SQL MARGINS(1,72);
 INQACC: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA (from INQACC.cpy)                                 */
   /*****************************************************************/
   %INCLUDE INQACC;
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR) LIKE INQACC_TMPL;

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* ACCOUNT DB2 table declaration                                 */
   /*****************************************************************/
   EXEC SQL INCLUDE ACCDB2;

   /*****************************************************************/
   /* ACCOUNT cursor declaration                                    */
   /*****************************************************************/
   EXEC SQL DECLARE ACC_CURSOR CURSOR FOR
     SELECT ACCOUNT_EYECATCHER,
            ACCOUNT_CUSTOMER_NUMBER,
            ACCOUNT_SORTCODE,
            ACCOUNT_NUMBER,
            ACCOUNT_TYPE,
            ACCOUNT_INTEREST_RATE,
            ACCOUNT_OPENED,
            ACCOUNT_OVERDRAFT_LIMIT,
            ACCOUNT_LAST_STATEMENT,
            ACCOUNT_NEXT_STATEMENT,
            ACCOUNT_AVAILABLE_BALANCE,
            ACCOUNT_ACTUAL_BALANCE
     FROM ACCOUNT
     WHERE ACCOUNT_SORTCODE = :HV_ACCOUNT_SORTCODE
       AND ACCOUNT_NUMBER   = :HV_ACCOUNT_ACC_NO
     FOR FETCH ONLY;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* ACCOUNT host variables                                        */
   /*****************************************************************/
   DCL 1 HOST_ACCOUNT_ROW,
     3 HV_ACCOUNT_EYECATCHER    CHAR(4),
     3 HV_ACCOUNT_CUST_NO       CHAR(10),
     3 HV_ACCOUNT_SORTCODE      CHAR(6),
     3 HV_ACCOUNT_ACC_NO        CHAR(8),
     3 HV_ACCOUNT_ACC_TYPE      CHAR(8),
     3 HV_ACCOUNT_INT_RATE      FIXED DEC(6,2),
     3 HV_ACCOUNT_OPENED        CHAR(10),
     3 HV_ACCOUNT_OVERDRAFT_LIM FIXED BIN(31),
     3 HV_ACCOUNT_LAST_STMT     CHAR(10),
     3 HV_ACCOUNT_NEXT_STMT     CHAR(10),
     3 HV_ACCOUNT_AVAIL_BAL     FIXED DEC(12,2),
     3 HV_ACCOUNT_ACTUAL_BAL    FIXED DEC(12,2);

   /*****************************************************************/
   /* OUTPUT_DATA - ACCOUNT record                                  */
   /*****************************************************************/
   %INCLUDE ACCOUNT;
   DCL 1 OUTPUT_DATA LIKE ACCOUNT_TMPL;

   /*****************************************************************/
   /* ABNDINFO record                                               */
   /*****************************************************************/
   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* DB2 date reformatter (DATE columns are CHAR(10) YYYY-MM-DD)  */
   /*****************************************************************/
   DCL 1 DB2_DATE_REFORMAT,
     3 DB2_DATE_REF_YR    CHAR(4),
     3 DB2_DATE_SEP1      CHAR(1),
     3 DB2_DATE_REF_MNTH  CHAR(2),
     3 DB2_DATE_SEP2      CHAR(1),
     3 DB2_DATE_REF_DAY   CHAR(2);

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP      FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2     FIXED BIN(31) INIT(0);
   DCL WS_U_TIME         FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE      CHAR(10)      INIT(' ');
   DCL 1 WS_ORIG_DATE_GRP BASED(ADDR(WS_ORIG_DATE)),
         3 WS_ORIG_DATE_DD   CHAR(2),
         3 FILLER_OD1        CHAR(1),
         3 WS_ORIG_DATE_MM   CHAR(2),
         3 FILLER_OD2        CHAR(1),
         3 WS_ORIG_DATE_YYYY CHAR(4);
   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW       CHAR(6)   INIT(' '),
     3 * UNION,
       5 WS_TIME_NOW_STR CHAR(6),
       5 WS_TIME_NOW_GRP,
         7 WS_TIME_NOW_GRP_HH CHAR(2),
         7 WS_TIME_NOW_GRP_MM CHAR(2),
         7 WS_TIME_NOW_GRP_SS CHAR(2);
   DCL WS_ABEND_PGM      CHAR(8)   INIT('ABNDPROC');
   DCL MY_ABEND_CODE     CHAR(4)   INIT(' ');
   DCL WS_STORM_DRAIN    CHAR(1)   INIT('N');
   DCL STORM_DRAIN_COND  CHAR(20)  INIT(' ');
   DCL SQLCODE_DISPLAY   CHAR(9)   INIT(' ');
   DCL 1 ACCOUNT_KY,
     3 REQUIRED_SORT_CODE  CHAR(6) INIT('000000'),
     3 REQUIRED_ACC_NUM    CHAR(8) INIT('00000000');
   DCL 1 ACCOUNT_KY2,
     3 REQUIRED_SORT_CODE2  CHAR(6) INIT('000000'),
     3 REQUIRED_ACC_NUMBER2 CHAR(8) INIT('00000000');
   DCL 1 NCS_ACC_NO_STUFF,
     3 NCS_ACC_NO_NAME,
       5 NCS_ACC_NO_ACT_NAME  CHAR(8)  INIT('HBNKACCT'),
       5 NCS_ACC_NO_TEST_SORT CHAR(6)  INIT(' '),
       5 NCS_ACC_NO_FILL      CHAR(2)  INIT('  '),
     3 NCS_ACC_NO_INC         FIXED BIN(63) INIT(0),
     3 NCS_ACC_NO_VALUE       FIXED BIN(63) INIT(0),
     3 NCS_ACC_NO_RESP        CHAR(2)  INIT('00');

   /******** PREMIERE - main logic ***********************************/
   OUTPUT_DATA = '';
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING);
   REQUIRED_SORT_CODE = SORTCODE;

   IF DFHCOMMAREA.INQACC_ACCNO = '99999999' THEN
     CALL READ_ACCOUNT_LAST;
   ELSE
     CALL READ_ACCOUNT_DB2;

   IF OUTPUT_DATA.ACCOUNT_TYPE = ' ' THEN DO;
     DFHCOMMAREA.INQACC_SUCCESS = 'Y';
   END;
   ELSE DO;
     DFHCOMMAREA.INQACC_EYE        = OUTPUT_DATA.ACCOUNT_EYE_CATCHER;
     DFHCOMMAREA.INQACC_CUSTNO     = OUTPUT_DATA.ACCOUNT_CUST_NO;
     DFHCOMMAREA.INQACC_SCODE      = OUTPUT_DATA.ACCOUNT_SORT_CODE;
     DFHCOMMAREA.INQACC_ACCNO      = OUTPUT_DATA.ACCOUNT_NUMBER;
     DFHCOMMAREA.INQACC_ACC_TYPE   = OUTPUT_DATA.ACCOUNT_TYPE;
     DFHCOMMAREA.INQACC_INT_RATE   = OUTPUT_DATA.ACCOUNT_INTEREST_RATE;
     DFHCOMMAREA.INQACC_OPENED     = OUTPUT_DATA.ACCOUNT_OPENED;
     DFHCOMMAREA.INQACC_OVERDRAFT = OUTPUT_DATA.ACCOUNT_OVERDRAFT_LIMIT;
     DFHCOMMAREA.INQACC_LAST_STMT_DT =
         OUTPUT_DATA.ACCOUNT_LAST_STMT_DATE;
     DFHCOMMAREA.INQACC_NEXT_STMT_DT =
         OUTPUT_DATA.ACCOUNT_NEXT_STMT_DATE;
     DFHCOMMAREA.INQACC_AVAIL_BAL =
         OUTPUT_DATA.ACCOUNT_AVAILABLE_BALANCE;
     DFHCOMMAREA.INQACC_ACTUAL_BAL = OUTPUT_DATA.ACCOUNT_ACTUAL_BALANCE;
     DFHCOMMAREA.INQACC_SUCCESS    = 'Y';
   END;
   CALL GET_ME_OUT_OF_HERE;

   /********** READ_ACCOUNT_DB2 **************************************/
   READ_ACCOUNT_DB2: PROC;
     HV_ACCOUNT_ACC_NO    = DFHCOMMAREA.INQACC_ACCNO;
     HV_ACCOUNT_SORTCODE  = SORTCODE;

     EXEC SQL OPEN ACC_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
       ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'HRAC';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE   = SQLCODE_DISPLAY;
       ABNDINFO_REC.ABND_FREEFORM = 'RAD010 - Failed to OPEN ACC_CURSOR'
           ||
                        ' SQLCODE=' || SQLCODE_DISPLAY;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       CALL CHECK_FOR_STORM_DRAIN;
       EXEC CICS ABEND ABCODE('HRAC') CANCEL NODUMP;
     END;

     CALL FETCH_DATA;

     EXEC SQL CLOSE ACC_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
       ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'HRAC';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE   = SQLCODE_DISPLAY;
       ABNDINFO_REC.ABND_FREEFORM =
           'RAD010 - Failed to CLOSE ACC_CURSOR' ||
                        ' SQLCODE=' || SQLCODE_DISPLAY;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       CALL CHECK_FOR_STORM_DRAIN;
       EXEC CICS ABEND ABCODE('HRAC') CANCEL NODUMP;
     END;
   END READ_ACCOUNT_DB2;

   /********** FETCH_DATA ********************************************/
   FETCH_DATA: PROC;
     EXEC SQL FETCH FROM ACC_CURSOR
       INTO :HV_ACCOUNT_EYECATCHER,
            :HV_ACCOUNT_CUST_NO,
            :HV_ACCOUNT_SORTCODE,
            :HV_ACCOUNT_ACC_NO,
            :HV_ACCOUNT_ACC_TYPE,
            :HV_ACCOUNT_INT_RATE,
            :HV_ACCOUNT_OPENED,
            :HV_ACCOUNT_OVERDRAFT_LIM,
            :HV_ACCOUNT_LAST_STMT,
            :HV_ACCOUNT_NEXT_STMT,
            :HV_ACCOUNT_AVAIL_BAL,
            :HV_ACCOUNT_ACTUAL_BAL;

     IF SQLCODE = 100 THEN DO;
       OUTPUT_DATA = '';
       OUTPUT_DATA.ACCOUNT_SORT_CODE = SORTCODE;
       OUTPUT_DATA.ACCOUNT_NUMBER    = DFHCOMMAREA.INQACC_ACCNO;
       RETURN;
     END;

     IF SQLCODE ^= 0 THEN DO;
       CALL CHECK_FOR_STORM_DRAIN;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
       ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'HRAC';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE   = SQLCODE_DISPLAY;
       ABNDINFO_REC.ABND_FREEFORM =
           'FD010 - Failed FETCH from ACC_CURSOR' ||
                        ' SQLCODE=' || SQLCODE_DISPLAY;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       EXEC CICS ABEND ABCODE('HRAC') CANCEL NODUMP;
     END;

     /* Populate OUTPUT_DATA from host variables */
     OUTPUT_DATA.ACCOUNT_EYE_CATCHER      = HV_ACCOUNT_EYECATCHER;
     OUTPUT_DATA.ACCOUNT_CUST_NO          = HV_ACCOUNT_CUST_NO;
     OUTPUT_DATA.ACCOUNT_SORT_CODE        = HV_ACCOUNT_SORTCODE;
     OUTPUT_DATA.ACCOUNT_NUMBER           = HV_ACCOUNT_ACC_NO;
     OUTPUT_DATA.ACCOUNT_TYPE             = HV_ACCOUNT_ACC_TYPE;
     OUTPUT_DATA.ACCOUNT_INTEREST_RATE    = HV_ACCOUNT_INT_RATE;
     /* DATE columns: CHAR(10) 'YYYY-MM-DD' -> reformat to DDMMYYYY */
     DB2_DATE_REFORMAT = HV_ACCOUNT_OPENED;
     OUTPUT_DATA.ACCOUNT_OPENED_DAY   = DB2_DATE_REF_DAY;
     OUTPUT_DATA.ACCOUNT_OPENED_MONTH = DB2_DATE_REF_MNTH;
     OUTPUT_DATA.ACCOUNT_OPENED_YEAR  = DB2_DATE_REF_YR;
     OUTPUT_DATA.ACCOUNT_OVERDRAFT_LIMIT =
         CHAR(HV_ACCOUNT_OVERDRAFT_LIM,8);
     DB2_DATE_REFORMAT = HV_ACCOUNT_LAST_STMT;
     OUTPUT_DATA.ACCOUNT_LAST_STMT_DAY   = DB2_DATE_REF_DAY;
     OUTPUT_DATA.ACCOUNT_LAST_STMT_MONTH = DB2_DATE_REF_MNTH;
     OUTPUT_DATA.ACCOUNT_LAST_STMT_YEAR  = DB2_DATE_REF_YR;
     DB2_DATE_REFORMAT = HV_ACCOUNT_NEXT_STMT;
     OUTPUT_DATA.ACCOUNT_NEXT_STMT_DAY   = DB2_DATE_REF_DAY;
     OUTPUT_DATA.ACCOUNT_NEXT_STMT_MONTH = DB2_DATE_REF_MNTH;
     OUTPUT_DATA.ACCOUNT_NEXT_STMT_YEAR  = DB2_DATE_REF_YR;
     OUTPUT_DATA.ACCOUNT_AVAILABLE_BALANCE = HV_ACCOUNT_AVAIL_BAL;
     OUTPUT_DATA.ACCOUNT_ACTUAL_BALANCE    = HV_ACCOUNT_ACTUAL_BAL;
   END FETCH_DATA;

   /********** GET_ME_OUT_OF_HERE ************************************/
   GET_ME_OUT_OF_HERE: PROC;
     EXEC CICS RETURN;
   END GET_ME_OUT_OF_HERE;

   /********** CHECK_FOR_STORM_DRAIN *********************************/
   CHECK_FOR_STORM_DRAIN: PROC;
     SELECT(SQLCODE);
       WHEN(923) STORM_DRAIN_COND = 'DB2 Connection lost ';
       OTHERWISE STORM_DRAIN_COND = 'Not Storm Drain     ';
     END;
   END CHECK_FOR_STORM_DRAIN;

   /********** ABEND_HANDLING ****************************************/
   ABEND_HANDLING: PROC;
     EXEC CICS ASSIGN ABCODE(MY_ABEND_CODE);
     SELECT(MY_ABEND_CODE);
       WHEN('AD2Z') DO;
         SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       END;
       WHEN('AFCR','AFCS','AFCT') DO;
         WS_STORM_DRAIN = 'Y';
         EXEC CICS SYNCPOINT ROLLBACK
              RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
           ABNDINFO_REC = '';
           ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
           ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
           EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
           ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
           ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
           CALL POPULATE_TIME_DATE;
           ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
           ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                       WS_TIME_NOW_GRP_MM || ':' ||
                       WS_TIME_NOW_GRP_SS;
           ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
           ABNDINFO_REC.ABND_CODE = 'HROL';
           EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
           ABNDINFO_REC.ABND_SQLCODE  = '0';
           ABNDINFO_REC.ABND_FREEFORM =
               'AH010 - SYNCPOINT ROLLBACK failed' ||
                           ' RESP=' || ABNDINFO_REC.ABND_RESPCODE;
           EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                COMMAREA(ABNDINFO_REC);
           EXEC CICS ABEND ABCODE('HROL') CANCEL NODUMP;
         END;
         DFHCOMMAREA.INQACC_SUCCESS = 'N';
         EXEC CICS RETURN;
       END;
       OTHERWISE;
     END;
     IF WS_STORM_DRAIN = 'N' THEN DO;
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
       ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = MY_ABEND_CODE;
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE  = '0';
       ABNDINFO_REC.ABND_FREEFORM = 'AH010 - WS_STORM_DRAIN=N' ||
                       ' RESP=' || ABNDINFO_REC.ABND_RESPCODE;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       EXEC CICS ABEND ABCODE(MY_ABEND_CODE) CANCEL NODUMP;
     END;
   END ABEND_HANDLING;

   /********** READ_ACCOUNT_LAST *************************************/
   READ_ACCOUNT_LAST: PROC;
     CALL GET_LAST_ACCOUNT_DB2;
     NCS_ACC_NO_VALUE = DECIMAL(REQUIRED_ACC_NUMBER2,8,0);
   END READ_ACCOUNT_LAST;

   /********** GET_LAST_ACCOUNT_DB2 **********************************/
   GET_LAST_ACCOUNT_DB2: PROC;
     OUTPUT_DATA = '';
     HV_ACCOUNT_ACC_NO   = REQUIRED_ACC_NUMBER2;
     HV_ACCOUNT_SORTCODE = SORTCODE;

     EXEC SQL
       SELECT ACCOUNT_EYECATCHER,
              ACCOUNT_CUSTOMER_NUMBER,
              ACCOUNT_SORTCODE,
              ACCOUNT_NUMBER,
              ACCOUNT_TYPE,
              ACCOUNT_INTEREST_RATE,
              ACCOUNT_OPENED,
              ACCOUNT_OVERDRAFT_LIMIT,
              ACCOUNT_LAST_STATEMENT,
              ACCOUNT_NEXT_STATEMENT,
              ACCOUNT_AVAILABLE_BALANCE,
              ACCOUNT_ACTUAL_BALANCE
       INTO :HV_ACCOUNT_EYECATCHER,
            :HV_ACCOUNT_CUST_NO,
            :HV_ACCOUNT_SORTCODE,
            :HV_ACCOUNT_ACC_NO,
            :HV_ACCOUNT_ACC_TYPE,
            :HV_ACCOUNT_INT_RATE,
            :HV_ACCOUNT_OPENED,
            :HV_ACCOUNT_OVERDRAFT_LIM,
            :HV_ACCOUNT_LAST_STMT,
            :HV_ACCOUNT_NEXT_STMT,
            :HV_ACCOUNT_AVAIL_BAL,
            :HV_ACCOUNT_ACTUAL_BAL
       FROM ACCOUNT
       WHERE ACCOUNT_SORTCODE = :HV_ACCOUNT_SORTCODE
       ORDER BY ACCOUNT_NUMBER DESC
       FETCH FIRST 1 ROWS ONLY;

     IF SQLCODE ^= 0 THEN DO;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
       ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'HNCS';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE   = SQLCODE_DISPLAY;
       ABNDINFO_REC.ABND_FREEFORM  = 'GLAD010 - ACCOUNT NCS ' ||
                        NCS_ACC_NO_ACT_NAME ||
                        ' SELECT failed SQLCODE=' ||
                        SQLCODE_DISPLAY;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       EXEC CICS ABEND ABCODE('HNCS') CANCEL NODUMP;
     END;
     ELSE DO;
       OUTPUT_DATA.ACCOUNT_EYE_CATCHER      = HV_ACCOUNT_EYECATCHER;
       OUTPUT_DATA.ACCOUNT_CUST_NO          = HV_ACCOUNT_CUST_NO;
       OUTPUT_DATA.ACCOUNT_SORT_CODE        = HV_ACCOUNT_SORTCODE;
       OUTPUT_DATA.ACCOUNT_NUMBER           = HV_ACCOUNT_ACC_NO;
       OUTPUT_DATA.ACCOUNT_TYPE             = HV_ACCOUNT_ACC_TYPE;
       OUTPUT_DATA.ACCOUNT_INTEREST_RATE    = HV_ACCOUNT_INT_RATE;
       DB2_DATE_REFORMAT = HV_ACCOUNT_OPENED;
       OUTPUT_DATA.ACCOUNT_OPENED_DAY   = DB2_DATE_REF_DAY;
       OUTPUT_DATA.ACCOUNT_OPENED_MONTH = DB2_DATE_REF_MNTH;
       OUTPUT_DATA.ACCOUNT_OPENED_YEAR  = DB2_DATE_REF_YR;
       OUTPUT_DATA.ACCOUNT_OVERDRAFT_LIMIT =
           CHAR(HV_ACCOUNT_OVERDRAFT_LIM,8);
       DB2_DATE_REFORMAT = HV_ACCOUNT_LAST_STMT;
       OUTPUT_DATA.ACCOUNT_LAST_STMT_DAY   = DB2_DATE_REF_DAY;
       OUTPUT_DATA.ACCOUNT_LAST_STMT_MONTH = DB2_DATE_REF_MNTH;
       OUTPUT_DATA.ACCOUNT_LAST_STMT_YEAR  = DB2_DATE_REF_YR;
       DB2_DATE_REFORMAT = HV_ACCOUNT_NEXT_STMT;
       OUTPUT_DATA.ACCOUNT_NEXT_STMT_DAY   = DB2_DATE_REF_DAY;
       OUTPUT_DATA.ACCOUNT_NEXT_STMT_MONTH = DB2_DATE_REF_MNTH;
       OUTPUT_DATA.ACCOUNT_NEXT_STMT_YEAR  = DB2_DATE_REF_YR;
       OUTPUT_DATA.ACCOUNT_AVAILABLE_BALANCE = HV_ACCOUNT_AVAIL_BAL;
       OUTPUT_DATA.ACCOUNT_ACTUAL_BALANCE    = HV_ACCOUNT_ACTUAL_BAL;
       REQUIRED_ACC_NUMBER2      = OUTPUT_DATA.ACCOUNT_NUMBER;
     END;
   END GET_LAST_ACCOUNT_DB2;

   /********** POPULATE_TIME_DATE ************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
          ABSTIME(WS_U_TIME)
          DDMMYYYY(WS_ORIG_DATE)
          TIME(WS_TIME_NOW)
          DATESEP;
   END POPULATE_TIME_DATE;

 END INQACC;
