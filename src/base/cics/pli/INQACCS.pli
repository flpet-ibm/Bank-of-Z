 *PROCESS CICS,SQL;
 /* ----------------------------------------------------------------- */
 /*  Copyright IBM Corp. 2023                                         */
 /* ----------------------------------------------------------------- */
 /*  INQACCS - Enquire Accounts by Sort Code                          */
 /*                                                                   */
 /*  Retrieves all accounts for the local sort-code from DB2 via a    */
 /*  cursor, up to a maximum of 20, returning them in the COMMAREA.  */
 /*  If any error occurs the program abends or sets fail flags.       */
 /* ----------------------------------------------------------------- */
 INQACCS: PROCEDURE OPTIONS(MAIN REENTRANT);

   /* ----------------------------------------------------------------*/
   /*  SQLCA - must be first EXEC SQL statement                       */
   /* ----------------------------------------------------------------*/
   EXEC SQL INCLUDE SQLCA;

   /* ----------------------------------------------------------------*/
   /*  ACCOUNT table declaration                                      */
   /* ----------------------------------------------------------------*/
   EXEC SQL DECLARE ACCOUNT TABLE
     ( ACCOUNT_EYECATCHER          CHAR(4),
       ACCOUNT_CUSTOMER_NUMBER     CHAR(10),
       ACCOUNT_SORTCODE            CHAR(6)       NOT NULL,
       ACCOUNT_NUMBER              CHAR(8)       NOT NULL,
       ACCOUNT_TYPE                CHAR(8),
       ACCOUNT_INTEREST_RATE       DECIMAL(4,2),
       ACCOUNT_OPENED              DATE,
       ACCOUNT_OVERDRAFT_LIMIT     INTEGER,
       ACCOUNT_LAST_STATEMENT      DATE,
       ACCOUNT_NEXT_STATEMENT      DATE,
       ACCOUNT_AVAILABLE_BALANCE   DECIMAL(10,2),
       ACCOUNT_ACTUAL_BALANCE      DECIMAL(10,2) );

   /* ----------------------------------------------------------------*/
   /*  ACC_ALL_CURSOR - all accounts for sort-code                    */
   /* ----------------------------------------------------------------*/
   EXEC SQL DECLARE ACC_ALL_CURSOR CURSOR FOR
     SELECT ACCOUNT_EYECATCHER,
            ACCOUNT_CUSTOMER_NUMBER,
            ACCOUNT_SORTCODE,
            ACCOUNT_NUMBER,
            ACCOUNT_TYPE,
            ACCOUNT_INTEREST_RATE,
            ACCOUNT_OPENED,
            ACCOUNT_OVERDRAFT_LIMIT,
            ACCOUNT_LAST_STATEMENT,
            ACCOUNT_NEXT_STATEMENT,
            ACCOUNT_AVAILABLE_BALANCE,
            ACCOUNT_ACTUAL_BALANCE
     FROM   ACCOUNT
     WHERE  ACCOUNT_SORTCODE = :HV_ACCOUNT_SORTCODE
     FOR FETCH ONLY;

   /* ----------------------------------------------------------------*/
   /*  Sort code constant                                             */
   /* ----------------------------------------------------------------*/
   %INCLUDE SORTCODE;

   /* ----------------------------------------------------------------*/
   /*  DB2 host variables for ACCOUNT table                           */
   /* ----------------------------------------------------------------*/
   DCL HV_ACCOUNT_EYECATCHER      CHAR(4);
   DCL HV_ACCOUNT_CUST_NO         CHAR(10);
   DCL HV_ACCOUNT_SORTCODE        CHAR(6);
   DCL HV_ACCOUNT_ACC_NO          CHAR(8);
   DCL HV_ACCOUNT_ACC_TYPE        CHAR(8);
   DCL HV_ACCOUNT_INT_RATE        FIXED DEC(6,2);
   DCL HV_ACCOUNT_OPENED          CHAR(10);   /* DATE as CHAR(10)     */
   DCL HV_ACCOUNT_OVERDRAFT_LIM   FIXED BIN(31);
   DCL HV_ACCOUNT_LAST_STMT       CHAR(10);   /* DATE as CHAR(10)     */
   DCL HV_ACCOUNT_NEXT_STMT       CHAR(10);   /* DATE as CHAR(10)     */
   DCL HV_ACCOUNT_AVAIL_BAL       FIXED DEC(12,2);
   DCL HV_ACCOUNT_ACTUAL_BAL      FIXED DEC(12,2);

   /* ----------------------------------------------------------------*/
   /*  Date reformatting work area (YYYY-MM-DD from DB2)              */
   /* ----------------------------------------------------------------*/
   DCL 1 DB2_DATE_REFORMAT,
         2 DB2_DATE_REF_YR          CHAR(4),
         2 DB2_DATE_REF_SEP1        CHAR(1),
         2 DB2_DATE_REF_MNTH        CHAR(2),
         2 DB2_DATE_REF_SEP2        CHAR(1),
         2 DB2_DATE_REF_DAY         CHAR(2);

   /* ----------------------------------------------------------------*/
   /*  CICS response codes                                            */
   /* ----------------------------------------------------------------*/
   DCL WS_CICS_RESP               FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2              FIXED BIN(31) INIT(0);

   /* ----------------------------------------------------------------*/
   /*  Miscellaneous work variables                                   */
   /* ----------------------------------------------------------------*/
   DCL WS_STORM_DRAIN              CHAR(1)  INIT('N');
   DCL STORM_DRAIN_CONDITION       CHAR(20);
   DCL SQLCODE_DISPLAY             FIXED BIN(31);
   DCL MY_ABEND_CODE               CHAR(4);
   DCL WS_ABEND_PGM                CHAR(8)  INIT('ABNDPROC');
   DCL WS_CA_LEN                   FIXED BIN(15);

   /* Time / date working storage */
   DCL WS_U_TIME                   FIXED DEC(15,0) INIT(0);
   DCL WS_ORIG_DATE                CHAR(10);
   DCL WS_TIME_NOW                 CHAR(6);

   /* ----------------------------------------------------------------*/
   /*  Abend info record                                              */
   /* ----------------------------------------------------------------*/
   %INCLUDE ABNDINFO;

   /* ----------------------------------------------------------------*/
   /*  COMMAREA (INQACCS interface)                                   */
   /* ----------------------------------------------------------------*/
   DCL COMMAREA_PTR                POINTER;
   %INCLUDE INQACCS;
   DCL 1 DFHCOMMAREA BASED(COMMAREA_PTR)
                     LIKE INQACCS_COMMAREA;

   /* ================================================================*/
   /*  MAIN PROCEDURE LOGIC                                           */
   /* ================================================================*/

   /* Set up abend handler */
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING) ;

   /* Get the COMMAREA address */
   EXEC CICS ADDRESS
        COMMAREA(COMMAREA_PTR)
        RESP(WS_CICS_RESP)
        RESP2(WS_CICS_RESP2) ;

   COMM_SUCCESS   = 'N';
   COMM_FAIL_CODE = '0';

   HV_ACCOUNT_SORTCODE = SORTCODE;

   CALL READ_ACCOUNT_DB2;

   CALL GET_ME_OUT_OF_HERE;

 /* ------------------------------------------------------------------*/
 /*  READ_ACCOUNT_DB2 - Open cursor, fetch, close                     */
 /* ------------------------------------------------------------------*/
 READ_ACCOUNT_DB2: PROCEDURE;

   EXEC SQL OPEN ACC_ALL_CURSOR ;

   SQLCODE_DISPLAY = SQLCODE;

   IF SQLCODE ^= 0 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     CALL CHECK_FOR_STORM_DRAIN_DB2;
     COMM_SUCCESS       = 'N';
     COMM_FAIL_CODE     = '2';
     NUMBER_OF_ACCOUNTS = 0;

     EXEC CICS SYNCPOINT ROLLBACK
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2) ;

     RETURN;
   END;

   CALL FETCH_DATA;

   EXEC SQL CLOSE ACC_ALL_CURSOR ;

   IF SQLCODE ^= 0 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     PUT SKIP LIST('Failure when attempting to close the DB2 CURSOR' ||
                   ' ACC_ALL_CURSOR. With SQL code=' ||
                   CHAR(SQLCODE_DISPLAY));
     CALL CHECK_FOR_STORM_DRAIN_DB2;
     COMM_SUCCESS   = 'N';
     COMM_FAIL_CODE = '4';

     EXEC CICS SYNCPOINT ROLLBACK
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2) ;

     RETURN;
   END;

   COMM_SUCCESS = 'Y';

 END READ_ACCOUNT_DB2;

 /* ------------------------------------------------------------------*/
 /*  FETCH_DATA - Fetch up to 20 rows from ACC_ALL_CURSOR             */
 /* ------------------------------------------------------------------*/
 FETCH_DATA: PROCEDURE;

   NUMBER_OF_ACCOUNTS = 0;

   DO WHILE (SQLCODE = 0 & NUMBER_OF_ACCOUNTS < 20);

     EXEC SQL FETCH FROM ACC_ALL_CURSOR
       INTO :HV_ACCOUNT_EYECATCHER,
            :HV_ACCOUNT_CUST_NO,
            :HV_ACCOUNT_SORTCODE,
            :HV_ACCOUNT_ACC_NO,
            :HV_ACCOUNT_ACC_TYPE,
            :HV_ACCOUNT_INT_RATE,
            :HV_ACCOUNT_OPENED,
            :HV_ACCOUNT_OVERDRAFT_LIM,
            :HV_ACCOUNT_LAST_STMT,
            :HV_ACCOUNT_NEXT_STMT,
            :HV_ACCOUNT_AVAIL_BAL,
            :HV_ACCOUNT_ACTUAL_BAL ;

     IF SQLCODE = 100 THEN DO;     /* no more rows */
       COMM_SUCCESS = 'Y';
       RETURN;
     END;

     IF SQLCODE ^= 0 THEN DO;
       SQLCODE_DISPLAY = SQLCODE;
       PUT SKIP LIST('Failure when attempting to FETCH from the' ||
                     ' DB2 CURSOR ACC_ALL_CURSOR. With SQL code=' ||
                     CHAR(SQLCODE_DISPLAY));
       CALL CHECK_FOR_STORM_DRAIN_DB2;
       COMM_SUCCESS       = 'N';
       NUMBER_OF_ACCOUNTS = 0;
       COMM_FAIL_CODE     = '3';

       EXEC CICS SYNCPOINT ROLLBACK
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2) ;

       RETURN;
     END;

     NUMBER_OF_ACCOUNTS = NUMBER_OF_ACCOUNTS + 1;

     COMM_EYE(NUMBER_OF_ACCOUNTS)      = HV_ACCOUNT_EYECATCHER;
     COMM_CUSTNO(NUMBER_OF_ACCOUNTS)   = HV_ACCOUNT_CUST_NO;
     COMM_SCODE(NUMBER_OF_ACCOUNTS)    = HV_ACCOUNT_SORTCODE;
     COMM_ACCNO(NUMBER_OF_ACCOUNTS)    = HV_ACCOUNT_ACC_NO;
     COMM_ACC_TYPE(NUMBER_OF_ACCOUNTS) = HV_ACCOUNT_ACC_TYPE;
     COMM_INT_RATE(NUMBER_OF_ACCOUNTS) = HV_ACCOUNT_INT_RATE;

     DB2_DATE_REFORMAT = HV_ACCOUNT_OPENED;
     COMM_OPENED(NUMBER_OF_ACCOUNTS) =
    DEC(DB2_DATE_REF_DAY || DB2_DATE_REF_MNTH || DB2_DATE_REF_YR, 8, 0);

     COMM_OVERDRAFT(NUMBER_OF_ACCOUNTS) = HV_ACCOUNT_OVERDRAFT_LIM;

     DB2_DATE_REFORMAT = HV_ACCOUNT_LAST_STMT;
     COMM_LAST_STMT_DT(NUMBER_OF_ACCOUNTS) =
    DEC(DB2_DATE_REF_DAY || DB2_DATE_REF_MNTH || DB2_DATE_REF_YR, 8, 0);

     DB2_DATE_REFORMAT = HV_ACCOUNT_NEXT_STMT;
     COMM_NEXT_STMT_DT(NUMBER_OF_ACCOUNTS) =
    DEC(DB2_DATE_REF_DAY || DB2_DATE_REF_MNTH || DB2_DATE_REF_YR, 8, 0);

     COMM_ACTUAL_BAL(NUMBER_OF_ACCOUNTS) = HV_ACCOUNT_ACTUAL_BAL;
     COMM_AVAIL_BAL(NUMBER_OF_ACCOUNTS)  = HV_ACCOUNT_AVAIL_BAL;

   END; /* DO WHILE */

 END FETCH_DATA;

 /* ------------------------------------------------------------------*/
 /*  GET_ME_OUT_OF_HERE - Return control to CICS                      */
 /* ------------------------------------------------------------------*/
 GET_ME_OUT_OF_HERE: PROCEDURE;

   EXEC CICS RETURN ;

 END GET_ME_OUT_OF_HERE;

 /* ------------------------------------------------------------------*/
 /*  CHECK_FOR_STORM_DRAIN_DB2 - Classify SQLCODE for storm drain     */
 /* ------------------------------------------------------------------*/
 CHECK_FOR_STORM_DRAIN_DB2: PROCEDURE;

   SELECT (SQLCODE);
     WHEN (923)  STORM_DRAIN_CONDITION = 'DB2 Connection lost ';
     OTHERWISE   STORM_DRAIN_CONDITION = 'Not Storm Drain     ';
   END;

   IF STORM_DRAIN_CONDITION ^= 'Not Storm Drain     ' THEN
     PUT SKIP LIST('INQACCS: Check-For-Storm-Drain-DB2: Storm ' ||
                   'Drain condition (' || STORM_DRAIN_CONDITION ||
                   ') has been met (' || CHAR(SQLCODE_DISPLAY) || ').');

 END CHECK_FOR_STORM_DRAIN_DB2;

 /* ------------------------------------------------------------------*/
 /*  POPULATE_TIME_DATE - Get current date and time via CICS          */
 /* ------------------------------------------------------------------*/
 POPULATE_TIME_DATE: PROCEDURE;

   EXEC CICS ASKTIME ABSTIME(WS_U_TIME) ;

   EXEC CICS FORMATTIME
        ABSTIME(WS_U_TIME)
        DDMMYYYY(WS_ORIG_DATE)
        TIME(WS_TIME_NOW)
        DATESEP ;

 END POPULATE_TIME_DATE;

 /* ------------------------------------------------------------------*/
 /*  ABEND_HANDLING - Handle CICS abends                              */
 /* ------------------------------------------------------------------*/
 ABEND_HANDLING:
   EXEC CICS ASSIGN ABCODE(MY_ABEND_CODE) ;

   SELECT (MY_ABEND_CODE);
     WHEN ('AD2Z') DO;
       SQLCODE_DISPLAY = SQLCODE;
       PUT SKIP LIST('DB2 DEADLOCK DETECTED IN INQACCS, SQLCODE=' ||
                     CHAR(SQLCODE_DISPLAY));
     END;
     WHEN ('AFCR') ;  /* fall through */
     WHEN ('AFCS') ;  /* fall through */
     WHEN ('AFCT') DO;
       WS_STORM_DRAIN = 'Y';
       EXEC CICS SYNCPOINT ROLLBACK
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2) ;
       COMM_SUCCESS = 'N';
       EXEC CICS RETURN ;
     END;
     OTHERWISE ;
   END;

   IF WS_STORM_DRAIN = 'N' THEN
     EXEC CICS ABEND ABCODE(MY_ABEND_CODE) NODUMP CANCEL ;

 END INQACCS;
