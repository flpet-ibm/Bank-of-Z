 /*  BNK1MAI.inc - PL/I symbolic map for BNK1MAI / BNK1ME            */
 /*  Mirrors COBOL DFHBMS generated copy BNK1MAI (LANG=PLI)          */
 /* ----------------------------------------------------------------- */
 /* Input structure BNK1MEI                                           */
 DCL 1 BNK1MEI,
       2 FILLER_1       CHAR(12),
       2 COMPANYL       FIXED BIN(15),
       2 COMPANYF       CHAR(1),
       2 COMPANYA       CHAR(1),
       2 FILLER_2       CHAR(6),
       2 COMPANYI       CHAR(43),
       2 ACTIONL        FIXED BIN(15),
       2 ACTIONF        CHAR(1),
       2 ACTIONA        CHAR(1),
       2 FILLER_3       CHAR(6),
       2 ACTIONI        CHAR(1),
       2 MESSAGEL       FIXED BIN(15),
       2 MESSAGEF       CHAR(1),
       2 MESSAGEA       CHAR(1),
       2 FILLER_4       CHAR(6),
       2 MESSAGEI       CHAR(79),
       2 DUMMYL         FIXED BIN(15),
       2 DUMMYF         CHAR(1),
       2 DUMMYA         CHAR(1),
       2 FILLER_5       CHAR(6),
       2 DUMMYI         CHAR(1);

 /* Output structure BNK1MEO overlays BNK1MEI                        */
 DCL 1 BNK1MEO BASED(ADDR(BNK1MEI)),
       2 FILLER_6       CHAR(12),
       2 FILLER_7       CHAR(3),
       2 COMPANYC       CHAR(1),
       2 COMPANYP       CHAR(1),
       2 COMPANYH       CHAR(1),
       2 COMPANYV       CHAR(1),
       2 COMPANYU       CHAR(1),
       2 COMPANYM       CHAR(1),
       2 COMPANYO       CHAR(43),
       2 FILLER_8       CHAR(3),
       2 ACTIONC        CHAR(1),
       2 ACTIONP        CHAR(1),
       2 ACTIONH        CHAR(1),
       2 ACTIONV        CHAR(1),
       2 ACTIONU        CHAR(1),
       2 ACTIONM        CHAR(1),
       2 ACTIONO        CHAR(1),
       2 FILLER_9       CHAR(3),
       2 MESSAGEC       CHAR(1),
       2 MESSAGEP       CHAR(1),
       2 MESSAGEH       CHAR(1),
       2 MESSAGEV       CHAR(1),
       2 MESSAGEU       CHAR(1),
       2 MESSAGEM       CHAR(1),
       2 MESSAGEO       CHAR(79),
       2 FILLER_10      CHAR(3),
       2 DUMMYC         CHAR(1),
       2 DUMMYP         CHAR(1),
       2 DUMMYH         CHAR(1),
       2 DUMMYV         CHAR(1),
       2 DUMMYU         CHAR(1),
       2 DUMMYM         CHAR(1),
       2 DUMMYO         CHAR(1);
