   /*****************************************************************/
   /* DELETE_DB2_ROWS - Clear CUSTOMER, ACCOUNT, CONTROL tables    */
   /*****************************************************************/
   DELETE_DB2_ROWS: PROC;

     TIMESTAMP_FUNCTION = 'Deleting from CUSTOMER table';
     CALL DO_TIMESTAMP;
     EXEC SQL DELETE FROM CUSTOMER;
     TIMESTAMP_FUNCTION = 'Deleting from CUSTOMER table COMPLETE';
     CALL DO_TIMESTAMP;
     IF SQLCODE ^= 100 & SQLCODE ^= 0 THEN DO;
       CALL SET_REASON_CODE;
       WS_SQLCODE_DISPLAY = CHAR(SQLCODE);
       PUT SKIP LIST('Error deleting rows from CUSTOMER table.' ||
                     ' SQLCODE=' || WS_SQLCODE_DISPLAY ||
                     ' REASON=' || DISP_REASON_CODE);
       STOP_CODE = 12;
       CALL PROGRAM_DONE;
     END;

     TIMESTAMP_FUNCTION = 'Deleting from ACCOUNT table';
     CALL DO_TIMESTAMP;
     EXEC SQL DELETE FROM ACCOUNT;
     TIMESTAMP_FUNCTION = 'Deleting from ACCOUNT table COMPLETE';
     CALL DO_TIMESTAMP;
     IF SQLCODE ^= 100 & SQLCODE ^= 0 THEN DO;
       CALL SET_REASON_CODE;
       WS_SQLCODE_DISPLAY = CHAR(SQLCODE);
       PUT SKIP LIST('Error deleting rows from ACCOUNT table.' ||
                     ' SQLCODE=' || WS_SQLCODE_DISPLAY ||
                     ' REASON=' || DISP_REASON_CODE);
       STOP_CODE = 12;
       CALL PROGRAM_DONE;
     END;

     TIMESTAMP_FUNCTION = 'Deleting from CONTROL table';
     CALL DO_TIMESTAMP;
     EXEC SQL DELETE FROM CONTROL;
     TIMESTAMP_FUNCTION = 'Deleting from CONTROL table COMPLETE';
     CALL DO_TIMESTAMP;
     IF SQLCODE ^= 100 & SQLCODE ^= 0 THEN DO;
       CALL SET_REASON_CODE;
       WS_SQLCODE_DISPLAY = CHAR(SQLCODE);
       PUT SKIP LIST('Error deleting rows from CONTROL table.' ||
                     ' SQLCODE=' || WS_SQLCODE_DISPLAY ||
                     ' REASON=' || DISP_REASON_CODE);
       STOP_CODE = 12;
       CALL PROGRAM_DONE;
     END;

     CALL INSERT_INITIAL_CONTROL_RECORDS;
     EXEC SQL COMMIT WORK;

   END DELETE_DB2_ROWS;

   /*****************************************************************/
   /* INSERT_INITIAL_CONTROL_RECORDS - Seed CONTROL table          */
   /*****************************************************************/
   INSERT_INITIAL_CONTROL_RECORDS: PROC;

     /* Default sortcode record */
     HV_CONTROL_NAME = ' ';
     HV_CONTROL_NAME = 'BANKZCUST' || SORTCODE || '  ';
     HV_CONTROL_VALUE_NUM = 1;
     HV_CONTROL_VALUE_STR = ' ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     HV_CONTROL_NAME = 'BANKZCUST0005OCCS  ';
     HV_CONTROL_VALUE_NUM = 0;
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     HV_CONTROL_NAME = 'BANKZCUST0006OCCS  ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     HV_CONTROL_NAME = 'BANKZCUST0007OCCS  ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     HV_CONTROL_NAME = 'BANKZCUST0008OCCS  ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     HV_CONTROL_NAME = 'BANKZCUST0009OCCS  ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     /* ACCOUNT-LAST and ACCOUNT-COUNT for default sortcode */
     HV_CONTROL_NAME = ' ';
     HV_CONTROL_NAME = SORTCODE || '-' || 'ACCOUNT-LAST';
     HV_CONTROL_VALUE_NUM = 1;
     HV_CONTROL_VALUE_STR = ' ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

     HV_CONTROL_NAME = ' ';
     HV_CONTROL_NAME = SORTCODE || '-' || 'ACCOUNT-COUNT';
     HV_CONTROL_VALUE_NUM = 1;
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);

   END INSERT_INITIAL_CONTROL_RECORDS;

   /*****************************************************************/
   /* GET_TODAYS_DATE - Store today as integer and YYYYMMDD string  */
   /*****************************************************************/
   GET_TODAYS_DATE: PROC;
     DCL CURR_DT CHAR(8);
     CURR_DT = SUBSTR(DATETIME(), 1, 8);
     WS_CURRENT_DATE_9 = CURR_DT;
     WS_TODAY_INT = DAYS(CURR_DT, 'YYYYMMDD');
   END GET_TODAYS_DATE;

   /*****************************************************************/
   /* PARSE_PARM - Parse comma-separated parm string               */
   /*****************************************************************/
   PARSE_PARM: PROC;
     DCL PARM_STR CHAR(256);
     DCL POS      FIXED BIN(31);
     DCL FN       FIXED BIN(31);
     DCL CH       CHAR(1);
     DCL FV       CHAR(10);

     /* In batch PL/I, SYSIN or PARM is accessed via FETCH */
     /* For z/OS batch we read PARM from SYSIN substitution */
     /* Simple approach: set defaults if no parm available */
     START_KEY       = 1;
     END_KEY         = 100;
     STEP_KEY        = 1;
     RANDOM_SEED_NUM = 12345;
   END PARSE_PARM;

   /*****************************************************************/
   /* SET_REASON_CODE - Map SQLERRD(3) to reason text              */
   /*****************************************************************/
   SET_REASON_CODE: PROC;
     SELECT;
       WHEN (SQLERRD(3) = 13172878)
         DISP_REASON_CODE = 'TIMEOUT  (00C900E)';
       WHEN (SQLERRD(3) = 13172872)
         DISP_REASON_CODE = 'DEADLOCK (00C9088)';
       OTHERWISE
         DISP_REASON_CODE = 'Unknown ReasonCode';
     END;
   END SET_REASON_CODE;

   /*****************************************************************/
   /* DO_TIMESTAMP - Log timestamp using CEEGMT + CEEDATM          */
   /*****************************************************************/
   DO_TIMESTAMP: PROC;
     CALL CEEGMT (GMT_LILIAN, GMT_SECONDS, FC);
     PERIOD_NEXT = GMT_SECONDS;
     CALL CEEDATM(PERIOD_NEXT, DATM_PICTURE, DATM_CONV, FC);
     PERIOD_NEXT_F = SUBSTR(DATM_CONV, 1, 14);
     PUT SKIP LIST(TIMESTAMP_FUNCTION || ' AT ' || PERIOD_NEXT_F);
   END DO_TIMESTAMP;

 END BANKDATA;
