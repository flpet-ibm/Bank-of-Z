*PROCESS SYSTEM(CICS) MARGINS(1,72);
 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* BNK1CCS - BMS Screen handler for Create Customer              */
 /* Receives customer data, links to CRECUST to create customer.  */
 /* Transaction: OCCS                                              */
 /***************************************************************** */
 BNK1CCS: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA                                                   */
   /*****************************************************************/
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR),
     3 DFHCOMMAREA_DATA CHAR(5);

   /*****************************************************************/
   /* BMS map                                                       */
   /*****************************************************************/
   DCL 1 BNK1CCI_MAP,
   %INCLUDE BNK1CCM;

   /*****************************************************************/
   /* AID key definitions                                           */
   /*****************************************************************/
   %INCLUDE DFHAID;

   /*****************************************************************/
   /* CRECUST commarea                                              */
   /*****************************************************************/
   DCL 1 SUBPGM_PARMS,
   %INCLUDE CRECUST;

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_UCTRANS         FIXED BIN(31) INIT(0);
   DCL STORED_UCTRANS     FIXED BIN(31) INIT(0);

   DCL WS_CICS_RESP       FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2      FIXED BIN(31) INIT(0);

   DCL 1 WS_FAIL_INFO,
     3 WS_FAIL_PROG        CHAR(9)  INIT('BNK1CCS  '),
     3 WS_CICS_FAIL_MSG    CHAR(70) INIT(' '),
     3 WS_FAIL_RESP_LBL    CHAR(6)  INIT(' RESP='),
     3 WS_CICS_RESP_DISP   CHAR(10) INIT(' '),
     3 WS_FAIL_RESP2_LBL   CHAR(7)  INIT(' RESP2='),
     3 WS_CICS_RESP2_DISP  CHAR(10) INIT(' '),
     3 WS_FAIL_ABEND_MSG   CHAR(15)
                           INIT(' ABENDING TASK.');

   DCL SEND_FLAG     CHAR(1) INIT('E');
   DCL VALID_DATA_SW CHAR(1) INIT('Y');

   DCL END_OF_SESSION_MESSAGE CHAR(13) INIT('Session Ended');
   DCL WS_ABCODE              CHAR(4)  INIT(' ');

   DCL 1 WS_COMM_AREA,
     3 WS_COMM_DATA  CHAR(1)  INIT(' '),
     3 WS_COMM_TERM  FIXED BIN(31) INIT(0);

   DCL COMPANY_NAME_FULL CHAR(32) INIT(' ');
   DCL CURSOR_POSITION   FIXED BIN(15) INIT(0);

   /*****************************************************************/
   /* Date/Time                                                     */
   /*****************************************************************/
   DCL WS_U_TIME     FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE  CHAR(10) INIT(' ');
   DCL 1 WS_ORIG_DATE_GRP DEFINED(WS_ORIG_DATE),
     3 WS_ORIG_DATE_DD   CHAR(2),
     3 WS_ORIG_DATE_SEP1 CHAR(1),
     3 WS_ORIG_DATE_MM   CHAR(2),
     3 WS_ORIG_DATE_SEP2 CHAR(1),
     3 WS_ORIG_DATE_YYYY CHAR(4);

   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW CHAR(6) INIT(' '),
     3 * DEFINED(WS_TIME_NOW),
       5 WS_TIME_NOW_HH CHAR(2),
       5 WS_TIME_NOW_MM CHAR(2),
       5 WS_TIME_NOW_SS CHAR(2);

   DCL WS_ABEND_PGM CHAR(8) INIT('ABNDPROC');

   DCL 1 ABNDINFO_REC,
   %INCLUDE ABNDINFO;

   /*****************************************************************/
   /* MAIN PROCEDURE                                                */
   /*****************************************************************/
   /* Set up CICS abend handler */
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING);

   SELECT;
     WHEN (EIBCALEN = 0) DO;
       BNK1CCI_MAP = LOW(LENGTH(BNK1CCI_MAP));
       CUSTTITI = ' ';
       CHRISTNI = ' ';
       CUSTINSI = ' ';
       CUSTSNI  = ' ';
       CUSTAD1I = ' ';
       CUSTAD2I = ' ';
       CUSTTITL = -1;
       SEND_FLAG = 'E';
       MESSAGEI = ' ';
       CALL STORE_TERM_DEF;
       CALL SEND_MAP;
       WS_COMM_AREA = '';
       WS_COMM_TERM = STORED_UCTRANS;
     END;
     WHEN (EIBAID = DFHPA1 | EIBAID = DFHPA2 |
           EIBAID = DFHPA3) DO;
       /* PA key - ignore */
     END;
     WHEN (EIBAID = DFHPF3) DO;
       CALL RESTORE_TERM_DEF;
       EXEC CICS RETURN TRANSID('OMEN')
            IMMEDIATE
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2);
     END;
     WHEN (EIBAID = DFHPF12) DO;
       CALL SEND_TERMINATION_MSG;
       CALL RESTORE_TERM_DEF;
       EXEC CICS RETURN;
     END;
     WHEN (EIBAID = DFHCLEAR) DO;
       EXEC CICS SEND MAP('BNK1CCM') MAPONLY ERASE FREEKB;
       CALL RESTORE_TERM_DEF;
       EXEC CICS RETURN TRANSID('OCCS')
            COMMAREA(WS_COMM_AREA);
     END;
     WHEN (EIBAID = DFHENTER) DO;
       CALL PROCESS_MAP;
     END;
     OTHERWISE DO;
       WS_COMM_AREA = DFHCOMMAREA;
       BNK1CCI_MAP = LOW(LENGTH(BNK1CCI_MAP));
       MESSAGEI = ' ';
       MESSAGEI = 'Invalid key pressed.';
       SEND_FLAG = 'A';
       CALL SEND_MAP;
     END;
   END;

   EXEC CICS RETURN
        TRANSID('OCCS')
        COMMAREA(WS_COMM_AREA)
        LENGTH(5)
        RESP(WS_CICS_RESP)
        RESP2(WS_CICS_RESP2);

   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
     WS_FAIL_INFO = '';
     WS_CICS_FAIL_MSG =
       'BNK1CCS - A010 - RETURN TRANSID(OCCS) FAIL';
     WS_CICS_RESP_DISP  = CHAR(WS_CICS_RESP);
     WS_CICS_RESP2_DISP = CHAR(WS_CICS_RESP2);
     CALL RESTORE_TERM_DEF;
     CALL SETUP_ABND_INFO(
       'A010 - RETURN TRANSID(OCCS) FAIL');
     CALL ABEND_THIS_TASK;
   END;

   /*****************************************************************/
   /* PROCESS_MAP                                                   */
   /*****************************************************************/
   PROCESS_MAP: PROC;
     CALL RECEIVE_MAP;
     CALL EDIT_DATA;
     IF VALID_DATA_SW = 'Y' THEN
       CALL CRE_CUST_DATA;
     SEND_FLAG = 'A';
     CALL SEND_MAP;
   END PROCESS_MAP;

   /*****************************************************************/
   /* RECEIVE_MAP                                                   */
   /*****************************************************************/
   RECEIVE_MAP: PROC;
     EXEC CICS RECEIVE MAP('BNK1CC')
               MAPSET('BNK1CCM')
               INTO(BNK1CCI_MAP)
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2);
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG =
         'BNK1CCS - RM010 - RECEIVE MAP FAIL ';
       WS_CICS_RESP_DISP  = CHAR(WS_CICS_RESP);
       WS_CICS_RESP2_DISP = CHAR(WS_CICS_RESP2);
       CALL SETUP_ABND_INFO('RM010 - RECEIVE MAP FAIL');
       CALL ABEND_THIS_TASK;
     END;
   END RECEIVE_MAP;

   /*****************************************************************/
   /* EDIT_DATA - validate screen input                            */
   /*****************************************************************/
   EDIT_DATA: PROC;
     /* If custno2 is populated, screen already has a customer */
     IF CUSTNO2L > 0 THEN DO;
       MESSAGEI =
         'Please clear screen before creating new user';
       CUSTTITL = -1;
       VALID_DATA_SW = 'N';
       RETURN;
     END;

     IF CUSTTITL < 1 | CUSTTITI = ' ' |
        CUSTTITI = LOW('10') THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Valid titles are: Mr,Mrs,Miss,Ms,Dr,Professor,' ||
         'Drs,Lord,Sir,Lady';
       CUSTTITL = -1;
       VALID_DATA_SW = 'N';
       RETURN;
     END;

     MESSAGEI = ' ';

     IF CUSTTITL > 0 THEN DO;
       /* Normalise title - replace underscores, normalise case */
       CUSTTITI = TRANSLATE(CUSTTITI,'        ',
                            '________');
       SELECT;
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'mr')
           CUSTTITI = 'Mr        ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'mrs')
           CUSTTITI = 'Mrs       ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'miss')
           CUSTTITI = 'Miss      ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'ms')
           CUSTTITI = 'Ms        ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'dr')
           CUSTTITI = 'Dr        ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'drs')
           CUSTTITI = 'Drs       ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'professor')
           CUSTTITI = 'Professor ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'lord')
           CUSTTITI = 'Lord      ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'sir')
           CUSTTITI = 'Sir       ';
         WHEN (TRANSLATE(TRIM(CUSTTITI),
               'abcdefghijklmnopqrstuvwxyz',
               'ABCDEFGHIJKLMNOPQRSTUVWXYZ') = 'lady')
           CUSTTITI = 'Lady      ';
         OTHERWISE DO;
           MESSAGEI = ' ';
           MESSAGEI =
             'Valid titles are: Mr,Mrs,Miss,Ms,Dr,Drs,' ||
             'Professor,Lord,Sir,Lady';
           VALID_DATA_SW = 'N';
           CUSTTITL = -1;
           RETURN;
         END;
       END;
     END;

     IF CHRISTNL < 1 | CHRISTNI = ' ' |
        CHRISTNI = LOW('20') THEN DO;
       MESSAGEI = ' ';
       MESSAGEI = 'Please supply a valid First Name  ';
       CHRISTNL = -1;
       VALID_DATA_SW = 'N';
       RETURN;
     END;

     IF CUSTSNL < 1 | CUSTSNI = ' ' |
        CUSTSNI = LOW('20') THEN DO;
       MESSAGEI = ' ';
       MESSAGEI = 'Please supply a valid Surname ';
       CUSTSNL = -1;
       VALID_DATA_SW = 'N';
       RETURN;
     END;

     IF SUBSTR(CUSTAD1I,1,1) = '_' | CUSTAD1L < 1 |
        CUSTAD1I = ' ' THEN DO;
       MESSAGEI = ' ';
       MESSAGEI = 'Please supply a valid Address Line 1 ';
       VALID_DATA_SW = 'N';
       CUSTAD1L = -1;
       RETURN;
     END;

     IF DOBDDL < 1 | DOBDDI = '__' THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Please supply a valid Date of Birth DD';
       VALID_DATA_SW = 'N';
       DOBDDL = -1;
       RETURN;
     END;

     IF DOBMML < 1 | DOBMMI = '__' THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Please supply a valid Date of Birth MM';
       VALID_DATA_SW = 'N';
       DOBMML = -1;
       RETURN;
     END;

     IF DOBYYL < 4 | DOBYYI = '____' THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Please supply a valid Date of Birth YYYY';
       VALID_DATA_SW = 'N';
       DOBYYL = -1;
       RETURN;
     END;

     IF ^VERIFY(DOBDDI,'0123456789') = 0 THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Non numeric Date of Birth DD entered      ';
       VALID_DATA_SW = 'N';
       DOBDDL = -1;
       RETURN;
     END;

     IF ^VERIFY(DOBMMI,'0123456789') = 0 THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Non numeric Date of Birth MM entered      ';
       VALID_DATA_SW = 'N';
       DOBMML = -1;
       RETURN;
     END;

     IF ^VERIFY(DOBYYI,'0123456789') = 0 THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Non numeric Date of Birth YYYY entered  ';
       VALID_DATA_SW = 'N';
       DOBYYL = -1;
       RETURN;
     END;

     IF FIXED(DOBDDI) < 1 | FIXED(DOBDDI) > 31 THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Please supply a valid Date of Birth (DD)    ';
       VALID_DATA_SW = 'N';
       DOBDDL = -1;
       RETURN;
     END;

     IF FIXED(DOBMMI) < 1 | FIXED(DOBMMI) > 12 THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Please supply a valid Date of Birth (MM)    ';
       VALID_DATA_SW = 'N';
       DOBMML = -1;
       RETURN;
     END;

     IF CUSTTITL < 1 | CHRISTNL < 1 | CUSTSNL < 1 |
        CUSTAD1L < 1 | DOBDDL < 1 | DOBMML < 1 |
        DOBYYL < 1 THEN DO;
       MESSAGEI = ' ';
       MESSAGEI = 'Missing expected data.               ';
       VALID_DATA_SW = 'N';
       RETURN;
     END;
   END EDIT_DATA;

   /*****************************************************************/
   /* CRE_CUST_DATA - link to CRECUST                             */
   /*****************************************************************/
   CRE_CUST_DATA: PROC;
     SUBPGM_PARMS    = '';
     COMM_EYECATCHER = 'CUST';
     COMM_SUCCESS    = 'N';

     /* Replace underscores with spaces */
     CUSTTITI = TRANSLATE(CUSTTITI,'        ','________');
     CHRISTNI = TRANSLATE(CHRISTNI,
       '                    ','____________________');
     CUSTINSI = TRANSLATE(CUSTINSI,'  ','__');
     CUSTSNI  = TRANSLATE(CUSTSNI,
       '                    ','____________________');

     COMM_TITLE      = CUSTTITI;
     COMM_FIRST_NAME = CHRISTNI;
     COMM_LAST_NAME  = TRIM(CUSTINSI) || ' ' || CUSTSNI;

     CUSTAD1I = TRANSLATE(CUSTAD1I,
       '                                                  ',
       '__________________________________________________');
     CUSTAD2I = TRANSLATE(CUSTAD2I,
       '                                                  ',
       '__________________________________________________');
     CITYI    = TRANSLATE(CITYI,
       '                                                  ',
       '__________________________________________________');
     POSTCODEI = TRANSLATE(POSTCODEI,'          ','__________');
     COUNTRYI  = TRANSLATE(COUNTRYI,
       '                                                  ',
       '__________________________________________________');

     COMM_ADDR_LINE1 = CUSTAD1I;
     COMM_ADDR_LINE2 = CUSTAD2I;
     COMM_CITY       = CITYI;
     COMM_POSTCODE   = POSTCODEI;
     COMM_COUNTRY    = COUNTRYI;
     COMM_PHONE      = ' ';
     COMM_STATUS     = ' ';

     COMM_DOB_DAY    = DOBDDI;
     COMM_DOB_MONTH  = DOBMMI;
     COMM_DOB_YEAR   = DOBYYI;

     EXEC CICS LINK PROGRAM('CRECUST')
               COMMAREA(SUBPGM_PARMS)
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2)
               SYNCONRETURN;

     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG =
         'BNK1CCS - CCD010 - LINK CRECUST FAIL     ';
       WS_CICS_RESP_DISP  = CHAR(WS_CICS_RESP);
       WS_CICS_RESP2_DISP = CHAR(WS_CICS_RESP2);
       CALL RESTORE_TERM_DEF;
       CALL SETUP_ABND_INFO('CCD010 - LINK CRECUST FAIL');
       CALL ABEND_THIS_TASK;
     END;

     IF COMM_SUCCESS = 'N' THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'Sorry but unable to create Customer record ';
       IF COMM_FAIL_CODE = 'O' THEN
         MESSAGEI =
           'Sorry, customer is too old. Please check D.O.B.';
       IF COMM_FAIL_CODE = 'Y' THEN
         MESSAGEI =
           'Sorry, customer D.O.B. is in the future.';
       IF COMM_FAIL_CODE = 'Z' THEN
         MESSAGEI =
           'Sorry, customer D.O.B. is invalid.';
       VALID_DATA_SW = 'N';
     END;

     IF COMM_SUCCESS = 'Y' THEN DO;
       MESSAGEI = ' ';
       MESSAGEI =
         'The Customer record has been successfully created';
       SORTCI   = COMM_SORTCODE;
       CUSTNO2I = COMM_NUMBER;
     END;

     DOBYYI   = COMM_DOB_YEAR;
     DOBMMI   = COMM_DOB_MONTH;
     DOBDDI   = COMM_DOB_DAY;
     CUSTAD1I = COMM_ADDR_LINE1;
     CUSTAD2I = COMM_ADDR_LINE2;
     CITYI    = COMM_CITY;
     POSTCODEI = COMM_POSTCODE;
     COUNTRYI = COMM_COUNTRY;
     CREDSCI  = COMM_CREDIT_SCORE;
     SCRDTDDI = COMM_CS_REVIEW_DAY;
     SCRDTMMI = COMM_CS_REVIEW_MONTH;
     SCRDTYYI = COMM_CS_REVIEW_YEAR;
   END CRE_CUST_DATA;

   /*****************************************************************/
   /* STORE_TERM_DEF - save terminal UCTRAN setting               */
   /*****************************************************************/
   STORE_TERM_DEF: PROC;
     EXEC CICS INQUIRE TERMINAL(EIBTRMID)
               UCTRANST(STORED_UCTRANS)
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2);
     /* Set UCTRANS off for mixed-case input */
     EXEC CICS SET TERMINAL(EIBTRMID)
               UCTRANST(DFHVALUE(NOUCTRAN))
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2);
   END STORE_TERM_DEF;

   /*****************************************************************/
   /* RESTORE_TERM_DEF - restore terminal UCTRAN setting          */
   /*****************************************************************/
   RESTORE_TERM_DEF: PROC;
     EXEC CICS SET TERMINAL(EIBTRMID)
               UCTRANST(STORED_UCTRANS)
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2);
   END RESTORE_TERM_DEF;

   /*****************************************************************/
   /* SEND_MAP                                                      */
   /*****************************************************************/
   SEND_MAP: PROC;
     IF SEND_FLAG = 'E' THEN DO;
       EXEC CICS SEND MAP('BNK1CC')
                 MAPSET('BNK1CCM')
                 FROM(BNK1CCI_MAP)
                 ERASE CURSOR FREEKB
                 RESP(WS_CICS_RESP)
                 RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         WS_CICS_FAIL_MSG =
           'BNK1CCS - SM010 - SEND MAP ERASE FAIL';
         CALL SETUP_ABND_INFO('SM010 - SEND MAP ERASE FAIL');
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;
     IF SEND_FLAG = 'D' THEN DO;
       EXEC CICS SEND MAP('BNK1CC')
                 MAPSET('BNK1CCM')
                 FROM(BNK1CCI_MAP)
                 DATAONLY CURSOR FREEKB
                 RESP(WS_CICS_RESP)
                 RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         WS_CICS_FAIL_MSG =
           'BNK1CCS - SM010 - SEND MAP DATAONLY FAIL';
         CALL SETUP_ABND_INFO(
           'SM010 - SEND MAP DATAONLY FAIL');
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;
     IF SEND_FLAG = 'A' THEN DO;
       EXEC CICS SEND MAP('BNK1CC')
                 MAPSET('BNK1CCM')
                 FROM(BNK1CCI_MAP)
                 DATAONLY ALARM CURSOR FREEKB
                 RESP(WS_CICS_RESP)
                 RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         WS_CICS_FAIL_MSG =
           'BNK1CCS - SM010 - SEND MAP ALARM FAIL';
         CALL SETUP_ABND_INFO(
           'SM010 - SEND MAP ALARM FAIL');
         CALL ABEND_THIS_TASK;
       END;
     END;
   END SEND_MAP;

   /*****************************************************************/
   /* SEND_TERMINATION_MSG                                          */
   /*****************************************************************/
   SEND_TERMINATION_MSG: PROC;
     EXEC CICS SEND TEXT
               FROM(END_OF_SESSION_MESSAGE)
               ERASE FREEKB
               RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_CICS_FAIL_MSG =
         'BNK1CCS - STM010 - SEND TEXT FAIL';
       CALL SETUP_ABND_INFO('STM010 - SEND TEXT FAIL');
       CALL ABEND_THIS_TASK;
     END;
   END SEND_TERMINATION_MSG;

   /*****************************************************************/
   /* ABEND_THIS_TASK                                               */
   /*****************************************************************/
   ABEND_THIS_TASK: PROC;
     PUT SKIP LIST(WS_FAIL_INFO);
     EXEC CICS ABEND ABCODE('HBNK') NODUMP;
   END ABEND_THIS_TASK;

   /*****************************************************************/
   /* SETUP_ABND_INFO                                               */
   /*****************************************************************/
   SETUP_ABND_INFO: PROC (P_MSG);
     DCL P_MSG CHAR(*);
     ABNDINFO_REC = '';
     ABND_RESPCODE  = EIBRESP;
     ABND_RESP2CODE = EIBRESP2;
     EXEC CICS ASSIGN APPLID(ABND_APPLID);
     ABND_TASKNO_KEY = EIBTASKN;
     ABND_TRANID     = EIBTRNID;
     CALL POPULATE_TIME_DATE;
     ABND_DATE = WS_ORIG_DATE;
     ABND_TIME = WS_TIME_NOW_HH || ':' ||
                 WS_TIME_NOW_MM || ':' || WS_TIME_NOW_SS;
     ABND_UTIME_KEY = WS_U_TIME;
     ABND_CODE = 'HBNK';
     EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM);
     ABND_SQLCODE = '0';
     ABND_FREEFORM = SUBSTR(P_MSG || ' EIBRESP=' ||
       CHAR(EIBRESP) || ' RESP2=' || CHAR(EIBRESP2),1,80);
     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);
   END SETUP_ABND_INFO;

   /*****************************************************************/
   /* POPULATE_TIME_DATE                                            */
   /*****************************************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
               ABSTIME(WS_U_TIME)
               DDMMYYYY(WS_ORIG_DATE)
               TIME(WS_TIME_NOW)
               DATESEP;
   END POPULATE_TIME_DATE;

   /*****************************************************************/
   /* ABEND_HANDLING - CICS abend handler                          */
   /*****************************************************************/
   ABEND_HANDLING: PROC;
     CALL RESTORE_TERM_DEF;
     EXEC CICS ABEND ABCODE('HBNK') NODUMP;
   END ABEND_HANDLING;

 END BNK1CCS;
