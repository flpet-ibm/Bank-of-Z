 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* INQACCCU - Inquire Accounts for Customer                       */
 /* Links to INQCUST to verify customer, then fetches up to 20    */
 /* accounts from DB2 ACCOUNT table via cursor.                   */
 /***************************************************************** */
*PROCESS SYSTEM(CICS) SQL MARGINS(1,72);
 INQACCCU: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA (from INQACCCU.cpy)                               */
   /*****************************************************************/
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR),
   %INCLUDE INQACCCU;

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* ACCOUNT DB2 table declaration                                 */
   /*****************************************************************/
   EXEC SQL INCLUDE ACCDB2;

   /*****************************************************************/
   /* ACCOUNT cursor (by customer number and sortcode)              */
   /*****************************************************************/
   EXEC SQL DECLARE ACC_CURSOR CURSOR FOR
     SELECT ACCOUNT_EYECATCHER,
            ACCOUNT_CUSTOMER_NUMBER,
            ACCOUNT_SORTCODE,
            ACCOUNT_NUMBER,
            ACCOUNT_TYPE,
            ACCOUNT_INTEREST_RATE,
            ACCOUNT_OPENED,
            ACCOUNT_OVERDRAFT_LIMIT,
            ACCOUNT_LAST_STATEMENT,
            ACCOUNT_NEXT_STATEMENT,
            ACCOUNT_AVAILABLE_BALANCE,
            ACCOUNT_ACTUAL_BALANCE
     FROM ACCOUNT
     WHERE ACCOUNT_CUSTOMER_NUMBER = :HV_ACCOUNT_CUST_NO
       AND ACCOUNT_SORTCODE        = :HV_ACCOUNT_SORTCODE
     FOR FETCH ONLY;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* ACCOUNT host variables                                        */
   /*****************************************************************/
   DCL 1 HOST_ACCOUNT_ROW,
     3 HV_ACCOUNT_EYECATCHER    CHAR(4),
     3 HV_ACCOUNT_CUST_NO       CHAR(10),
     3 HV_ACCOUNT_SORTCODE      CHAR(6),
     3 HV_ACCOUNT_ACC_NO        CHAR(8),
     3 HV_ACCOUNT_ACC_TYPE      CHAR(8),
     3 HV_ACCOUNT_INT_RATE      FIXED DEC(6,2),
     3 HV_ACCOUNT_OPENED        CHAR(10),
     3 HV_ACCOUNT_OVERDRAFT_LIM FIXED BIN(31),
     3 HV_ACCOUNT_LAST_STMT     CHAR(10),
     3 HV_ACCOUNT_NEXT_STMT     CHAR(10),
     3 HV_ACCOUNT_AVAIL_BAL     FIXED DEC(12,2),
     3 HV_ACCOUNT_ACTUAL_BAL    FIXED DEC(12,2);

   /*****************************************************************/
   /* ABNDINFO record                                               */
   /*****************************************************************/
   DCL 1 ABNDINFO_REC,
   %INCLUDE ABNDINFO;

   /*****************************************************************/
   /* INQCUST COMMAREA (inline - uses INQCUSTZ structure)           */
   /*****************************************************************/
   DCL 1 INQCUST_COMMAREA,
     3 INQCUST_EYE          CHAR(4)   INIT(' '),
     3 INQCUST_SCODE        CHAR(6)   INIT(' '),
     3 INQCUST_CUSTNO       CHAR(10)  INIT(' '),
     3 INQCUST_NAME,
       5 INQCUST_TITLE      CHAR(10)  INIT(' '),
       5 INQCUST_FIRST_NAME CHAR(50)  INIT(' '),
       5 INQCUST_LAST_NAME  CHAR(50)  INIT(' '),
     3 INQCUST_DOB,
       5 INQCUST_DOB_DD     CHAR(2)   INIT(' '),
       5 INQCUST_DOB_MM     CHAR(2)   INIT(' '),
       5 INQCUST_DOB_YYYY   CHAR(4)   INIT(' '),
     3 INQCUST_PHONE        CHAR(20)  INIT(' '),
     3 INQCUST_ADDR,
       5 INQCUST_ADDR_LINE1 CHAR(50)  INIT(' '),
       5 INQCUST_ADDR_LINE2 CHAR(50)  INIT(' '),
       5 INQCUST_CITY       CHAR(50)  INIT(' '),
       5 INQCUST_POSTCODE   CHAR(10)  INIT(' '),
       5 INQCUST_COUNTRY    CHAR(50)  INIT(' '),
     3 INQCUST_STATUS       CHAR(10)  INIT(' '),
     3 INQCUST_CREATED_DATE,
       5 INQCUST_CREATED_DD CHAR(2)   INIT(' '),
       5 INQCUST_CREATED_MM CHAR(2)   INIT(' '),
       5 INQCUST_CREATED_YYYY CHAR(4) INIT(' '),
     3 INQCUST_CREDIT_SCORE CHAR(3)   INIT(' '),
     3 INQCUST_CS_REVIEW_DT,
       5 INQCUST_CS_REVIEW_DD  CHAR(2) INIT(' '),
       5 INQCUST_CS_REVIEW_MM  CHAR(2) INIT(' '),
       5 INQCUST_CS_REVIEW_YYYY CHAR(4) INIT(' '),
     3 INQCUST_INQ_SUCCESS  CHAR(1)   INIT(' '),
     3 INQCUST_INQ_FAIL_CD  CHAR(1)   INIT(' '),
     3 INQCUST_PCB_POINTER  CHAR(4)   INIT(' ');

   /*****************************************************************/
   /* DB2 date reformatter                                          */
   /*****************************************************************/
   DCL 1 DB2_DATE_REFORMAT,
     3 DB2_DATE_REF_YR    CHAR(4),
     3 DB2_DATE_SEP1      CHAR(1),
     3 DB2_DATE_REF_MNTH  CHAR(2),
     3 DB2_DATE_SEP2      CHAR(1),
     3 DB2_DATE_REF_DAY   CHAR(2);

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP      FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2     FIXED BIN(31) INIT(0);
   DCL WS_U_TIME         FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE      CHAR(10)      INIT(' ');
   DCL 1 WS_ORIG_DATE_GRP BASED(ADDR(WS_ORIG_DATE)),
         3 WS_ORIG_DATE_DD   CHAR(2),
         3 FILLER_OD1        CHAR(1),
         3 WS_ORIG_DATE_MM   CHAR(2),
         3 FILLER_OD2        CHAR(1),
         3 WS_ORIG_DATE_YYYY CHAR(4);
   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW       CHAR(6)   INIT(' '),
     3 * UNION,
       5 WS_TIME_NOW_STR CHAR(6),
       5 WS_TIME_NOW_GRP,
         7 WS_TIME_NOW_GRP_HH CHAR(2),
         7 WS_TIME_NOW_GRP_MM CHAR(2),
         7 WS_TIME_NOW_GRP_SS CHAR(2);
   DCL WS_ABEND_PGM      CHAR(8)   INIT('ABNDPROC');
   DCL MY_ABEND_CODE     CHAR(4)   INIT(' ');
   DCL WS_STORM_DRAIN    CHAR(1)   INIT('N');
   DCL STORM_DRAIN_COND  CHAR(20)  INIT(' ');
   DCL SQLCODE_DISPLAY   CHAR(9)   INIT(' ');
   DCL 1 CUSTOMER_KY,
     3 REQUIRED_SORT_CODE  CHAR(6) INIT('000000'),
     3 REQUIRED_ACC_NUM    CHAR(8) INIT('00000000');

   /******** PREMIERE - main logic ***********************************/
   COMM_SUCCESS   = 'N';
   COMM_FAIL_CODE = '0';

   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING);
   REQUIRED_SORT_CODE = SORTCODE;

   CALL CUSTOMER_CHECK;

   IF CUSTOMER_FOUND = 'N' THEN DO;
     COMM_SUCCESS   = 'N';
     COMM_FAIL_CODE = '1';
     CALL GET_ME_OUT_OF_HERE;
   END;

   CALL READ_ACCOUNT_DB2;
   CALL GET_ME_OUT_OF_HERE;

   /********** READ_ACCOUNT_DB2 **************************************/
   READ_ACCOUNT_DB2: PROC;
     HV_ACCOUNT_CUST_NO  = CUSTOMER_NUMBER;
     HV_ACCOUNT_SORTCODE = SORTCODE;

     EXEC SQL OPEN ACC_CURSOR;

     SQLCODE_DISPLAY = CHAR(SQLCODE,9);

     IF SQLCODE ^= 0 THEN DO;
       CALL CHECK_FOR_STORM_DRAIN;
       COMM_SUCCESS   = 'N';
       CUSTOMER_FOUND = 'N';
       COMM_FAIL_CODE = '2';
       NUMBER_OF_ACCOUNTS = 0;
       EXEC CICS SYNCPOINT ROLLBACK
            RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         ABNDINFO_REC = '';
         ABND_RESPCODE  = CHAR(EIBRESP,9);
         ABND_RESP2CODE = CHAR(EIBRESP2,9);
         EXEC CICS ASSIGN APPLID(ABND_APPLID);
         ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
         ABND_TRANID     = EIBTRNID;
         CALL POPULATE_TIME_DATE;
         ABND_DATE = WS_ORIG_DATE;
         ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                     WS_TIME_NOW_GRP_MM || ':' ||
                     WS_TIME_NOW_GRP_SS;
         ABND_UTIME_KEY = WS_U_TIME;
         ABND_CODE = 'HROL';
         EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM);
         ABND_SQLCODE  = '0';
         ABND_FREEFORM = 'RAD010 - SYNCPOINT ROLLBACK failed' ||
                         ' RESP=' || ABND_RESPCODE;
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
              COMMAREA(ABNDINFO_REC);
         EXEC CICS ABEND ABCODE('HROL') CANCEL;
       END;
       RETURN;
     END;

     CALL FETCH_DATA;

     EXEC SQL CLOSE ACC_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       CALL CHECK_FOR_STORM_DRAIN;
       COMM_SUCCESS   = 'N';
       CUSTOMER_FOUND = 'N';
       COMM_FAIL_CODE = '4';
       EXEC CICS SYNCPOINT ROLLBACK
            RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         ABNDINFO_REC = '';
         ABND_RESPCODE  = CHAR(EIBRESP,9);
         ABND_RESP2CODE = CHAR(EIBRESP2,9);
         EXEC CICS ASSIGN APPLID(ABND_APPLID);
         ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
         ABND_TRANID     = EIBTRNID;
         CALL POPULATE_TIME_DATE;
         ABND_DATE = WS_ORIG_DATE;
         ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                     WS_TIME_NOW_GRP_MM || ':' ||
                     WS_TIME_NOW_GRP_SS;
         ABND_UTIME_KEY = WS_U_TIME;
         ABND_CODE = 'HROL';
         EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM);
         ABND_SQLCODE  = '0';
         ABND_FREEFORM = 'RAD010(2) - SYNCPOINT ROLLBACK failed' ||
                         ' RESP=' || ABND_RESPCODE;
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
              COMMAREA(ABNDINFO_REC);
         EXEC CICS ABEND ABCODE('HROL') CANCEL;
       END;
       RETURN;
     END;
     COMM_SUCCESS = 'Y';
   END READ_ACCOUNT_DB2;

   /********** FETCH_DATA ********************************************/
   FETCH_DATA: PROC;
     DCL I FIXED BIN(31);
     NUMBER_OF_ACCOUNTS = 0;

     DO WHILE(SQLCODE = 0 & NUMBER_OF_ACCOUNTS < 20);
       EXEC SQL FETCH FROM ACC_CURSOR
         INTO :HV_ACCOUNT_EYECATCHER,
              :HV_ACCOUNT_CUST_NO,
              :HV_ACCOUNT_SORTCODE,
              :HV_ACCOUNT_ACC_NO,
              :HV_ACCOUNT_ACC_TYPE,
              :HV_ACCOUNT_INT_RATE,
              :HV_ACCOUNT_OPENED,
              :HV_ACCOUNT_OVERDRAFT_LIM,
              :HV_ACCOUNT_LAST_STMT,
              :HV_ACCOUNT_NEXT_STMT,
              :HV_ACCOUNT_AVAIL_BAL,
              :HV_ACCOUNT_ACTUAL_BAL;

       IF SQLCODE = 100 THEN DO;
         COMM_SUCCESS = 'Y';
         RETURN;
       END;

       IF SQLCODE ^= 0 THEN DO;
         SQLCODE_DISPLAY = CHAR(SQLCODE,9);
         CALL CHECK_FOR_STORM_DRAIN;
         COMM_SUCCESS       = 'N';
         CUSTOMER_FOUND     = 'N';
         NUMBER_OF_ACCOUNTS = 0;
         COMM_FAIL_CODE     = '3';
         EXEC CICS SYNCPOINT ROLLBACK
              RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
           ABNDINFO_REC = '';
           ABND_RESPCODE  = CHAR(EIBRESP,9);
           ABND_RESP2CODE = CHAR(EIBRESP2,9);
           EXEC CICS ASSIGN APPLID(ABND_APPLID);
           ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
           ABND_TRANID     = EIBTRNID;
           CALL POPULATE_TIME_DATE;
           ABND_DATE = WS_ORIG_DATE;
           ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                       WS_TIME_NOW_GRP_MM || ':' ||
                       WS_TIME_NOW_GRP_SS;
           ABND_UTIME_KEY = WS_U_TIME;
           ABND_CODE = 'HROL';
           EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM);
           ABND_SQLCODE  = '0';
           ABND_FREEFORM = 'FD010 - SYNCPOINT ROLLBACK failed' ||
                           ' RESP=' || ABND_RESPCODE;
           EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                COMMAREA(ABNDINFO_REC);
           EXEC CICS ABEND ABCODE('HROL') CANCEL;
         END;
         RETURN;
       END;

       NUMBER_OF_ACCOUNTS = NUMBER_OF_ACCOUNTS + 1;
       I = NUMBER_OF_ACCOUNTS;

       COMM_EYE(I)      = HV_ACCOUNT_EYECATCHER;
       COMM_CUSTNO(I)   = HV_ACCOUNT_CUST_NO;
       COMM_SCODE(I)    = HV_ACCOUNT_SORTCODE;
       COMM_ACCNO(I)    = HV_ACCOUNT_ACC_NO;
       COMM_ACC_TYPE(I) = HV_ACCOUNT_ACC_TYPE;
       COMM_INT_RATE(I) = HV_ACCOUNT_INT_RATE;
       DB2_DATE_REFORMAT = HV_ACCOUNT_OPENED;
       COMM_OPENED(I) = DB2_DATE_REF_DAY ||
                        DB2_DATE_REF_MNTH ||
                        DB2_DATE_REF_YR;
       COMM_OVERDRAFT(I) = CHAR(HV_ACCOUNT_OVERDRAFT_LIM,8);
       DB2_DATE_REFORMAT = HV_ACCOUNT_LAST_STMT;
       COMM_LAST_STMT_DT(I) = DB2_DATE_REF_DAY ||
                              DB2_DATE_REF_MNTH ||
                              DB2_DATE_REF_YR;
       DB2_DATE_REFORMAT = HV_ACCOUNT_NEXT_STMT;
       COMM_NEXT_STMT_DT(I) = DB2_DATE_REF_DAY ||
                              DB2_DATE_REF_MNTH ||
                              DB2_DATE_REF_YR;
       COMM_ACTUAL_BAL(I)   = HV_ACCOUNT_ACTUAL_BAL;
       COMM_AVAIL_BAL(I)    = HV_ACCOUNT_AVAIL_BAL;
     END;
   END FETCH_DATA;

   /********** GET_ME_OUT_OF_HERE ************************************/
   GET_ME_OUT_OF_HERE: PROC;
     EXEC CICS RETURN;
   END GET_ME_OUT_OF_HERE;

   /********** CHECK_FOR_STORM_DRAIN *********************************/
   CHECK_FOR_STORM_DRAIN: PROC;
     SELECT(SQLCODE);
       WHEN(923) STORM_DRAIN_COND = 'DB2 Connection lost ';
       OTHERWISE STORM_DRAIN_COND = 'Not Storm Drain     ';
     END;
   END CHECK_FOR_STORM_DRAIN;

   /********** ABEND_HANDLING ****************************************/
   ABEND_HANDLING: PROC;
     EXEC CICS ASSIGN ABCODE(MY_ABEND_CODE);
     SELECT(MY_ABEND_CODE);
       WHEN('AD2Z') DO;
         SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       END;
       WHEN('AFCR','AFCS','AFCT') DO;
         WS_STORM_DRAIN = 'Y';
         EXEC CICS SYNCPOINT ROLLBACK
              RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
           ABNDINFO_REC = '';
           ABND_RESPCODE  = CHAR(EIBRESP,9);
           ABND_RESP2CODE = CHAR(EIBRESP2,9);
           EXEC CICS ASSIGN APPLID(ABND_APPLID);
           ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
           ABND_TRANID     = EIBTRNID;
           CALL POPULATE_TIME_DATE;
           ABND_DATE = WS_ORIG_DATE;
           ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                       WS_TIME_NOW_GRP_MM || ':' ||
                       WS_TIME_NOW_GRP_SS;
           ABND_UTIME_KEY = WS_U_TIME;
           ABND_CODE = 'HROL';
           EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM);
           ABND_SQLCODE  = '0';
           ABND_FREEFORM = 'AH010 - SYNCPOINT ROLLBACK failed' ||
                           ' RESP=' || ABND_RESPCODE;
           EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                COMMAREA(ABNDINFO_REC);
           EXEC CICS ABEND ABCODE('HROL') CANCEL;
         END;
         COMM_SUCCESS = 'N';
         EXEC CICS RETURN;
       END;
       OTHERWISE;
     END;
     IF WS_STORM_DRAIN = 'N' THEN DO;
       EXEC CICS ABEND ABCODE(MY_ABEND_CODE) NODUMP CANCEL;
     END;
   END ABEND_HANDLING;

   /********** CUSTOMER_CHECK ****************************************/
   CUSTOMER_CHECK: PROC;
     IF CUSTOMER_NUMBER = '0000000000' THEN DO;
       CUSTOMER_FOUND     = 'N';
       NUMBER_OF_ACCOUNTS = 0;
       RETURN;
     END;
     IF CUSTOMER_NUMBER = '9999999999' THEN DO;
       CUSTOMER_FOUND     = 'N';
       NUMBER_OF_ACCOUNTS = 0;
       RETURN;
     END;
     INQCUST_COMMAREA = '';
     INQCUST_CUSTNO   = CUSTOMER_NUMBER;
     EXEC CICS LINK PROGRAM('INQCUST ')
          COMMAREA(INQCUST_COMMAREA);
     IF INQCUST_INQ_SUCCESS = 'Y' THEN
       CUSTOMER_FOUND = 'Y';
     ELSE DO;
       CUSTOMER_FOUND     = 'N';
       NUMBER_OF_ACCOUNTS = 0;
     END;
   END CUSTOMER_CHECK;

   /********** POPULATE_TIME_DATE ************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
          ABSTIME(WS_U_TIME)
          DDMMYYYY(WS_ORIG_DATE)
          TIME(WS_TIME_NOW)
          DATESEP;
   END POPULATE_TIME_DATE;

 END INQACCCU;
