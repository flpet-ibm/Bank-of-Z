 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2026                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* INQTRAND - Inquire Transaction Detail                          */
 /* Retrieves a single PROCTRAN row by composite key:             */
 /*   sortcode + account number + date + time + reference.        */
 /***************************************************************** */
*PROCESS SYSTEM(CICS) SQL MARGINS(1,72);
 INQTRAND: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA (from INQTRAND.cpy)                               */
   /*****************************************************************/
   %INCLUDE INQTRAND;
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR) LIKE INQTRAND_TMPL;

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* PROCTRAN DB2 table declaration                                */
   /*****************************************************************/
   EXEC SQL INCLUDE PROCDB2;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* PROCTRAN host variables                                       */
   /*****************************************************************/
   DCL 1 HOST_PROCTRAN_ROW,
     3 HV_PROCTRAN_EYECATCHER    CHAR(4),
     3 HV_PROCTRAN_SORTCODE      CHAR(6),
     3 HV_PROCTRAN_NUMBER        CHAR(8),
     3 HV_PROCTRAN_DATE          CHAR(10),
     3 HV_PROCTRAN_TIME          CHAR(6),
     3 HV_PROCTRAN_REF           CHAR(12),
     3 HV_PROCTRAN_TYPE          CHAR(3),
     3 HV_PROCTRAN_DESC          CHAR(40),
     3 HV_PROCTRAN_AMOUNT        FIXED DEC(12,2);

   /*****************************************************************/
   /* ABNDINFO record                                               */
   /*****************************************************************/
   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* TRAND DB2 cursor declaration                                  */
   /*****************************************************************/
   EXEC SQL DECLARE TRAND_CURSOR CURSOR FOR
      SELECT PROCTRAN_EYECATCHER,
             PROCTRAN_SORTCODE,
             PROCTRAN_NUMBER,
             PROCTRAN_DATE,
             PROCTRAN_TIME,
             PROCTRAN_REF,
             PROCTRAN_TYPE,
             PROCTRAN_DESC,
             PROCTRAN_AMOUNT
        FROM PROCTRAN
       WHERE PROCTRAN_SORTCODE = :HV_PROCTRAN_SORTCODE
         AND PROCTRAN_NUMBER   = :HV_PROCTRAN_NUMBER
         AND PROCTRAN_DATE     = :HV_PROCTRAN_DATE
         AND PROCTRAN_TIME     = :HV_PROCTRAN_TIME
         AND PROCTRAN_REF      = :HV_PROCTRAN_REF
       FOR FETCH ONLY;

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP      FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2     FIXED BIN(31) INIT(0);
   DCL WS_ABEND_PGM      CHAR(8)       INIT('ABNDPROC');
   DCL WS_U_TIME         FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE      CHAR(10)      INIT(' ');

   DCL 1 WS_ORIG_DATE_GRP  DEF(WS_ORIG_DATE),
     3 WS_ORIG_DATE_DD    CHAR(2),
     3 WS_ORIG_DATE_SEP1  CHAR(1),
     3 WS_ORIG_DATE_MM    CHAR(2),
     3 WS_ORIG_DATE_SEP2  CHAR(1),
     3 WS_ORIG_DATE_YYYY  CHAR(4);

   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW        CHAR(6)  INIT(' '),
     3 * UNION,
       5 WS_TIME_NOW_CHAR CHAR(6),
       5 WS_TIME_NOW_GRP,
         7 WS_TIME_NOW_GRP_HH CHAR(2),
         7 WS_TIME_NOW_GRP_MM CHAR(2),
         7 WS_TIME_NOW_GRP_SS CHAR(2);

   /* Working storage for building composite transaction ID */
   DCL WS_TRAN_ID_SC     CHAR(6)  INIT(' ');
   DCL WS_TRAN_ID_NUM    CHAR(8)  INIT(' ');
   DCL WS_TRAN_ID_DATE   CHAR(8)  INIT(' ');
   DCL WS_TRAN_ID_TIME   CHAR(6)  INIT(' ');
   DCL WS_TRAN_ID_REF    CHAR(12) INIT(' ');

   /* Date conversion working storage */
   DCL 1 WS_DATE_WORK,
     3 * UNION,
       5 WS_DATE_YYYYMMDD  CHAR(8),
       5 WS_DATE_YYYYMMDD_GRP,
         7 WS_DATE_YYYY    CHAR(4),
         7 WS_DATE_MM      CHAR(2),
         7 WS_DATE_DD      CHAR(2),
     3 * UNION,
       5 WS_DATE_ISO        CHAR(10),
       5 WS_DATE_ISO_GRP,
         7 WS_DATE_ISO_YYYY CHAR(4),
         7 WS_DATE_ISO_SEP1 CHAR(1),
         7 WS_DATE_ISO_MM   CHAR(2),
         7 WS_DATE_ISO_SEP2 CHAR(1),
         7 WS_DATE_ISO_DD   CHAR(2);

   /*****************************************************************/
   /* MAIN PROCEDURE                                                */
   /*****************************************************************/

   /* Set up abend handler */
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING);

   /* Validate eyecatcher */
   IF DFHCOMMAREA.INQTRAND_EYE ^= 'ITRD' THEN
     DFHCOMMAREA.INQTRAND_EYE = 'ITRD';

   /* Initialise output flags */
   DFHCOMMAREA.INQTRAND_SUCCESS = 'N';
   DFHCOMMAREA.INQTRAND_FOUND   = 'N';

   /* Read transaction from DB2 */
   CALL READ_TRANSACTION_DB2;

   /* Return to CICS */
   CALL GET_ME_OUT_OF_HERE;

   /*****************************************************************/
   /* READ_TRANSACTION_DB2 - Open cursor, fetch, close             */
   /*****************************************************************/
   READ_TRANSACTION_DB2: PROC;

     /* Populate host variables from commarea input */
     HV_PROCTRAN_SORTCODE = DFHCOMMAREA.INQTRAND_SORTCODE;
     HV_PROCTRAN_NUMBER   = DFHCOMMAREA.INQTRAND_ACCNO;

     /* Convert YYYYMMDD input to YYYY-MM-DD for DB2 */
     WS_DATE_YYYYMMDD   = DFHCOMMAREA.INQTRAND_DATE;
     CALL CONVERT_YYYYMMDD_TO_ISO;
     HV_PROCTRAN_DATE   = WS_DATE_ISO;

     HV_PROCTRAN_TIME   = DFHCOMMAREA.INQTRAND_TIME;
     HV_PROCTRAN_REF    = DFHCOMMAREA.INQTRAND_REF;

     /* Open cursor */
     EXEC SQL OPEN TRAND_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

     /* Fetch single row */
     EXEC SQL FETCH TRAND_CURSOR
       INTO :HV_PROCTRAN_EYECATCHER,
            :HV_PROCTRAN_SORTCODE,
            :HV_PROCTRAN_NUMBER,
            :HV_PROCTRAN_DATE,
            :HV_PROCTRAN_TIME,
            :HV_PROCTRAN_REF,
            :HV_PROCTRAN_TYPE,
            :HV_PROCTRAN_DESC,
            :HV_PROCTRAN_AMOUNT;

     IF SQLCODE = 0 THEN DO;
       /* Transaction found - populate output */
       DFHCOMMAREA.INQTRAND_FOUND = 'Y';

       /* Convert DATE from YYYY-MM-DD back to YYYYMMDD */
       WS_DATE_ISO = HV_PROCTRAN_DATE;
       CALL CONVERT_ISO_TO_YYYYMMDD;

       /* Build composite transaction ID */
       WS_TRAN_ID_SC   = HV_PROCTRAN_SORTCODE;
       WS_TRAN_ID_NUM  = HV_PROCTRAN_NUMBER;
       WS_TRAN_ID_DATE = WS_DATE_YYYYMMDD;
       WS_TRAN_ID_TIME = HV_PROCTRAN_TIME;
       WS_TRAN_ID_REF  = HV_PROCTRAN_REF;

       DFHCOMMAREA.INQTRAND_TRAN_ID      = WS_TRAN_ID_SC || '-' ||
                               WS_TRAN_ID_NUM || '-' ||
                               WS_TRAN_ID_DATE || '-' ||
                               WS_TRAN_ID_TIME || '-' ||
                               WS_TRAN_ID_REF;
       DFHCOMMAREA.INQTRAND_TRAN_SORTCODE = HV_PROCTRAN_SORTCODE;
       DFHCOMMAREA.INQTRAND_TRAN_ACCNO    = HV_PROCTRAN_NUMBER;
       DFHCOMMAREA.INQTRAND_TRAN_DATE     = WS_DATE_YYYYMMDD;
       DFHCOMMAREA.INQTRAND_TRAN_TIME     = HV_PROCTRAN_TIME;
       DFHCOMMAREA.INQTRAND_TRAN_REF      = HV_PROCTRAN_REF;
       DFHCOMMAREA.INQTRAND_TRAN_TYPE     = HV_PROCTRAN_TYPE;
       DFHCOMMAREA.INQTRAND_TRAN_DESC     = HV_PROCTRAN_DESC;
       DFHCOMMAREA.INQTRAND_TRAN_AMOUNT   = HV_PROCTRAN_AMOUNT;
       DFHCOMMAREA.INQTRAND_SUCCESS       = 'Y';
     END;
     ELSE IF SQLCODE = 100 THEN DO;
       /* Not found - not an error */
       DFHCOMMAREA.INQTRAND_FOUND   = 'N';
       DFHCOMMAREA.INQTRAND_SUCCESS = 'Y';
     END;
     ELSE DO;
       /* SQL error */
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

     /* Close cursor */
     EXEC SQL CLOSE TRAND_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

   END READ_TRANSACTION_DB2;

   /*****************************************************************/
   /* GET_ME_OUT_OF_HERE - CICS RETURN                              */
   /*****************************************************************/
   GET_ME_OUT_OF_HERE: PROC;
     EXEC CICS RETURN;
   END GET_ME_OUT_OF_HERE;

   /*****************************************************************/
   /* ABEND_ROUTINE - Log SQL error and abend                       */
   /*****************************************************************/
   ABEND_ROUTINE: PROC;

     ABNDINFO_REC = '';
     ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP);
     ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2);

     EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);

     ABNDINFO_REC.ABND_TASKNO_KEY = EIBTASKN;
     ABNDINFO_REC.ABND_TRANID     = EIBTRNID;

     CALL POPULATE_TIME_DATE;

     ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
     ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                 WS_TIME_NOW_GRP_MM || ':' ||
                 WS_TIME_NOW_GRP_SS;
     ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
     ABNDINFO_REC.ABND_CODE      = 'ITRD';

     EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);

     ABNDINFO_REC.ABND_FREEFORM = 'INQTRAND - DB2 Error. SQLCODE=' ||
                     ABNDINFO_REC.ABND_SQLCODE;

     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);

     EXEC CICS ABEND ABCODE('ITRD')
               CANCEL
               NODUMP;

   END ABEND_ROUTINE;

   /*****************************************************************/
   /* ABEND_HANDLING - Handle unexpected CICS abends               */
   /*****************************************************************/
   ABEND_HANDLING: PROC;

     ABNDINFO_REC = '';
     ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP);
     ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2);

     EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);

     ABNDINFO_REC.ABND_TASKNO_KEY = EIBTASKN;
     ABNDINFO_REC.ABND_TRANID     = EIBTRNID;

     CALL POPULATE_TIME_DATE;

     ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
     ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                 WS_TIME_NOW_GRP_MM || ':' ||
                 WS_TIME_NOW_GRP_SS;
     ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
     ABNDINFO_REC.ABND_CODE      = 'ITRD';

     EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);

     ABNDINFO_REC.ABND_FREEFORM = 'INQTRAND - Abend occurred';

     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);

     EXEC CICS RETURN;

   END ABEND_HANDLING;

   /*****************************************************************/
   /* POPULATE_TIME_DATE - Get current CICS time/date              */
   /*****************************************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME ABSTIME(WS_U_TIME)
               DDMMYYYY(WS_ORIG_DATE)
               TIME(WS_TIME_NOW)
               DATESEP('/');
   END POPULATE_TIME_DATE;

   /*****************************************************************/
   /* CONVERT_YYYYMMDD_TO_ISO - YYYYMMDD -> YYYY-MM-DD             */
   /*****************************************************************/
   CONVERT_YYYYMMDD_TO_ISO: PROC;
     WS_DATE_ISO_YYYY = WS_DATE_YYYY;
     WS_DATE_ISO_SEP1 = '-';
     WS_DATE_ISO_MM   = WS_DATE_MM;
     WS_DATE_ISO_SEP2 = '-';
     WS_DATE_ISO_DD   = WS_DATE_DD;
   END CONVERT_YYYYMMDD_TO_ISO;

   /*****************************************************************/
   /* CONVERT_ISO_TO_YYYYMMDD - YYYY-MM-DD -> YYYYMMDD             */
   /*****************************************************************/
   CONVERT_ISO_TO_YYYYMMDD: PROC;
     WS_DATE_YYYY = WS_DATE_ISO_YYYY;
     WS_DATE_MM   = WS_DATE_ISO_MM;
     WS_DATE_DD   = WS_DATE_ISO_DD;
   END CONVERT_ISO_TO_YYYYMMDD;

 END INQTRAND;
