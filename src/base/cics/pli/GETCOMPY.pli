 *PROCESS CICS;
 /* ----------------------------------------------------------------- */
 /*  Copyright IBM Corp. 2023                                         */
 /*  GETCOMPY - Return the company name                               */
 /* ----------------------------------------------------------------- */
 GETCOMPY: PROCEDURE OPTIONS(MAIN REENTRANT);

   DCL COMM_PTR            POINTER;
   DCL 1 DFHCOMMAREA BASED(COMM_PTR),
         2 GETCOMPANYOPERATION,
           3 COMPANY_NAME   CHAR(40);

   DCL WS_CICS_RESP        FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2       FIXED BIN(31) INIT(0);

   EXEC CICS ADDRESS
        COMMAREA(COMM_PTR)
        RESP(WS_CICS_RESP)
        RESP2(WS_CICS_RESP2) ;

   COMPANY_NAME = 'CICS Bank Sample Application    ';

   EXEC CICS RETURN ;

 END GETCOMPY;
