 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* INQCUST - Inquire Customer                                     */
 /* Reads customer data from DB2 CUSTOMER table by sort code +     */
 /* customer number. Handles 0=random, 9=last, specific number.   */
 /***************************************************************** */
*PROCESS SYSTEM(CICS) SQL MARGINS(1,72);
 INQCUST: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA (from INQCUSTZ.cpy)                               */
   /*****************************************************************/
   %INCLUDE INQCUSTZ;
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR) LIKE INQCUSTZ_TMPL;

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* CUSTOMER DB2 table declaration                                */
   /*****************************************************************/
   EXEC SQL INCLUDE CUSTDB2;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* CUSTOMER host variables                                       */
   /*****************************************************************/
   DCL 1 HOST_CUSTOMER_ROW,
     3 HV_CUSTOMER_EYECATCHER     CHAR(4),
     3 HV_CUSTOMER_SORTCODE       CHAR(6),
     3 HV_CUSTOMER_NUMBER         CHAR(10),
     3 HV_CUSTOMER_TITLE          CHAR(10),
     3 HV_CUSTOMER_FIRST_NAME     CHAR(50),
     3 HV_CUSTOMER_LAST_NAME      CHAR(50),
     3 HV_CUSTOMER_DOB            FIXED BIN(31),
     3 HV_CUSTOMER_PHONE          CHAR(20),
     3 HV_CUSTOMER_ADDR_LINE1     CHAR(50),
     3 HV_CUSTOMER_ADDR_LINE2     CHAR(50),
     3 HV_CUSTOMER_CITY           CHAR(50),
     3 HV_CUSTOMER_POSTCODE       CHAR(10),
     3 HV_CUSTOMER_COUNTRY        CHAR(50),
     3 HV_CUSTOMER_STATUS         CHAR(10),
     3 HV_CUSTOMER_CREATE_DATE    FIXED BIN(31),
     3 HV_CUSTOMER_CREDIT_SCORE   FIXED BIN(15),
     3 HV_CUSTOMER_CS_REVIEW_DATE FIXED BIN(31);

   /*****************************************************************/
   /* OUTPUT_DATA - CUSTOMER record                                 */
   /*****************************************************************/
   %INCLUDE CUSTOMER;
   DCL 1 OUTPUT_DATA LIKE CUSTOMER_TMPL;

   /*****************************************************************/
   /* ABNDINFO record                                               */
   /*****************************************************************/
   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP       FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2      FIXED BIN(31) INIT(0);
   DCL WS_U_TIME          FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE       CHAR(10)      INIT(' ');
   DCL 1 WS_ORIG_DATE_GRP BASED(ADDR(WS_ORIG_DATE)),
         3 WS_ORIG_DATE_DD   CHAR(2),
         3 FILLER_OD1        CHAR(1),
         3 WS_ORIG_DATE_MM   CHAR(2),
         3 FILLER_OD2        CHAR(1),
         3 WS_ORIG_DATE_YYYY CHAR(4);
   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW       CHAR(6)   INIT(' '),
     3 * UNION,
       5 WS_TIME_NOW_STR CHAR(6),
       5 WS_TIME_NOW_GRP,
         7 WS_TIME_NOW_GRP_HH CHAR(2),
         7 WS_TIME_NOW_GRP_MM CHAR(2),
         7 WS_TIME_NOW_GRP_SS CHAR(2);
   DCL WS_ABEND_PGM      CHAR(8)   INIT('ABNDPROC');
   DCL MY_ABEND_CODE     CHAR(4)   INIT(' ');
   DCL WS_STORM_DRAIN    CHAR(1)   INIT('N');
   DCL SQLCODE_DISPLAY   CHAR(9)   INIT(' ');
   DCL REQUIRED_SORT_CODE  CHAR(6) INIT('000000');
   DCL REQUIRED_CUST_NUMBER CHAR(10) INIT('0000000000');
   DCL REQUIRED_SORT_CODE2  CHAR(6) INIT('000000');
   DCL REQUIRED_CUST_NUMBER2 CHAR(10) INIT('0000000000');
   DCL RANDOM_CUSTOMER    CHAR(10) INIT('0000000000');
   DCL EXIT_VSAM_READ     CHAR(1)  INIT('N');
   DCL EXIT_DB2_READ      CHAR(1)  INIT('N');
   DCL WS_V_RETRIED       CHAR(1)  INIT('N');
   DCL WS_D_RETRIED       CHAR(1)  INIT('N');
   DCL INQCUST_RETRY      FIXED BIN(31) INIT(0);
   DCL 1 NCS_CUST_NO_STUFF,
     3 NCS_CUST_NO_NAME,
       5 NCS_CUST_NO_ACT_NAME  CHAR(9)  INIT('BANKZCUST'),
       5 NCS_CUST_NO_TEST_SORT CHAR(6)  INIT(' '),
       5 NCS_CUST_NO_FILL      CHAR(2)  INIT('  '),
     3 NCS_CUST_NO_INC         FIXED BIN(63) INIT(0),
     3 NCS_CUST_NO_VALUE       FIXED BIN(63) INIT(0),
     3 NCS_CUST_NO_RESP        CHAR(2)  INIT('00');

   /******** PREMIERE - main logic ***********************************/
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING);
   DFHCOMMAREA.INQCUST_INQ_SUCCESS = 'N';
   DFHCOMMAREA.INQCUST_INQ_FAIL_CD = '0';

   IF DFHCOMMAREA.INQCUST_SCODE = ' ' THEN
     REQUIRED_SORT_CODE = SORTCODE;
   ELSE
     REQUIRED_SORT_CODE = DFHCOMMAREA.INQCUST_SCODE;
   REQUIRED_CUST_NUMBER = DFHCOMMAREA.INQCUST_CUSTNO;

   IF DFHCOMMAREA.INQCUST_CUSTNO = '0000000000' |
      DFHCOMMAREA.INQCUST_CUSTNO = '9999999999' THEN DO;
     CALL READ_CUSTOMER_NCS;
     IF DFHCOMMAREA.INQCUST_INQ_SUCCESS = 'Y' THEN
       REQUIRED_CUST_NUMBER = CHAR(NCS_CUST_NO_VALUE,10);
     ELSE
       CALL GET_ME_OUT_OF_HERE;
   END;

   IF DFHCOMMAREA.INQCUST_CUSTNO = '0000000000' THEN DO;
     CALL GENERATE_RANDOM_CUSTOMER;
     REQUIRED_CUST_NUMBER = RANDOM_CUSTOMER;
   END;

   EXIT_VSAM_READ = 'N';
   EXIT_DB2_READ  = 'N';
   WS_D_RETRIED   = 'N';
   WS_V_RETRIED   = 'N';

   DO WHILE(EXIT_VSAM_READ = 'N');
     CALL READ_CUSTOMER_DB2;
   END;

   IF DFHCOMMAREA.INQCUST_INQ_SUCCESS = 'Y' THEN DO;
     DFHCOMMAREA.INQCUST_INQ_FAIL_CD  = '0';
     DFHCOMMAREA.INQCUST_EYE          = OUTPUT_DATA.CUSTOMER_EYECATCHER;
     DFHCOMMAREA.INQCUST_SCODE        = OUTPUT_DATA.CUSTOMER_SORTCODE;
     DFHCOMMAREA.INQCUST_CUSTNO       = OUTPUT_DATA.CUSTOMER_NUMBER;
     DFHCOMMAREA.INQCUST_TITLE        = OUTPUT_DATA.CUSTOMER_TITLE;
     DFHCOMMAREA.INQCUST_FIRST_NAME   = OUTPUT_DATA.CUSTOMER_FIRST_NAME;
     DFHCOMMAREA.INQCUST_LAST_NAME    = OUTPUT_DATA.CUSTOMER_LAST_NAME;
     DFHCOMMAREA.INQCUST_DOB_DD       = OUTPUT_DATA.CUSTOMER_DOB_DAY;
     DFHCOMMAREA.INQCUST_DOB_MM       = OUTPUT_DATA.CUSTOMER_DOB_MONTH;
     DFHCOMMAREA.INQCUST_DOB_YYYY     = OUTPUT_DATA.CUSTOMER_DOB_YEAR;
     DFHCOMMAREA.INQCUST_PHONE        = OUTPUT_DATA.CUSTOMER_PHONE;
     DFHCOMMAREA.INQCUST_ADDR_LINE1   = OUTPUT_DATA.CUSTOMER_ADDR_LINE1;
     DFHCOMMAREA.INQCUST_ADDR_LINE2   = OUTPUT_DATA.CUSTOMER_ADDR_LINE2;
     DFHCOMMAREA.INQCUST_CITY         = OUTPUT_DATA.CUSTOMER_CITY;
     DFHCOMMAREA.INQCUST_POSTCODE     = OUTPUT_DATA.CUSTOMER_POSTCODE;
     DFHCOMMAREA.INQCUST_COUNTRY      = OUTPUT_DATA.CUSTOMER_COUNTRY;
     DFHCOMMAREA.INQCUST_STATUS       = OUTPUT_DATA.CUSTOMER_STATUS;
     DFHCOMMAREA.INQCUST_CREATED_DD = OUTPUT_DATA.CUSTOMER_CREATED_DAY;
     DFHCOMMAREA.INQCUST_CREATED_MM =
         OUTPUT_DATA.CUSTOMER_CREATED_MONTH;
     DFHCOMMAREA.INQCUST_CREATED_YYYY =
         OUTPUT_DATA.CUSTOMER_CREATED_YEAR;
     DFHCOMMAREA.INQCUST_CREDIT_SCORE =
         OUTPUT_DATA.CUSTOMER_CREDIT_SCORE;
     DFHCOMMAREA.INQCUST_CS_REVIEW_DD =
         OUTPUT_DATA.CUSTOMER_CS_REVIEW_DAY;
     DFHCOMMAREA.INQCUST_CS_REVIEW_MM =
         OUTPUT_DATA.CUSTOMER_CS_REVIEW_MONTH;
     DFHCOMMAREA.INQCUST_CS_REVIEW_YYYY =
         OUTPUT_DATA.CUSTOMER_CS_REVIEW_YEAR;
   END;
   CALL GET_ME_OUT_OF_HERE;

   /********** READ_CUSTOMER_NCS *************************************/
   READ_CUSTOMER_NCS: PROC;
     CALL GET_LAST_CUSTOMER_DB2;
     IF DFHCOMMAREA.INQCUST_INQ_SUCCESS = 'Y' THEN
       NCS_CUST_NO_VALUE = DECIMAL(REQUIRED_CUST_NUMBER2,10,0);
   END READ_CUSTOMER_NCS;

   /********** READ_CUSTOMER_DB2 *************************************/
   READ_CUSTOMER_DB2: PROC;
     OUTPUT_DATA        = '';
     HOST_CUSTOMER_ROW  = '';

     HV_CUSTOMER_SORTCODE = REQUIRED_SORT_CODE;
     HV_CUSTOMER_NUMBER   = REQUIRED_CUST_NUMBER;

     EXEC SQL
       SELECT CUSTOMER_EYECATCHER,
              CUSTOMER_SORTCODE,
              CUSTOMER_NUMBER,
              CUSTOMER_TITLE,
              CUSTOMER_FIRST_NAME,
              CUSTOMER_LAST_NAME,
              CUSTOMER_DATE_OF_BIRTH,
              CUSTOMER_PHONE,
              CUSTOMER_ADDR_LINE1,
              CUSTOMER_ADDR_LINE2,
              CUSTOMER_CITY,
              CUSTOMER_POSTCODE,
              CUSTOMER_COUNTRY,
              CUSTOMER_STATUS,
              CUSTOMER_CREATED_DATE,
              CUSTOMER_CREDIT_SCORE,
              CUSTOMER_CS_REVIEW_DATE
         INTO :HV_CUSTOMER_EYECATCHER,
              :HV_CUSTOMER_SORTCODE,
              :HV_CUSTOMER_NUMBER,
              :HV_CUSTOMER_TITLE,
              :HV_CUSTOMER_FIRST_NAME,
              :HV_CUSTOMER_LAST_NAME,
              :HV_CUSTOMER_DOB,
              :HV_CUSTOMER_PHONE,
              :HV_CUSTOMER_ADDR_LINE1,
              :HV_CUSTOMER_ADDR_LINE2,
              :HV_CUSTOMER_CITY,
              :HV_CUSTOMER_POSTCODE,
              :HV_CUSTOMER_COUNTRY,
              :HV_CUSTOMER_STATUS,
              :HV_CUSTOMER_CREATE_DATE,
              :HV_CUSTOMER_CREDIT_SCORE,
              :HV_CUSTOMER_CS_REVIEW_DATE
         FROM CUSTOMER
        WHERE CUSTOMER_SORTCODE = :HV_CUSTOMER_SORTCODE
          AND CUSTOMER_NUMBER   = :HV_CUSTOMER_NUMBER;

     IF SQLCODE = 0 THEN DO;
       EXIT_VSAM_READ       = 'Y';
       DFHCOMMAREA.INQCUST_INQ_SUCCESS  = 'Y';
       OUTPUT_DATA.CUSTOMER_EYECATCHER  = HV_CUSTOMER_EYECATCHER;
       OUTPUT_DATA.CUSTOMER_SORTCODE    = HV_CUSTOMER_SORTCODE;
       OUTPUT_DATA.CUSTOMER_NUMBER      = HV_CUSTOMER_NUMBER;
       OUTPUT_DATA.CUSTOMER_TITLE       = HV_CUSTOMER_TITLE;
       OUTPUT_DATA.CUSTOMER_FIRST_NAME  = HV_CUSTOMER_FIRST_NAME;
       OUTPUT_DATA.CUSTOMER_LAST_NAME   = HV_CUSTOMER_LAST_NAME;
       OUTPUT_DATA.CUSTOMER_DOB_YEAR    =
         CHAR(HV_CUSTOMER_DOB / 10000, 4);
       OUTPUT_DATA.CUSTOMER_DOB_MONTH   =
         CHAR(MOD(HV_CUSTOMER_DOB / 100, 100), 2);
       OUTPUT_DATA.CUSTOMER_DOB_DAY     =
         CHAR(MOD(HV_CUSTOMER_DOB, 100), 2);
       OUTPUT_DATA.CUSTOMER_PHONE       = HV_CUSTOMER_PHONE;
       OUTPUT_DATA.CUSTOMER_ADDR_LINE1  = HV_CUSTOMER_ADDR_LINE1;
       OUTPUT_DATA.CUSTOMER_ADDR_LINE2  = HV_CUSTOMER_ADDR_LINE2;
       OUTPUT_DATA.CUSTOMER_CITY        = HV_CUSTOMER_CITY;
       OUTPUT_DATA.CUSTOMER_POSTCODE    = HV_CUSTOMER_POSTCODE;
       OUTPUT_DATA.CUSTOMER_COUNTRY     = HV_CUSTOMER_COUNTRY;
       OUTPUT_DATA.CUSTOMER_STATUS      = HV_CUSTOMER_STATUS;
       OUTPUT_DATA.CUSTOMER_CREATED_YEAR  =
         CHAR(HV_CUSTOMER_CREATE_DATE / 10000, 4);
       OUTPUT_DATA.CUSTOMER_CREATED_MONTH =
         CHAR(MOD(HV_CUSTOMER_CREATE_DATE / 100, 100), 2);
       OUTPUT_DATA.CUSTOMER_CREATED_DAY   =
         CHAR(MOD(HV_CUSTOMER_CREATE_DATE, 100), 2);
       OUTPUT_DATA.CUSTOMER_CREDIT_SCORE =
         CHAR(HV_CUSTOMER_CREDIT_SCORE, 3);
       OUTPUT_DATA.CUSTOMER_CS_REVIEW_YEAR  =
         CHAR(HV_CUSTOMER_CS_REVIEW_DATE / 10000, 4);
       OUTPUT_DATA.CUSTOMER_CS_REVIEW_MONTH =
         CHAR(MOD(HV_CUSTOMER_CS_REVIEW_DATE / 100, 100), 2);
       OUTPUT_DATA.CUSTOMER_CS_REVIEW_DAY   =
         CHAR(MOD(HV_CUSTOMER_CS_REVIEW_DATE, 100), 2);
       RETURN;
     END;

     IF SQLCODE = 100 & DFHCOMMAREA.INQCUST_CUSTNO = '0000000000' THEN
         DO;
       IF INQCUST_RETRY < 1000 THEN DO;
         CALL GENERATE_RANDOM_CUSTOMER_AGAIN;
         REQUIRED_CUST_NUMBER = RANDOM_CUSTOMER;
         RETURN;
       END;
       ELSE DO;
         EXIT_VSAM_READ       = 'Y';
         DFHCOMMAREA.INQCUST_INQ_SUCCESS  = 'N';
         DFHCOMMAREA.INQCUST_INQ_FAIL_CD  = '1';
         RETURN;
       END;
     END;

     IF SQLCODE = 100 & DFHCOMMAREA.INQCUST_CUSTNO = '9999999999' &
        WS_V_RETRIED = 'N' THEN DO;
       CALL GET_LAST_CUSTOMER_DB2;
       REQUIRED_CUST_NUMBER = CHAR(NCS_CUST_NO_VALUE,10);
       WS_V_RETRIED = 'Y';
       RETURN;
     END;

     IF SQLCODE = 100 & DFHCOMMAREA.INQCUST_CUSTNO ^= '9999999999' &
        DFHCOMMAREA.INQCUST_CUSTNO ^= '0000000000' THEN DO;
       OUTPUT_DATA.CUSTOMER_NUMBER      = REQUIRED_CUST_NUMBER;
       EXIT_VSAM_READ       = 'Y';
       DFHCOMMAREA.INQCUST_INQ_SUCCESS  = 'N';
       DFHCOMMAREA.INQCUST_INQ_FAIL_CD  = '1';
       DFHCOMMAREA.INQCUST_TITLE        = ' ';
       DFHCOMMAREA.INQCUST_FIRST_NAME   = ' ';
       DFHCOMMAREA.INQCUST_LAST_NAME    = ' ';
       DFHCOMMAREA.INQCUST_PHONE        = ' ';
       DFHCOMMAREA.INQCUST_ADDR_LINE1   = ' ';
       DFHCOMMAREA.INQCUST_ADDR_LINE2   = ' ';
       DFHCOMMAREA.INQCUST_CITY         = ' ';
       DFHCOMMAREA.INQCUST_POSTCODE     = ' ';
       DFHCOMMAREA.INQCUST_COUNTRY      = ' ';
       DFHCOMMAREA.INQCUST_STATUS       = ' ';
       RETURN;
     END;

     IF SQLCODE ^= 0 & SQLCODE ^= 100 THEN DO;
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'CVR1';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_FREEFORM =
           'RCD010 - CUSTOMER DB2 SELECT failed' ||
                       ' SQLCODE=' || CHAR(SQLCODE,9);
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       EXEC CICS ABEND ABCODE('CVR1') CANCEL;
     END;
   END READ_CUSTOMER_DB2;

   /********** GET_ME_OUT_OF_HERE ************************************/
   GET_ME_OUT_OF_HERE: PROC;
     EXEC CICS RETURN;
   END GET_ME_OUT_OF_HERE;

   /********** ABEND_HANDLING ****************************************/
   ABEND_HANDLING: PROC;
     EXEC CICS ASSIGN ABCODE(MY_ABEND_CODE);
     SELECT(MY_ABEND_CODE);
       WHEN('AFCR','AFCS','AFCT') DO;
         WS_STORM_DRAIN = 'Y';
         EXEC CICS SYNCPOINT ROLLBACK
              RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
           ABNDINFO_REC = '';
           ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
           ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
           EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
           ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
           ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
           CALL POPULATE_TIME_DATE;
           ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
           ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                       WS_TIME_NOW_GRP_MM || ':' ||
                       WS_TIME_NOW_GRP_SS;
           ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
           ABNDINFO_REC.ABND_CODE = 'HROL';
           EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
           ABNDINFO_REC.ABND_SQLCODE  = '0';
           ABNDINFO_REC.ABND_FREEFORM =
               'AH010 - SYNCPOINT ROLLBACK failed' ||
                           ' RESP=' || ABNDINFO_REC.ABND_RESPCODE;
           EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                COMMAREA(ABNDINFO_REC);
           EXEC CICS ABEND ABCODE('HROL') CANCEL;
         END;
         DFHCOMMAREA.INQCUST_INQ_SUCCESS = 'N';
         DFHCOMMAREA.INQCUST_INQ_FAIL_CD = '2';
         EXEC CICS RETURN;
       END;
       OTHERWISE;
     END;
     IF WS_STORM_DRAIN = 'N' THEN DO;
       EXEC CICS ABEND ABCODE(MY_ABEND_CODE) NODUMP;
     END;
   END ABEND_HANDLING;

   /********** GET_LAST_CUSTOMER_DB2 *********************************/
   GET_LAST_CUSTOMER_DB2: PROC;
     OUTPUT_DATA       = '';
     HOST_CUSTOMER_ROW = '';

     HV_CUSTOMER_SORTCODE = REQUIRED_SORT_CODE2;

     EXEC SQL
       SELECT CUSTOMER_EYECATCHER,
              CUSTOMER_SORTCODE,
              CUSTOMER_NUMBER,
              CUSTOMER_TITLE,
              CUSTOMER_FIRST_NAME,
              CUSTOMER_LAST_NAME,
              CUSTOMER_DATE_OF_BIRTH,
              CUSTOMER_PHONE,
              CUSTOMER_ADDR_LINE1,
              CUSTOMER_ADDR_LINE2,
              CUSTOMER_CITY,
              CUSTOMER_POSTCODE,
              CUSTOMER_COUNTRY,
              CUSTOMER_STATUS,
              CUSTOMER_CREATED_DATE,
              CUSTOMER_CREDIT_SCORE,
              CUSTOMER_CS_REVIEW_DATE
         INTO :HV_CUSTOMER_EYECATCHER,
              :HV_CUSTOMER_SORTCODE,
              :HV_CUSTOMER_NUMBER,
              :HV_CUSTOMER_TITLE,
              :HV_CUSTOMER_FIRST_NAME,
              :HV_CUSTOMER_LAST_NAME,
              :HV_CUSTOMER_DOB,
              :HV_CUSTOMER_PHONE,
              :HV_CUSTOMER_ADDR_LINE1,
              :HV_CUSTOMER_ADDR_LINE2,
              :HV_CUSTOMER_CITY,
              :HV_CUSTOMER_POSTCODE,
              :HV_CUSTOMER_COUNTRY,
              :HV_CUSTOMER_STATUS,
              :HV_CUSTOMER_CREATE_DATE,
              :HV_CUSTOMER_CREDIT_SCORE,
              :HV_CUSTOMER_CS_REVIEW_DATE
         FROM CUSTOMER
        WHERE CUSTOMER_SORTCODE = :HV_CUSTOMER_SORTCODE
        ORDER BY CUSTOMER_NUMBER DESC
        FETCH FIRST 1 ROW ONLY;

     IF SQLCODE = 0 THEN DO;
       DFHCOMMAREA.INQCUST_INQ_SUCCESS  = 'Y';
       REQUIRED_CUST_NUMBER2 = HV_CUSTOMER_NUMBER;
       RETURN;
     END;
     IF SQLCODE = 100 THEN DO;
       DFHCOMMAREA.INQCUST_INQ_SUCCESS  = 'N';
       DFHCOMMAREA.INQCUST_INQ_FAIL_CD  = '9';
       RETURN;
     END;
     DFHCOMMAREA.INQCUST_INQ_SUCCESS = 'N';
     DFHCOMMAREA.INQCUST_INQ_FAIL_CD = '9';
   END GET_LAST_CUSTOMER_DB2;

   /********** POPULATE_TIME_DATE ************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
          ABSTIME(WS_U_TIME)
          DDMMYYYY(WS_ORIG_DATE)
          TIME(WS_TIME_NOW)
          DATESEP;
   END POPULATE_TIME_DATE;

   /********** GENERATE_RANDOM_CUSTOMER *****************************/
   GENERATE_RANDOM_CUSTOMER: PROC;
     INQCUST_RETRY = 0;
     RANDOM_CUSTOMER =
       CHAR(MOD(ABS(EIBTASKN),NCS_CUST_NO_VALUE)+1, 10);
   END GENERATE_RANDOM_CUSTOMER;

   /********** GENERATE_RANDOM_CUSTOMER_AGAIN ***********************/
   GENERATE_RANDOM_CUSTOMER_AGAIN: PROC;
     INQCUST_RETRY = INQCUST_RETRY + 1;
     RANDOM_CUSTOMER =
       CHAR(MOD(ABS(INQCUST_RETRY),NCS_CUST_NO_VALUE)+1, 10);
   END GENERATE_RANDOM_CUSTOMER_AGAIN;

 END INQCUST;
