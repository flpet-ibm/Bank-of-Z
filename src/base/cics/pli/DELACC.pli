 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* DELACC - Delete Account                                        */
 /* Reads account record from DB2, deletes it, writes PROCTRAN.   */
 /***************************************************************** */
*PROCESS SYSTEM(CICS) SQL MARGINS(1,72);
 DELACC: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA (from DELACC.cpy)                                 */
   /*****************************************************************/
   %INCLUDE DELACC;
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR) LIKE DELACC_TMPL;

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* ACCOUNT DB2 table declaration                                 */
   /*****************************************************************/
   EXEC SQL INCLUDE ACCDB2;

   /*****************************************************************/
   /* PROCTRAN DB2 table declaration                                */
   /*****************************************************************/
   EXEC SQL INCLUDE PROCDB2;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* ACCOUNT host variables                                        */
   /*****************************************************************/
   DCL 1 HOST_ACCOUNT_ROW,
     3 HV_ACCOUNT_EYECATCHER    CHAR(4),
     3 HV_ACCOUNT_CUST_NO       CHAR(10),
     3 HV_ACCOUNT_SORTCODE      CHAR(6),
     3 HV_ACCOUNT_ACC_NO        CHAR(8),
     3 HV_ACCOUNT_ACC_TYPE      CHAR(8),
     3 HV_ACCOUNT_INT_RATE      FIXED DEC(6,2),
     3 HV_ACCOUNT_OPENED        CHAR(10),
     3 HV_ACCOUNT_OVERDRAFT_LIM FIXED BIN(31),
     3 HV_ACCOUNT_LAST_STMT     CHAR(10),
     3 HV_ACCOUNT_NEXT_STMT     CHAR(10),
     3 HV_ACCOUNT_AVAIL_BAL     FIXED DEC(12,2),
     3 HV_ACCOUNT_ACTUAL_BAL    FIXED DEC(12,2);

   /*****************************************************************/
   /* PROCTRAN host variables                                       */
   /*****************************************************************/
   DCL 1 HOST_PROCTRAN_ROW,
     3 HV_PROCTRAN_EYECATCHER    CHAR(4),
     3 HV_PROCTRAN_SORT_CODE     CHAR(6),
     3 HV_PROCTRAN_ACC_NUMBER    CHAR(8),
     3 HV_PROCTRAN_DATE          CHAR(10),
     3 HV_PROCTRAN_TIME          CHAR(6),
     3 HV_PROCTRAN_REF           CHAR(12),
     3 HV_PROCTRAN_TYPE          CHAR(3),
     3 HV_PROCTRAN_DESC          CHAR(40),
     3 HV_PROCTRAN_AMOUNT        FIXED DEC(12,2);

   /*****************************************************************/
   /* OUTPUT_DATA - ACCOUNT record                                  */
   /*****************************************************************/
   %INCLUDE ACCOUNT;
   DCL 1 OUTPUT_DATA LIKE ACCOUNT_TMPL;

   /*****************************************************************/
   /* PROCTRAN working area                                         */
   /*****************************************************************/
   %INCLUDE PROCTRAN;
   DCL 1 PROCTRAN_AREA LIKE PROCTRAN_TMPL;

   /*****************************************************************/
   /* ABNDINFO record                                               */
   /*****************************************************************/
   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* DB2 date reformatter                                          */
   /*****************************************************************/
   DCL 1 DB2_DATE_REFORMAT,
     3 DB2_DATE_REF_YR    CHAR(4),
     3 DB2_DATE_SEP1      CHAR(1),
     3 DB2_DATE_REF_MNTH  CHAR(2),
     3 DB2_DATE_SEP2      CHAR(1),
     3 DB2_DATE_REF_DAY   CHAR(2);

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP      FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2     FIXED BIN(31) INIT(0);
   DCL WS_U_TIME         FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE      CHAR(10)      INIT(' ');
   DCL 1 WS_ORIG_DATE_GRP BASED(ADDR(WS_ORIG_DATE)),
         3 WS_ORIG_DATE_DD   CHAR(2),
         3 FILLER_OD1        CHAR(1),
         3 WS_ORIG_DATE_MM   CHAR(2),
         3 FILLER_OD2        CHAR(1),
         3 WS_ORIG_DATE_YYYY CHAR(4);
   DCL 1 WS_ORIG_DATE_GRP_X,
     3 WS_ORIG_DATE_DD_X   CHAR(2) INIT(' '),
     3 FILLER_ODGX1        CHAR(1) INIT('.'),
     3 WS_ORIG_DATE_MM_X   CHAR(2) INIT(' '),
     3 FILLER_ODGX2        CHAR(1) INIT('.'),
     3 WS_ORIG_DATE_YYYY_X CHAR(4) INIT(' ');
   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW       CHAR(6)   INIT(' '),
     3 * UNION,
       5 WS_TIME_NOW_STR CHAR(6),
       5 WS_TIME_NOW_GRP,
         7 WS_TIME_NOW_GRP_HH CHAR(2),
         7 WS_TIME_NOW_GRP_MM CHAR(2),
         7 WS_TIME_NOW_GRP_SS CHAR(2);
   DCL WS_ABEND_PGM      CHAR(8)   INIT('ABNDPROC');
   DCL SQLCODE_DISPLAY   CHAR(9)   INIT(' ');
   DCL WS_EIBTASKN12     CHAR(12)  INIT(' ');
   DCL ACCOUNT_ACT_BAL_STORE FIXED DEC(12,2) INIT(0);
   DCL 1 ACCOUNT_KEY_RID,
     3 REQUIRED_SORT_CODE  CHAR(6) INIT('000000'),
     3 REQUIRED_ACC_NUM    CHAR(8) INIT('00000000');

   /******** PREMIERE - main logic ***********************************/
   REQUIRED_SORT_CODE = SORTCODE;
   CALL READ_ACCOUNT_DB2;

   IF DFHCOMMAREA.DELACC_DEL_SUCCESS = 'Y' THEN DO;
     CALL DEL_ACCOUNT_DB2;
     IF DFHCOMMAREA.DELACC_DEL_SUCCESS = 'Y' THEN
       CALL WRITE_PROCTRAN;
   END;
   CALL GET_ME_OUT_OF_HERE;

   /********** READ_ACCOUNT_DB2 **************************************/
   READ_ACCOUNT_DB2: PROC;
     HV_ACCOUNT_ACC_NO   = DFHCOMMAREA.DELACC_ACCNO;
     HV_ACCOUNT_SORTCODE = SORTCODE;

     EXEC SQL
       SELECT ACCOUNT_EYECATCHER,
              ACCOUNT_CUSTOMER_NUMBER,
              ACCOUNT_SORTCODE,
              ACCOUNT_NUMBER,
              ACCOUNT_TYPE,
              ACCOUNT_INTEREST_RATE,
              ACCOUNT_OPENED,
              ACCOUNT_OVERDRAFT_LIMIT,
              ACCOUNT_LAST_STATEMENT,
              ACCOUNT_NEXT_STATEMENT,
              ACCOUNT_AVAILABLE_BALANCE,
              ACCOUNT_ACTUAL_BALANCE
       INTO  :HV_ACCOUNT_EYECATCHER,
             :HV_ACCOUNT_CUST_NO,
             :HV_ACCOUNT_SORTCODE,
             :HV_ACCOUNT_ACC_NO,
             :HV_ACCOUNT_ACC_TYPE,
             :HV_ACCOUNT_INT_RATE,
             :HV_ACCOUNT_OPENED,
             :HV_ACCOUNT_OVERDRAFT_LIM,
             :HV_ACCOUNT_LAST_STMT,
             :HV_ACCOUNT_NEXT_STMT,
             :HV_ACCOUNT_AVAIL_BAL,
             :HV_ACCOUNT_ACTUAL_BAL
       FROM ACCOUNT
       WHERE ACCOUNT_NUMBER   = :HV_ACCOUNT_ACC_NO
         AND ACCOUNT_SORTCODE = :HV_ACCOUNT_SORTCODE;

     IF SQLCODE ^= 0 & SQLCODE ^= 100 THEN DO;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = '0';
       ABNDINFO_REC.ABND_RESP2CODE = '0';
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'HRAC';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE = SQLCODE_DISPLAY;
       ABNDINFO_REC.ABND_FREEFORM = 'RAD010 - ACCOUNT SELECT failed' ||
                       ' SQLCODE=' || SQLCODE_DISPLAY;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       EXEC CICS ABEND ABCODE('HRAC') NODUMP;
       RETURN;
     END;

     IF SQLCODE = 100 THEN DO;
       OUTPUT_DATA = '';
       OUTPUT_DATA.ACCOUNT_SORT_CODE = SORTCODE;
       OUTPUT_DATA.ACCOUNT_NUMBER    = DFHCOMMAREA.DELACC_ACCNO;
       DFHCOMMAREA.DELACC_DEL_SUCCESS = 'N';
       DFHCOMMAREA.DELACC_DEL_FAIL_CD = '1';
       RETURN;
     END;

     /* SQLCODE = 0: account found */
     DFHCOMMAREA.DELACC_SUCCESS     = ' ';
     DFHCOMMAREA.DELACC_DEL_SUCCESS = 'Y';
     DFHCOMMAREA.DELACC_DEL_FAIL_CD = ' ';

     OUTPUT_DATA.ACCOUNT_EYE_CATCHER    = HV_ACCOUNT_EYECATCHER;
     OUTPUT_DATA.ACCOUNT_CUST_NO        = HV_ACCOUNT_CUST_NO;
     OUTPUT_DATA.ACCOUNT_SORT_CODE      = HV_ACCOUNT_SORTCODE;
     OUTPUT_DATA.ACCOUNT_NUMBER         = HV_ACCOUNT_ACC_NO;
     OUTPUT_DATA.ACCOUNT_TYPE           = HV_ACCOUNT_ACC_TYPE;
     OUTPUT_DATA.ACCOUNT_INTEREST_RATE  = HV_ACCOUNT_INT_RATE;
     DB2_DATE_REFORMAT      = HV_ACCOUNT_OPENED;
     OUTPUT_DATA.ACCOUNT_OPENED_DAY     = DB2_DATE_REF_DAY;
     OUTPUT_DATA.ACCOUNT_OPENED_MONTH   = DB2_DATE_REF_MNTH;
     OUTPUT_DATA.ACCOUNT_OPENED_YEAR    = DB2_DATE_REF_YR;
     OUTPUT_DATA.ACCOUNT_OVERDRAFT_LIMIT =
         CHAR(HV_ACCOUNT_OVERDRAFT_LIM,8);
     DB2_DATE_REFORMAT      = HV_ACCOUNT_LAST_STMT;
     OUTPUT_DATA.ACCOUNT_LAST_STMT_DAY  = DB2_DATE_REF_DAY;
     OUTPUT_DATA.ACCOUNT_LAST_STMT_MONTH = DB2_DATE_REF_MNTH;
     OUTPUT_DATA.ACCOUNT_LAST_STMT_YEAR = DB2_DATE_REF_YR;
     DB2_DATE_REFORMAT      = HV_ACCOUNT_NEXT_STMT;
     OUTPUT_DATA.ACCOUNT_NEXT_STMT_DAY  = DB2_DATE_REF_DAY;
     OUTPUT_DATA.ACCOUNT_NEXT_STMT_MONTH = DB2_DATE_REF_MNTH;
     OUTPUT_DATA.ACCOUNT_NEXT_STMT_YEAR = DB2_DATE_REF_YR;
     OUTPUT_DATA.ACCOUNT_AVAILABLE_BALANCE = HV_ACCOUNT_AVAIL_BAL;
     OUTPUT_DATA.ACCOUNT_ACTUAL_BALANCE    = HV_ACCOUNT_ACTUAL_BAL;
     ACCOUNT_ACT_BAL_STORE     = HV_ACCOUNT_ACTUAL_BAL;

     DFHCOMMAREA.DELACC_EYE          = OUTPUT_DATA.ACCOUNT_EYE_CATCHER;
     DFHCOMMAREA.DELACC_CUSTNO       = OUTPUT_DATA.ACCOUNT_CUST_NO;
     DFHCOMMAREA.DELACC_SCODE        = OUTPUT_DATA.ACCOUNT_SORT_CODE;
     DFHCOMMAREA.DELACC_ACCNO        = OUTPUT_DATA.ACCOUNT_NUMBER;
     DFHCOMMAREA.DELACC_ACC_TYPE     = OUTPUT_DATA.ACCOUNT_TYPE;
     DFHCOMMAREA.DELACC_INT_RATE = OUTPUT_DATA.ACCOUNT_INTEREST_RATE;
     DFHCOMMAREA.DELACC_OPENED       = OUTPUT_DATA.ACCOUNT_OPENED;
     DFHCOMMAREA.DELACC_OVERDRAFT = OUTPUT_DATA.ACCOUNT_OVERDRAFT_LIMIT;
     DFHCOMMAREA.DELACC_LAST_STMT_DT =
         OUTPUT_DATA.ACCOUNT_LAST_STMT_DATE;
     DFHCOMMAREA.DELACC_NEXT_STMT_DT =
         OUTPUT_DATA.ACCOUNT_NEXT_STMT_DATE;
     DFHCOMMAREA.DELACC_AVAIL_BAL =
         OUTPUT_DATA.ACCOUNT_AVAILABLE_BALANCE;
     DFHCOMMAREA.DELACC_ACTUAL_BAL = OUTPUT_DATA.ACCOUNT_ACTUAL_BALANCE;
     ACCOUNT_ACT_BAL_STORE = OUTPUT_DATA.ACCOUNT_ACTUAL_BALANCE;
   END READ_ACCOUNT_DB2;

   /********** DEL_ACCOUNT_DB2 ***************************************/
   DEL_ACCOUNT_DB2: PROC;
     EXEC SQL
       DELETE FROM ACCOUNT
       WHERE ACCOUNT_SORTCODE = :HV_ACCOUNT_SORTCODE
         AND ACCOUNT_NUMBER   = :HV_ACCOUNT_ACC_NO;

     IF SQLCODE ^= 0 THEN DO;
       DFHCOMMAREA.DELACC_SUCCESS     = ' ';
       DFHCOMMAREA.DELACC_DEL_SUCCESS = 'N';
       DFHCOMMAREA.DELACC_DEL_FAIL_CD = '3';
     END;
   END DEL_ACCOUNT_DB2;

   /********** WRITE_PROCTRAN ****************************************/
   WRITE_PROCTRAN: PROC;
     CALL WRITE_PROCTRAN_DB2;
   END WRITE_PROCTRAN;

   /********** WRITE_PROCTRAN_DB2 ************************************/
   WRITE_PROCTRAN_DB2: PROC;
     HOST_PROCTRAN_ROW = '';
     WS_EIBTASKN12     = ' ';

     HV_PROCTRAN_EYECATCHER = 'PRTR';
     HV_PROCTRAN_SORT_CODE  = OUTPUT_DATA.ACCOUNT_SORT_CODE;
     HV_PROCTRAN_ACC_NUMBER = OUTPUT_DATA.ACCOUNT_NUMBER;
     WS_EIBTASKN12          = CHAR(EIBTASKN,12);
     HV_PROCTRAN_REF        = WS_EIBTASKN12;

     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
          ABSTIME(WS_U_TIME)
          DDMMYYYY(WS_ORIG_DATE)
          TIME(HV_PROCTRAN_TIME)
          DATESEP('.');

     WS_ORIG_DATE_DD_X   = WS_ORIG_DATE_DD;
     WS_ORIG_DATE_MM_X   = WS_ORIG_DATE_MM;
     WS_ORIG_DATE_YYYY_X = WS_ORIG_DATE_YYYY;
     HV_PROCTRAN_DATE =
       WS_ORIG_DATE_DD_X ||
       FILLER_ODGX1 ||
       WS_ORIG_DATE_MM_X ||
       FILLER_ODGX2 ||
       WS_ORIG_DATE_YYYY_X;

     /* Populate PROCTRAN description from PROCTRAN_AREA fields */
     PROCTRAN_AREA.PROC_DESC_DELACC_CUSTOMER =
         OUTPUT_DATA.ACCOUNT_CUST_NO;
     PROCTRAN_AREA.PROC_DESC_DELACC_ACCTYPE  = OUTPUT_DATA.ACCOUNT_TYPE;
     PROCTRAN_AREA.PROC_DESC_DELACC_LAST_DD =
         OUTPUT_DATA.ACCOUNT_LAST_STMT_DAY;
     PROCTRAN_AREA.PROC_DESC_DELACC_LAST_MM =
         OUTPUT_DATA.ACCOUNT_LAST_STMT_MONTH;
     PROCTRAN_AREA.PROC_DESC_DELACC_LAST_YYYY =
         OUTPUT_DATA.ACCOUNT_LAST_STMT_YEAR;
     PROCTRAN_AREA.PROC_DESC_DELACC_NEXT_DD =
         OUTPUT_DATA.ACCOUNT_NEXT_STMT_DAY;
     PROCTRAN_AREA.PROC_DESC_DELACC_NEXT_MM =
         OUTPUT_DATA.ACCOUNT_NEXT_STMT_MONTH;
     PROCTRAN_AREA.PROC_DESC_DELACC_NEXT_YYYY =
         OUTPUT_DATA.ACCOUNT_NEXT_STMT_YEAR;
     PROCTRAN_AREA.PROC_DESC_DELACC_FOOTER   = 'DELETE';
     PROCTRAN_AREA.PROC_TRAN_TYPE            = 'ODA';
     HV_PROCTRAN_DESC          = PROCTRAN_AREA.PROC_TRAN_DESC;
     HV_PROCTRAN_TYPE          = PROCTRAN_AREA.PROC_TRAN_TYPE;
     HV_PROCTRAN_AMOUNT        = ACCOUNT_ACT_BAL_STORE;

     EXEC SQL
       INSERT INTO PROCTRAN
              (PROCTRAN_EYECATCHER,
               PROCTRAN_SORTCODE,
               PROCTRAN_NUMBER,
               PROCTRAN_DATE,
               PROCTRAN_TIME,
               PROCTRAN_REF,
               PROCTRAN_TYPE,
               PROCTRAN_DESC,
               PROCTRAN_AMOUNT)
       VALUES
              (:HV_PROCTRAN_EYECATCHER,
               :HV_PROCTRAN_SORT_CODE,
               :HV_PROCTRAN_ACC_NUMBER,
               :HV_PROCTRAN_DATE,
               :HV_PROCTRAN_TIME,
               :HV_PROCTRAN_REF,
               :HV_PROCTRAN_TYPE,
               :HV_PROCTRAN_DESC,
               :HV_PROCTRAN_AMOUNT);

     IF SQLCODE ^= 0 THEN DO;
       SQLCODE_DISPLAY = CHAR(SQLCODE,9);
       ABNDINFO_REC = '';
       ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP,9);
       ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2,9);
       EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
       ABNDINFO_REC.ABND_TASKNO_KEY = CHAR(EIBTASKN,4);
       ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
       ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                   WS_TIME_NOW_GRP_MM || ':' ||
                   WS_TIME_NOW_GRP_SS;
       ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
       ABNDINFO_REC.ABND_CODE = 'HWPT';
       EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
       ABNDINFO_REC.ABND_SQLCODE   = SQLCODE_DISPLAY;
       ABNDINFO_REC.ABND_FREEFORM = 'WPD010 - PROCTRAN INSERT failed' ||
                        ' SQLCODE=' || SQLCODE_DISPLAY;
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
            COMMAREA(ABNDINFO_REC);
       EXEC CICS ABEND ABCODE('HWPT');
     END;
   END WRITE_PROCTRAN_DB2;

   /********** GET_ME_OUT_OF_HERE ************************************/
   GET_ME_OUT_OF_HERE: PROC;
     EXEC CICS RETURN;
   END GET_ME_OUT_OF_HERE;

   /********** POPULATE_TIME_DATE ************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
          ABSTIME(WS_U_TIME)
          DDMMYYYY(WS_ORIG_DATE)
          TIME(WS_TIME_NOW)
          DATESEP;
   END POPULATE_TIME_DATE;

 END DELACC;
