 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2026                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* INQTRANL - Inquire Transaction List                            */
 /* Retrieves a paginated list of PROCTRAN rows for an account.   */
 /* Supports optional FROM/TO date filtering (YYYYMMDD format).   */
 /* Pagination via OFFSET skip in the fetch loop.                 */
 /***************************************************************** */
*PROCESS SYSTEM(CICS) SQL MARGINS(1,72);
 INQTRANL: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA (from INQTRANL.cpy)                               */
   /*****************************************************************/
   %INCLUDE INQTRANL;
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR) LIKE INQTRANL_TMPL;

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* PROCTRAN DB2 table declaration                                */
   /*****************************************************************/
   EXEC SQL INCLUDE PROCDB2;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* PROCTRAN host variables (data cursor)                         */
   /*****************************************************************/
   DCL 1 HOST_PROCTRAN_ROW,
     3 HV_PROCTRAN_EYECATCHER    CHAR(4),
     3 HV_PROCTRAN_SORTCODE      CHAR(6),
     3 HV_PROCTRAN_NUMBER        CHAR(8),
     3 HV_PROCTRAN_DATE          CHAR(10),
     3 HV_PROCTRAN_TIME          CHAR(6),
     3 HV_PROCTRAN_REF           CHAR(12),
     3 HV_PROCTRAN_TYPE          CHAR(3),
     3 HV_PROCTRAN_DESC          CHAR(40),
     3 HV_PROCTRAN_AMOUNT        FIXED DEC(12,2);

   /*****************************************************************/
   /* Query parameter host variables                                */
   /*****************************************************************/
   DCL HV_QUERY_SORTCODE   CHAR(6)  INIT(' ');
   DCL HV_QUERY_ACCNO      CHAR(8)  INIT(' ');
   DCL HV_QUERY_FROM_DATE  CHAR(10) INIT(' ');
   DCL HV_QUERY_TO_DATE    CHAR(10) INIT(' ');
   DCL HV_QUERY_LIMIT      FIXED BIN(15) INIT(0);
   DCL HV_QUERY_OFFSET     FIXED BIN(31) INIT(0);

   /*****************************************************************/
   /* ABNDINFO record                                               */
   /*****************************************************************/
   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* TRAN_COUNT_CURSOR - count all qualifying rows                 */
   /*****************************************************************/
   EXEC SQL DECLARE TRAN_COUNT_CURSOR CURSOR FOR
      SELECT COUNT(*)
        FROM PROCTRAN
       WHERE PROCTRAN_SORTCODE = :HV_QUERY_SORTCODE
         AND PROCTRAN_NUMBER   = :HV_QUERY_ACCNO
         AND PROCTRAN_DATE    >= :HV_QUERY_FROM_DATE
         AND PROCTRAN_DATE    <= :HV_QUERY_TO_DATE;

   /*****************************************************************/
   /* TRAN_CURSOR - fetch ordered rows for pagination               */
   /*****************************************************************/
   EXEC SQL DECLARE TRAN_CURSOR CURSOR FOR
      SELECT PROCTRAN_EYECATCHER,
             PROCTRAN_SORTCODE,
             PROCTRAN_NUMBER,
             PROCTRAN_DATE,
             PROCTRAN_TIME,
             PROCTRAN_REF,
             PROCTRAN_TYPE,
             PROCTRAN_DESC,
             PROCTRAN_AMOUNT
        FROM PROCTRAN
       WHERE PROCTRAN_SORTCODE = :HV_QUERY_SORTCODE
         AND PROCTRAN_NUMBER   = :HV_QUERY_ACCNO
         AND PROCTRAN_DATE    >= :HV_QUERY_FROM_DATE
         AND PROCTRAN_DATE    <= :HV_QUERY_TO_DATE
       ORDER BY PROCTRAN_DATE DESC,
                PROCTRAN_TIME DESC
       FOR FETCH ONLY;

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP      FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2     FIXED BIN(31) INIT(0);
   DCL WS_ABEND_PGM      CHAR(8)       INIT('ABNDPROC');
   DCL WS_U_TIME         FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE      CHAR(10)      INIT(' ');

   DCL 1 WS_ORIG_DATE_GRP DEF(WS_ORIG_DATE),
     3 WS_ORIG_DATE_DD    CHAR(2),
     3 WS_ORIG_DATE_SEP1  CHAR(1),
     3 WS_ORIG_DATE_MM    CHAR(2),
     3 WS_ORIG_DATE_SEP2  CHAR(1),
     3 WS_ORIG_DATE_YYYY  CHAR(4);

   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW        CHAR(6)  INIT(' '),
     3 * UNION,
       5 WS_TIME_NOW_CHAR CHAR(6),
       5 WS_TIME_NOW_GRP,
         7 WS_TIME_NOW_GRP_HH CHAR(2),
         7 WS_TIME_NOW_GRP_MM CHAR(2),
         7 WS_TIME_NOW_GRP_SS CHAR(2);

   /* Counters */
   DCL WS_TRANSACTION_COUNT FIXED BIN(31) INIT(0);
   DCL WS_FETCH_COUNT       FIXED BIN(31) INIT(0);
   DCL WS_TOTAL_COUNT       FIXED BIN(31) INIT(0);
   DCL WS_SKIP_COUNT        FIXED BIN(31) INIT(0);
   DCL WS_ROW_COUNT         FIXED BIN(31) INIT(0);

   /* Numeric working copies of CHAR commarea limit/offset */
   DCL WS_LIMIT_NUM  FIXED BIN(31) INIT(0);
   DCL WS_OFFSET_NUM FIXED BIN(31) INIT(0);

   /* Working storage for building composite transaction ID */
   DCL WS_TRAN_ID_SC     CHAR(6)  INIT(' ');
   DCL WS_TRAN_ID_NUM    CHAR(8)  INIT(' ');
   DCL WS_TRAN_ID_DATE   CHAR(8)  INIT(' ');
   DCL WS_TRAN_ID_TIME   CHAR(6)  INIT(' ');
   DCL WS_TRAN_ID_REF    CHAR(12) INIT(' ');

   /* Date conversion working storage */
   DCL 1 WS_DATE_WORK,
     3 * UNION,
       5 WS_DATE_YYYYMMDD  CHAR(8),
       5 WS_DATE_YYYYMMDD_GRP,
         7 WS_DATE_YYYY    CHAR(4),
         7 WS_DATE_MM      CHAR(2),
         7 WS_DATE_DD      CHAR(2),
     3 * UNION,
       5 WS_DATE_ISO        CHAR(10),
       5 WS_DATE_ISO_GRP,
         7 WS_DATE_ISO_YYYY CHAR(4),
         7 WS_DATE_ISO_SEP1 CHAR(1),
         7 WS_DATE_ISO_MM   CHAR(2),
         7 WS_DATE_ISO_SEP2 CHAR(1),
         7 WS_DATE_ISO_DD   CHAR(2);

   /*****************************************************************/
   /* MAIN PROCEDURE                                                */
   /*****************************************************************/

   /* Initialise counters */
   WS_TRANSACTION_COUNT = 0;
   WS_FETCH_COUNT       = 0;
   WS_TOTAL_COUNT       = 0;

   /* Set up abend handler */
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING);

   /* Validate eyecatcher */
   IF DFHCOMMAREA.INQTRANL_EYE ^= 'ITRL' THEN
     DFHCOMMAREA.INQTRANL_EYE = 'ITRL';

   /* Convert CHAR commarea fields to numeric for comparisons */
   WS_LIMIT_NUM  = DFHCOMMAREA.INQTRANL_LIMIT;
   WS_OFFSET_NUM = DFHCOMMAREA.INQTRANL_OFFSET;

   /* Set defaults if not provided */
   IF DFHCOMMAREA.INQTRANL_FROM_DATE = '00000000' |
      DFHCOMMAREA.INQTRANL_FROM_DATE = '        ' THEN
     DFHCOMMAREA.INQTRANL_FROM_DATE = '00000000';

   IF DFHCOMMAREA.INQTRANL_TO_DATE = '00000000' |
      DFHCOMMAREA.INQTRANL_TO_DATE = '        ' THEN
     DFHCOMMAREA.INQTRANL_TO_DATE = '99999999';

   IF WS_LIMIT_NUM = 0 THEN
     WS_LIMIT_NUM = 50;

   /* Cap limit at 100 */
   IF WS_LIMIT_NUM > 100 THEN
     WS_LIMIT_NUM = 100;

   /* Get total count first */
   CALL GET_TOTAL_COUNT;

   /* Fetch transaction list with offset pagination */
   CALL READ_TRANSACTIONS_DB2;

   /* Populate output commarea */
   DFHCOMMAREA.INQTRANL_TOTAL_COUNT    = WS_TOTAL_COUNT;
   DFHCOMMAREA.INQTRANL_RETURNED_COUNT = WS_FETCH_COUNT;
   DFHCOMMAREA.INQTRANL_SUCCESS        = 'Y';

   CALL GET_ME_OUT_OF_HERE;

   /*****************************************************************/
   /* GET_TOTAL_COUNT - Count qualifying rows via count cursor      */
   /*****************************************************************/
   GET_TOTAL_COUNT: PROC;

     /* Set query host variables */
     HV_QUERY_SORTCODE = DFHCOMMAREA.INQTRANL_SORTCODE;
     HV_QUERY_ACCNO    = DFHCOMMAREA.INQTRANL_ACCNO;

     /* Convert FROM-DATE YYYYMMDD to YYYY-MM-DD */
     WS_DATE_YYYYMMDD  = DFHCOMMAREA.INQTRANL_FROM_DATE;
     CALL CONVERT_YYYYMMDD_TO_ISO;
     HV_QUERY_FROM_DATE = WS_DATE_ISO;

     /* Convert TO-DATE YYYYMMDD to YYYY-MM-DD */
     WS_DATE_YYYYMMDD  = DFHCOMMAREA.INQTRANL_TO_DATE;
     CALL CONVERT_YYYYMMDD_TO_ISO;
     HV_QUERY_TO_DATE  = WS_DATE_ISO;

     EXEC SQL OPEN TRAN_COUNT_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

     EXEC SQL FETCH TRAN_COUNT_CURSOR
       INTO :WS_TOTAL_COUNT;

     IF SQLCODE ^= 0 & SQLCODE ^= 100 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

     EXEC SQL CLOSE TRAN_COUNT_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

   END GET_TOTAL_COUNT;

   /*****************************************************************/
   /* READ_TRANSACTIONS_DB2 - Open cursor and fetch rows           */
   /*****************************************************************/
   READ_TRANSACTIONS_DB2: PROC;

     /* Set query host variables (dates already converted above) */
     HV_QUERY_SORTCODE = DFHCOMMAREA.INQTRANL_SORTCODE;
     HV_QUERY_ACCNO    = DFHCOMMAREA.INQTRANL_ACCNO;

     /* Re-convert dates (may have been reset) */
     WS_DATE_YYYYMMDD  = DFHCOMMAREA.INQTRANL_FROM_DATE;
     CALL CONVERT_YYYYMMDD_TO_ISO;
     HV_QUERY_FROM_DATE = WS_DATE_ISO;

     WS_DATE_YYYYMMDD  = DFHCOMMAREA.INQTRANL_TO_DATE;
     CALL CONVERT_YYYYMMDD_TO_ISO;
     HV_QUERY_TO_DATE  = WS_DATE_ISO;

     EXEC SQL OPEN TRAN_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

     /* Fetch rows with offset-skip pagination */
     CALL FETCH_TRANSACTION_DATA;

     EXEC SQL CLOSE TRAN_CURSOR;

     IF SQLCODE ^= 0 THEN DO;
       ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
       CALL ABEND_ROUTINE;
     END;

   END READ_TRANSACTIONS_DB2;

   /*****************************************************************/
   /* FETCH_TRANSACTION_DATA - Fetch loop with offset pagination   */
   /*****************************************************************/
   FETCH_TRANSACTION_DATA: PROC;

     WS_FETCH_COUNT = 0;
     WS_SKIP_COUNT  = 0;
     WS_ROW_COUNT   = 0;

     DO WHILE (SQLCODE ^= 100 & WS_FETCH_COUNT < WS_LIMIT_NUM);

       EXEC SQL FETCH TRAN_CURSOR
         INTO :HV_PROCTRAN_EYECATCHER,
              :HV_PROCTRAN_SORTCODE,
              :HV_PROCTRAN_NUMBER,
              :HV_PROCTRAN_DATE,
              :HV_PROCTRAN_TIME,
              :HV_PROCTRAN_REF,
              :HV_PROCTRAN_TYPE,
              :HV_PROCTRAN_DESC,
              :HV_PROCTRAN_AMOUNT;

       IF SQLCODE = 0 THEN DO;
         WS_ROW_COUNT = WS_ROW_COUNT + 1;

         IF WS_SKIP_COUNT < WS_OFFSET_NUM THEN
           /* Skip this row - still in offset range */
           WS_SKIP_COUNT = WS_SKIP_COUNT + 1;
         ELSE DO;
           /* Process this row */
           WS_FETCH_COUNT = WS_FETCH_COUNT + 1;

           /* Convert YYYY-MM-DD back to YYYYMMDD */
           WS_DATE_ISO = HV_PROCTRAN_DATE;
           CALL CONVERT_ISO_TO_YYYYMMDD;

           /* Build composite transaction ID */
           WS_TRAN_ID_SC   = HV_PROCTRAN_SORTCODE;
           WS_TRAN_ID_NUM  = HV_PROCTRAN_NUMBER;
           WS_TRAN_ID_DATE = WS_DATE_YYYYMMDD;
           WS_TRAN_ID_TIME = HV_PROCTRAN_TIME;
           WS_TRAN_ID_REF  = HV_PROCTRAN_REF;

           DFHCOMMAREA.INQTRANL_TRAN_ID(WS_FETCH_COUNT) =
             WS_TRAN_ID_SC   || '-' ||
             WS_TRAN_ID_NUM  || '-' ||
             WS_TRAN_ID_DATE || '-' ||
             WS_TRAN_ID_TIME || '-' ||
             WS_TRAN_ID_REF;
           DFHCOMMAREA.INQTRANL_TRAN_SORTCODE(WS_FETCH_COUNT) =
             HV_PROCTRAN_SORTCODE;
           DFHCOMMAREA.INQTRANL_TRAN_ACCNO(WS_FETCH_COUNT)    =
             HV_PROCTRAN_NUMBER;
           DFHCOMMAREA.INQTRANL_TRAN_DATE(WS_FETCH_COUNT)     =
             WS_DATE_YYYYMMDD;
           DFHCOMMAREA.INQTRANL_TRAN_TIME(WS_FETCH_COUNT)     =
             HV_PROCTRAN_TIME;
           DFHCOMMAREA.INQTRANL_TRAN_REF(WS_FETCH_COUNT)      =
             HV_PROCTRAN_REF;
           DFHCOMMAREA.INQTRANL_TRAN_TYPE(WS_FETCH_COUNT)     =
             HV_PROCTRAN_TYPE;
           DFHCOMMAREA.INQTRANL_TRAN_DESC(WS_FETCH_COUNT)     =
             HV_PROCTRAN_DESC;
           DFHCOMMAREA.INQTRANL_TRAN_AMOUNT(WS_FETCH_COUNT)   =
             HV_PROCTRAN_AMOUNT;
         END;
       END;
       ELSE IF SQLCODE ^= 100 THEN DO;
         ABNDINFO_REC.ABND_SQLCODE = CHAR(SQLCODE);
         CALL ABEND_ROUTINE;
       END;

     END; /* DO WHILE */

   END FETCH_TRANSACTION_DATA;

   /*****************************************************************/
   /* GET_ME_OUT_OF_HERE - CICS RETURN                              */
   /*****************************************************************/
   GET_ME_OUT_OF_HERE: PROC;
     EXEC CICS RETURN;
   END GET_ME_OUT_OF_HERE;

   /*****************************************************************/
   /* ABEND_ROUTINE - Log SQL error and abend                       */
   /*****************************************************************/
   ABEND_ROUTINE: PROC;

     ABNDINFO_REC = '';
     ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP);
     ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2);

     EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);

     ABNDINFO_REC.ABND_TASKNO_KEY = EIBTASKN;
     ABNDINFO_REC.ABND_TRANID     = EIBTRNID;

     CALL POPULATE_TIME_DATE;

     ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
     ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                 WS_TIME_NOW_GRP_MM || ':' ||
                 WS_TIME_NOW_GRP_SS;
     ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
     ABNDINFO_REC.ABND_CODE      = 'ITRL';

     EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);

     ABNDINFO_REC.ABND_FREEFORM = 'INQTRANL - DB2 Error. SQLCODE=' ||
                     ABNDINFO_REC.ABND_SQLCODE;

     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);

     EXEC CICS ABEND ABCODE('ITRL')
               CANCEL
               NODUMP;

   END ABEND_ROUTINE;

   /*****************************************************************/
   /* ABEND_HANDLING - Handle unexpected CICS abends               */
   /*****************************************************************/
   ABEND_HANDLING: PROC;

     ABNDINFO_REC = '';
     ABNDINFO_REC.ABND_RESPCODE  = CHAR(EIBRESP);
     ABNDINFO_REC.ABND_RESP2CODE = CHAR(EIBRESP2);

     EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);

     ABNDINFO_REC.ABND_TASKNO_KEY = EIBTASKN;
     ABNDINFO_REC.ABND_TRANID     = EIBTRNID;

     CALL POPULATE_TIME_DATE;

     ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
     ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_GRP_HH || ':' ||
                 WS_TIME_NOW_GRP_MM || ':' ||
                 WS_TIME_NOW_GRP_SS;
     ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
     ABNDINFO_REC.ABND_CODE      = 'ITRL';

     EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);

     ABNDINFO_REC.ABND_FREEFORM = 'INQTRANL - Abend occurred';

     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);

     EXEC CICS RETURN;

   END ABEND_HANDLING;

   /*****************************************************************/
   /* POPULATE_TIME_DATE - Get current CICS time/date              */
   /*****************************************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME ABSTIME(WS_U_TIME)
               DDMMYYYY(WS_ORIG_DATE)
               TIME(WS_TIME_NOW)
               DATESEP('/');
   END POPULATE_TIME_DATE;

   /*****************************************************************/
   /* CONVERT_YYYYMMDD_TO_ISO - YYYYMMDD -> YYYY-MM-DD             */
   /*****************************************************************/
   CONVERT_YYYYMMDD_TO_ISO: PROC;
     WS_DATE_ISO_YYYY = WS_DATE_YYYY;
     WS_DATE_ISO_SEP1 = '-';
     WS_DATE_ISO_MM   = WS_DATE_MM;
     WS_DATE_ISO_SEP2 = '-';
     WS_DATE_ISO_DD   = WS_DATE_DD;
   END CONVERT_YYYYMMDD_TO_ISO;

   /*****************************************************************/
   /* CONVERT_ISO_TO_YYYYMMDD - YYYY-MM-DD -> YYYYMMDD             */
   /*****************************************************************/
   CONVERT_ISO_TO_YYYYMMDD: PROC;
     WS_DATE_YYYY = WS_DATE_ISO_YYYY;
     WS_DATE_MM   = WS_DATE_ISO_MM;
     WS_DATE_DD   = WS_DATE_ISO_DD;
   END CONVERT_ISO_TO_YYYYMMDD;

 END INQTRANL;
