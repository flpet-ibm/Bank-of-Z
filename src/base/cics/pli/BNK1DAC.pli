*PROCESS SYSTEM(CICS) MARGINS(1,72);
 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* BNK1DAC - BMS Screen handler for Display/Delete Account       */
 /* Retrieves account data (INQACC) and optionally deletes it     */
 /* via DELACC.  Transaction: ODAC                                */
 /***************************************************************** */
 BNK1DAC: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA - account display commarea                       */
   /*****************************************************************/
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR),
     3 COMM_EYE          CHAR(4),
     3 COMM_CUSTNO       CHAR(10),
     3 COMM_SCODE        CHAR(6),
     3 COMM_ACCNO        CHAR(8),
     3 COMM_ACC_TYPE     CHAR(8),
     3 COMM_INT_RATE     CHAR(6),
     3 COMM_OPENED       CHAR(8),
     3 COMM_OVERDRAFT    CHAR(8),
     3 COMM_LAST_STMT_DT CHAR(8),
     3 COMM_NEXT_STMT_DT CHAR(8),
     3 COMM_AVAIL_BAL    FIXED DEC(12,2),
     3 COMM_ACTUAL_BAL   FIXED DEC(12,2),
     3 COMM_SUCCESS      CHAR(1),
     3 COMM_FAIL_CD      CHAR(1),
     3 COMM_DEL_SUCCESS  CHAR(1),
     3 COMM_DEL_FAIL_CD  CHAR(1);

   /*****************************************************************/
   /* BMS map                                                       */
   /*****************************************************************/
   %INCLUDE BNK1DAM;
   DCL 1 BNK1DAI_MAP LIKE BNK1DAM_TMPL;

   /*****************************************************************/
   /* AID key definitions                                           */
   /*****************************************************************/
   %INCLUDE DFHAID;

   /*****************************************************************/
   /* INQACC commarea                                               */
   /*****************************************************************/
   %INCLUDE INQACC;
   DCL 1 INQACC_COMMAREA LIKE INQACC_TMPL;

   /*****************************************************************/
   /* ABNDINFO                                                      */
   /*****************************************************************/
   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP        FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2       FIXED BIN(31) INIT(0);

   DCL 1 WS_FAIL_INFO,
     3 WS_FAIL_PROG          CHAR(9)  INIT('BNK1DAC  '),
     3 WS_CICS_FAIL_MSG      CHAR(70) INIT(' '),
     3 WS_CICS_FAIL_RESP_LIT CHAR(6)  INIT(' RESP='),
     3 WS_CICS_RESP_DISP     CHAR(10) INIT('0000000000'),
     3 WS_CICS_FAIL_RSP2_LIT CHAR(7)  INIT(' RESP2='),
     3 WS_CICS_RESP2_DISP    CHAR(10) INIT('0000000000'),
     3 WS_CICS_ABENDING      CHAR(15) INIT(' ABENDING TASK.');

   DCL VALID_DATA_SW   CHAR(1) INIT('Y');
   DCL SEND_FLAG       CHAR(1) INIT(' ');
   /* SEND_FLAG: 'E'=ERASE 'D'=DATAONLY 'A'=DATAONLY+ALARM */

   DCL END_OF_SESSION_MSG CHAR(13) INIT('Session Ended');
   DCL WS_ABEND_PGM    CHAR(8)  INIT('ABNDPROC');

   /* PARMS_SUBPGM for DELACC (reuses DELACC structure) */
   %INCLUDE DELACC;
   DCL 1 PARMS_SUBPGM LIKE DELACC_TMPL;

   /* Working commarea copy */
   DCL 1 WS_COMM_AREA,
     3 WS_COMM_EYE          CHAR(4),
     3 WS_COMM_CUSTNO       CHAR(10),
     3 WS_COMM_SCODE        CHAR(6),
     3 WS_COMM_ACCNO        CHAR(8),
     3 WS_COMM_ACC_TYPE     CHAR(8),
     3 WS_COMM_INT_RATE     CHAR(6),
     3 WS_COMM_OPENED       CHAR(8),
     3 WS_COMM_OVERDRAFT    CHAR(8),
     3 WS_COMM_LAST_STMT_DT CHAR(8),
     3 WS_COMM_NEXT_STMT_DT CHAR(8),
     3 WS_COMM_AVAIL_BAL    FIXED DEC(12,2),
     3 WS_COMM_ACTUAL_BAL   FIXED DEC(12,2),
     3 WS_COMM_SUCCESS      CHAR(1),
     3 WS_COMM_FAIL_CD      CHAR(1),
     3 WS_COMM_DEL_SUCCESS  CHAR(1),
     3 WS_COMM_DEL_FAIL_CD  CHAR(1);

   /* Date parsing */
   DCL 1 COMM_OPENED_SPLIT,
     3 COMM_OPENED_DD   CHAR(2),
     3 COMM_OPENED_MM   CHAR(2),
     3 COMM_OPENED_YY   CHAR(4);

   DCL 1 COMM_LAST_ST_SPLIT,
     3 COMM_LAST_ST_DD  CHAR(2),
     3 COMM_LAST_ST_MM  CHAR(2),
     3 COMM_LAST_ST_YY  CHAR(4);

   DCL 1 COMM_NEXT_ST_SPLIT,
     3 COMM_NEXT_ST_DD  CHAR(2),
     3 COMM_NEXT_ST_MM  CHAR(2),
     3 COMM_NEXT_ST_YY  CHAR(4);

   /* Balance display */
   DCL AVAIL_BAL_DISP  CHAR(14) INIT(' ');
   DCL ACTUAL_BAL_DISP CHAR(14) INIT(' ');

   /* Date/time */
   DCL WS_U_TIME       FIXED DEC(15) INIT(0);
   DCL WS_ORIG_DATE    CHAR(10)      INIT(' ');
   DCL WS_TIME_NOW     CHAR(6)       INIT(' ');
   DCL WS_TIME_HH      CHAR(2)       INIT(' ');
   DCL WS_TIME_MM_V    CHAR(2)       INIT(' ');
   DCL WS_TIME_SS      CHAR(2)       INIT(' ');
   DCL WS_ABND_TIME_STR CHAR(8)      INIT(' ');
   DCL WS_ABND_FREEFORM CHAR(255)    INIT(' ');

   /*****************************************************************/
   /* Internal procedure declarations                               */
   /*****************************************************************/
   DCL PROCESS_MAP        ENTRY;
   DCL RECEIVE_MAP        ENTRY;
   DCL EDIT_DATA          ENTRY;
   DCL VALIDATE_DATA      ENTRY;
   DCL GET_ACC_DATA       ENTRY;
   DCL DEL_ACC_DATA       ENTRY;
   DCL SEND_MAP           ENTRY;
   DCL SEND_TERMINATION   ENTRY;
   DCL ABEND_THIS_TASK    ENTRY;
   DCL POPULATE_TIME_DATE ENTRY;
   DCL SETUP_ABND_INFO    ENTRY;

   /*****************************************************************/
   /* PREMIERE - main dispatch                                      */
   /*****************************************************************/
   INQACC_COMMAREA = '';
   PARMS_SUBPGM = '';

   SELECT;
     WHEN(EIBCALEN = 0)
       DO;
         BNK1DAI_MAP = LOW(LENGTH(BNK1DAI_MAP));
         BNK1DAI_MAP.ACCNOL = -1;
         SEND_FLAG = 'E';
         WS_COMM_AREA = '';
         CALL SEND_MAP;
       END;
     WHEN(EIBAID = DFHPA1 | EIBAID = DFHPA2 | EIBAID = DFHPA3)
       ;  /* continue */
     WHEN(EIBAID = DFHPF3)
       DO;
         EXEC CICS RETURN
           TRANSID('OMEN')
           IMMEDIATE
           RESP(WS_CICS_RESP)
           RESP2(WS_CICS_RESP2);
       END;
     WHEN(EIBAID = DFHPF5)
       CALL PROCESS_MAP;
     WHEN(EIBAID = DFHPF12)
       DO;
         CALL SEND_TERMINATION;
         EXEC CICS RETURN;
       END;
     WHEN(EIBAID = DFHCLEAR)
       DO;
         EXEC CICS SEND CONTROL
           ERASE
           FREEKB;
         EXEC CICS RETURN;
       END;
     WHEN(EIBAID = DFHENTER)
       CALL PROCESS_MAP;
     OTHERWISE
       DO;
         BNK1DAI_MAP = LOW(LENGTH(BNK1DAI_MAP));
         BNK1DAI_MAP.MESSAGEI = 'Invalid key pressed.';
         BNK1DAI_MAP.ACCNOL = -1;
         SEND_FLAG = 'A';
         CALL SEND_MAP;
       END;
   END;

   IF EIBCALEN ^= 0 THEN
     DO;
       IF INQACC_COMMAREA.INQACC_EYE = 'ACCT' THEN
         DO;
           WS_COMM_EYE          =
             INQACC_COMMAREA.INQACC_EYE;
           WS_COMM_CUSTNO       =
             INQACC_COMMAREA.INQACC_CUSTNO;
           WS_COMM_SCODE        =
             INQACC_COMMAREA.INQACC_SCODE;
           WS_COMM_ACCNO        =
             INQACC_COMMAREA.INQACC_ACCNO;
           WS_COMM_ACC_TYPE     =
             INQACC_COMMAREA.INQACC_ACC_TYPE;
           WS_COMM_OPENED       =
             INQACC_COMMAREA.INQACC_OPENED;
           WS_COMM_OVERDRAFT    =
             INQACC_COMMAREA.INQACC_OVERDRAFT;
           WS_COMM_LAST_STMT_DT =
             INQACC_COMMAREA.INQACC_LAST_STMT_DT;
           WS_COMM_NEXT_STMT_DT =
             INQACC_COMMAREA.INQACC_NEXT_STMT_DT;
           WS_COMM_AVAIL_BAL    =
             INQACC_COMMAREA.INQACC_AVAIL_BAL;
           WS_COMM_ACTUAL_BAL   =
             INQACC_COMMAREA.INQACC_ACTUAL_BAL;
           WS_COMM_SUCCESS      =
             INQACC_COMMAREA.INQACC_SUCCESS;
         END;
       ELSE
         WS_COMM_AREA = '';
     END;

   EXEC CICS RETURN
     TRANSID('ODAC')
     COMMAREA(WS_COMM_AREA)
     LENGTH(102)
     RESP(WS_CICS_RESP)
     RESP2(WS_CICS_RESP2);

   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
     DO;
       CALL SETUP_ABND_INFO;
       WS_ABND_FREEFORM =
         'A010 - RETURN TRANSID(ODAC) FAIL.';
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
         COMMAREA(ABNDINFO_REC);
       WS_CICS_FAIL_MSG =
         'BNK1DAC - A010 - RETURN TRANSID(ODAC) FAIL';
       WS_CICS_RESP_DISP  = WS_CICS_RESP;
       WS_CICS_RESP2_DISP = WS_CICS_RESP2;
       CALL ABEND_THIS_TASK;
     END;

   /*****************************************************************/
   /* PROCESS_MAP                                                   */
   /*****************************************************************/
   PROCESS_MAP: PROC;
     CALL RECEIVE_MAP;
     IF EIBAID = DFHENTER THEN
       DO;
         CALL EDIT_DATA;
         IF VALID_DATA_SW = 'Y' THEN
           CALL GET_ACC_DATA;
         ELSE
           PARMS_SUBPGM = '';
       END;
     IF EIBAID = DFHPF5 THEN
       DO;
         CALL VALIDATE_DATA;
         IF VALID_DATA_SW = 'Y' THEN
           CALL DEL_ACC_DATA;
       END;
     SEND_FLAG = 'A';
     CALL SEND_MAP;
   END PROCESS_MAP;

   /*****************************************************************/
   /* RECEIVE_MAP                                                   */
   /*****************************************************************/
   RECEIVE_MAP: PROC;
     EXEC CICS RECEIVE MAP('BNK1DA')
       MAPSET('BNK1DAM')
       INTO(BNK1DAI_MAP)
       RESP(WS_CICS_RESP)
       RESP2(WS_CICS_RESP2);
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
       DO;
         CALL SETUP_ABND_INFO;
         WS_ABND_FREEFORM = 'RM010 - RECEIVE MAP FAIL.';
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
           COMMAREA(ABNDINFO_REC);
         WS_CICS_FAIL_MSG =
           'BNK1DAC - RM010 - RECEIVE MAP FAIL';
         WS_CICS_RESP_DISP  = WS_CICS_RESP;
         WS_CICS_RESP2_DISP = WS_CICS_RESP2;
         CALL ABEND_THIS_TASK;
       END;
   END RECEIVE_MAP;

   /*****************************************************************/
   /* EDIT_DATA                                                     */
   /*****************************************************************/
   EDIT_DATA: PROC;
     IF BNK1DAI_MAP.ACCNOI = LOW(1) | BNK1DAI_MAP.ACCNOL = 0 THEN
       DO;
         BNK1DAI_MAP.MESSAGEI = 'Please enter an account number.';
         VALID_DATA_SW = 'N';
         RETURN;
       END;
     EXEC CICS BIF DEEDIT FIELD(BNK1DAI_MAP.ACCNOI);
     IF VERIFY(BNK1DAI_MAP.ACCNOI,'0123456789') ^= 0 THEN
       DO;
         BNK1DAI_MAP.MESSAGEI = 'Please enter an account number.';
         VALID_DATA_SW = 'N';
       END;
   END EDIT_DATA;

   /*****************************************************************/
   /* VALIDATE_DATA                                                 */
   /*****************************************************************/
   VALIDATE_DATA: PROC;
     IF WS_COMM_SCODE = '000000' | WS_COMM_SCODE = ' ' |
        WS_COMM_ACCNO = '00000000' | WS_COMM_ACCNO = ' ' THEN
       DO;
         VALID_DATA_SW = 'N';
         BNK1DAI_MAP.MESSAGEI = 'Please enter an account number.';
         BNK1DAI_MAP.ACCNOL = -1;
       END;
   END VALIDATE_DATA;

   /*****************************************************************/
   /* GET_ACC_DATA - link to INQACC                                */
   /*****************************************************************/
   GET_ACC_DATA: PROC;
     INQACC_COMMAREA = '';
     INQACC_COMMAREA.INQACC_PCB1_POINTER = SYSNULL();
     INQACC_COMMAREA.INQACC_ACCNO = BNK1DAI_MAP.ACCNOI;
     EXEC CICS LINK PROGRAM('INQACC')
       COMMAREA(INQACC_COMMAREA)
       RESP(WS_CICS_RESP)
       RESP2(WS_CICS_RESP2)
       SYNCONRETURN;
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
       DO;
         CALL SETUP_ABND_INFO;
         WS_ABND_FREEFORM = 'GAD010 - LINK INQACC FAIL.';
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
           COMMAREA(ABNDINFO_REC);
         WS_CICS_FAIL_MSG =
           'BNK1DAC - GAD010 - LINK INQACC FAIL';
         WS_CICS_RESP_DISP  = WS_CICS_RESP;
         WS_CICS_RESP2_DISP = WS_CICS_RESP2;
         CALL ABEND_THIS_TASK;
       END;
     IF INQACC_COMMAREA.INQACC_ACC_TYPE = ' ' &
        INQACC_COMMAREA.INQACC_SUCCESS  = 'N' THEN
       DO;
         BNK1DAI_MAP.MESSAGEI =
           'Sorry, but that account number was not found.';
         VALID_DATA_SW = 'N';
         BNK1DAI_MAP.SORTCI   = ' ';
         BNK1DAI_MAP.CUSTNOI  = ' ';
         BNK1DAI_MAP.ACCNO2I  = ' ';
         BNK1DAI_MAP.ACTYPI   = ' ';
         BNK1DAI_MAP.INTRTI   = '0';
         BNK1DAI_MAP.OPENDDI  = ' ';
         BNK1DAI_MAP.OPENMMI  = ' ';
         BNK1DAI_MAP.OPENYYI  = ' ';
         BNK1DAI_MAP.OVERDRI  = ' ';
         BNK1DAI_MAP.LSTMTDDI = ' ';
         BNK1DAI_MAP.LSTMTMMI = ' ';
         BNK1DAI_MAP.LSTMTYYI = ' ';
         BNK1DAI_MAP.NSTMTDDI = ' ';
         BNK1DAI_MAP.NSTMTMMI = ' ';
         BNK1DAI_MAP.NSTMTYYI = ' ';
         BNK1DAI_MAP.AVBALI   = ' ';
         BNK1DAI_MAP.ACTBALI  = ' ';
         RETURN;
       END;
     BNK1DAI_MAP.SORTCI  = INQACC_COMMAREA.INQACC_SCODE;
     BNK1DAI_MAP.CUSTNOI = INQACC_COMMAREA.INQACC_CUSTNO;
     BNK1DAI_MAP.ACCNO2I = INQACC_COMMAREA.INQACC_ACCNO;
     BNK1DAI_MAP.ACTYPI  = INQACC_COMMAREA.INQACC_ACC_TYPE;
     COMM_OPENED_SPLIT =
       INQACC_COMMAREA.INQACC_OPENED;
     BNK1DAI_MAP.OPENDDI = COMM_OPENED_DD;
     BNK1DAI_MAP.OPENMMI = COMM_OPENED_MM;
     BNK1DAI_MAP.OPENYYI = COMM_OPENED_YY;
     BNK1DAI_MAP.OVERDRI = INQACC_COMMAREA.INQACC_OVERDRAFT;
     COMM_LAST_ST_SPLIT =
       INQACC_COMMAREA.INQACC_LAST_STMT_DT;
     BNK1DAI_MAP.LSTMTDDI = COMM_LAST_ST_DD;
     BNK1DAI_MAP.LSTMTMMI = COMM_LAST_ST_MM;
     BNK1DAI_MAP.LSTMTYYI = COMM_LAST_ST_YY;
     COMM_NEXT_ST_SPLIT =
       INQACC_COMMAREA.INQACC_NEXT_STMT_DT;
     BNK1DAI_MAP.NSTMTDDI = COMM_NEXT_ST_DD;
     BNK1DAI_MAP.NSTMTMMI = COMM_NEXT_ST_MM;
     BNK1DAI_MAP.NSTMTYYI = COMM_NEXT_ST_YY;
     AVAIL_BAL_DISP  = INQACC_COMMAREA.INQACC_AVAIL_BAL;
     ACTUAL_BAL_DISP = INQACC_COMMAREA.INQACC_ACTUAL_BAL;
     BNK1DAI_MAP.AVBALI  = AVAIL_BAL_DISP;
     BNK1DAI_MAP.ACTBALI = ACTUAL_BAL_DISP;
     BNK1DAI_MAP.MESSAGEI =
         'If you wish to delete the Account press <PF5>.';
   END GET_ACC_DATA;

   /*****************************************************************/
   /* DEL_ACC_DATA - link to DELACC                                */
   /*****************************************************************/
   DEL_ACC_DATA: PROC;
     PARMS_SUBPGM = '';
     PARMS_SUBPGM.DELACC_ACCNO = BNK1DAI_MAP.ACCNO2I;
     PARMS_SUBPGM.DELACC_DEL_PCB1 = SYSNULL();
     PARMS_SUBPGM.DELACC_DEL_PCB2 = SYSNULL();
     PARMS_SUBPGM.DELACC_DEL_PCB3 = SYSNULL();
     EXEC CICS LINK PROGRAM('DELACC')
       COMMAREA(PARMS_SUBPGM)
       RESP(WS_CICS_RESP)
       RESP2(WS_CICS_RESP2)
       SYNCONRETURN;
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
       DO;
         WS_CICS_FAIL_MSG =
           'BNK1DAC - DAD010 - LINK DELACC FAIL';
         WS_CICS_RESP_DISP  = WS_CICS_RESP;
         WS_CICS_RESP2_DISP = WS_CICS_RESP2;
         CALL ABEND_THIS_TASK;
       END;
     IF PARMS_SUBPGM.DELACC_DEL_SUCCESS = 'N' THEN
       DO;
         VALID_DATA_SW = 'N';
         SELECT(PARMS_SUBPGM.DELACC_DEL_FAIL_CD);
           WHEN('1')
             BNK1DAI_MAP.MESSAGEI =
               'Sorry, account not found. Account NOT deleted.';
           WHEN('2')
             BNK1DAI_MAP.MESSAGEI =
               'Sorry, datastore error. Account NOT deleted.';
           WHEN('3')
             BNK1DAI_MAP.MESSAGEI =
               'Sorry, delete error. Account NOT deleted.';
           OTHERWISE
             BNK1DAI_MAP.MESSAGEI =
               'Sorry, delete error. Account NOT deleted.';
         END;
         BNK1DAI_MAP.SORTCI = PARMS_SUBPGM.DELACC_SCODE;
         RETURN;
       END;
     BNK1DAI_MAP.SORTCI   = ' ';
     BNK1DAI_MAP.CUSTNOI  = ' ';
     BNK1DAI_MAP.ACCNO2I  = ' ';
     BNK1DAI_MAP.ACTYPI   = ' ';
     BNK1DAI_MAP.INTRTI   = '0';
     BNK1DAI_MAP.OPENDDI  = ' ';
     BNK1DAI_MAP.OPENMMI  = ' ';
     BNK1DAI_MAP.OPENYYI  = ' ';
     BNK1DAI_MAP.OVERDRI  = ' ';
     BNK1DAI_MAP.LSTMTDDI = ' ';
     BNK1DAI_MAP.LSTMTMMI = ' ';
     BNK1DAI_MAP.LSTMTYYI = ' ';
     BNK1DAI_MAP.NSTMTDDI = ' ';
     BNK1DAI_MAP.NSTMTMMI = ' ';
     BNK1DAI_MAP.NSTMTYYI = ' ';
     BNK1DAI_MAP.AVBALI   = ' ';
     BNK1DAI_MAP.ACTBALI  = ' ';
     BNK1DAI_MAP.MESSAGEI =
       'Account ' || TRIM(PARMS_SUBPGM.DELACC_ACCNO) ||
       ' was successfully deleted.';
   END DEL_ACC_DATA;

   /*****************************************************************/
   /* SEND_MAP                                                      */
   /*****************************************************************/
   SEND_MAP: PROC;
     IF SEND_FLAG = 'E' THEN
       DO;
         EXEC CICS SEND MAP('BNK1DA')
           MAPSET('BNK1DAM')
           FROM(BNK1DAI_MAP)
           ERASE
           FREEKB
           RESP(WS_CICS_RESP)
           RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
           DO;
             CALL SETUP_ABND_INFO;
             WS_ABND_FREEFORM =
               'SM010 - SEND MAP ERASE FAIL.';
             EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);
             WS_CICS_FAIL_MSG =
               'BNK1DAC - SM010 - SEND MAP ERASE FAIL';
             WS_CICS_RESP_DISP  = WS_CICS_RESP;
             WS_CICS_RESP2_DISP = WS_CICS_RESP2;
             CALL ABEND_THIS_TASK;
           END;
         RETURN;
       END;
     IF SEND_FLAG = 'D' THEN
       DO;
         IF BNK1DAI_MAP.MESSAGEI ^= ' ' & BNK1DAI_MAP.MESSAGEI ^=
             LOW(79) THEN
           BNK1DAI_MAP.MESSAGEI = 'Account lookup successful.';
         EXEC CICS SEND MAP('BNK1DA')
           MAPSET('BNK1DAM')
           FROM(BNK1DAI_MAP)
           DATAONLY
           FREEKB
           RESP(WS_CICS_RESP)
           RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
           DO;
             CALL SETUP_ABND_INFO;
             WS_ABND_FREEFORM =
               'SM010 - SEND MAP DATAONLY FAIL.';
             EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);
             WS_CICS_FAIL_MSG =
               'BNK1DAC - SM010 - SEND MAP DATAONLY FAIL';
             WS_CICS_RESP_DISP  = WS_CICS_RESP;
             WS_CICS_RESP2_DISP = WS_CICS_RESP2;
             CALL ABEND_THIS_TASK;
           END;
         RETURN;
       END;
     IF SEND_FLAG = 'A' THEN
       DO;
         EXEC CICS SEND MAP('BNK1DA')
           MAPSET('BNK1DAM')
           FROM(BNK1DAI_MAP)
           DATAONLY
           ALARM
           FREEKB
           RESP(WS_CICS_RESP)
           RESP2(WS_CICS_RESP2);
         IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
           DO;
             CALL SETUP_ABND_INFO;
             WS_ABND_FREEFORM =
               'SM010 - SEND MAP DATAONLY ALARM FAIL.';
             EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);
             WS_CICS_FAIL_MSG =
               'BNK1DAC - SM010 - SEND MAP ALARM FAIL';
             WS_CICS_RESP_DISP  = WS_CICS_RESP;
             WS_CICS_RESP2_DISP = WS_CICS_RESP2;
             CALL ABEND_THIS_TASK;
           END;
       END;
   END SEND_MAP;

   /*****************************************************************/
   /* SEND_TERMINATION                                              */
   /*****************************************************************/
   SEND_TERMINATION: PROC;
     EXEC CICS SEND TEXT
       FROM(END_OF_SESSION_MSG)
       ERASE
       FREEKB
       RESP(WS_CICS_RESP)
       RESP2(WS_CICS_RESP2);
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN
       DO;
         CALL SETUP_ABND_INFO;
         WS_ABND_FREEFORM = 'STM010 - SEND TEXT FAIL.';
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
           COMMAREA(ABNDINFO_REC);
         WS_CICS_FAIL_MSG =
           'BNK1DAC - STM010 - SEND TEXT FAIL';
         WS_CICS_RESP_DISP  = WS_CICS_RESP;
         WS_CICS_RESP2_DISP = WS_CICS_RESP2;
         CALL ABEND_THIS_TASK;
       END;
   END SEND_TERMINATION;

   /*****************************************************************/
   /* ABEND_THIS_TASK                                               */
   /*****************************************************************/
   ABEND_THIS_TASK: PROC;
     EXEC CICS ABEND ABCODE('HBNK') NODUMP;
   END ABEND_THIS_TASK;

   /*****************************************************************/
   /* POPULATE_TIME_DATE                                            */
   /*****************************************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME ABSTIME(WS_U_TIME)
       DDMMYYYY(WS_ORIG_DATE)
       TIME(WS_TIME_NOW)
       DATESEP;
     WS_TIME_HH  = SUBSTR(WS_TIME_NOW,1,2);
     WS_TIME_MM_V = SUBSTR(WS_TIME_NOW,3,2);
     WS_TIME_SS  = SUBSTR(WS_TIME_NOW,5,2);
   END POPULATE_TIME_DATE;

   /*****************************************************************/
   /* SETUP_ABND_INFO                                               */
   /*****************************************************************/
   SETUP_ABND_INFO: PROC;
     ABNDINFO_REC = '';
     ABNDINFO_REC.ABND_RESPCODE  = EIBRESP;
     ABNDINFO_REC.ABND_RESP2CODE = EIBRESP2;
     EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
     ABNDINFO_REC.ABND_TASKNO_KEY = EIBTASKN;
     ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
     CALL POPULATE_TIME_DATE;
     ABNDINFO_REC.ABND_DATE  = WS_ORIG_DATE;
     WS_ABND_TIME_STR = WS_TIME_HH || ':' ||
       WS_TIME_MM_V || ':' || WS_TIME_SS;
     ABNDINFO_REC.ABND_TIME  = WS_ABND_TIME_STR;
     ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
     ABNDINFO_REC.ABND_CODE  = 'HBNK';
     EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
     ABNDINFO_REC.ABND_SQLCODE = 0;
     ABNDINFO_REC.ABND_FREEFORM = WS_ABND_FREEFORM;
   END SETUP_ABND_INFO;

 END BNK1DAC;
