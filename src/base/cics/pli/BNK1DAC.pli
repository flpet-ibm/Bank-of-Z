 *PROCESS CICS;
 /* ----------------------------------------------------------------- */
 /*  Copyright IBM Corp. 2023                                        */
 /* ----------------------------------------------------------------- */
 /*  BNK1DAC - Display Account / Delete Account (BMS CICS program)  */
 /*  Converted from COBOL BNK1DAC.cbl                               */
 /*  Displays account information; handles PF5 delete request.      */
 /* ----------------------------------------------------------------- */
 BNK1DAC: PROCEDURE OPTIONS(MAIN REENTRANT);

   /* --------------------------------------------------------------- */
   /*  BMS symbolic map include (BNK1DAM mapset)                      */
   /* --------------------------------------------------------------- */
   %INCLUDE BNK1DAM;

   /* --------------------------------------------------------------- */
   /*  Abend info structure                                           */
   /* --------------------------------------------------------------- */
   %INCLUDE ABNDINFO;

   /* --------------------------------------------------------------- */
   /*  INQACC commarea                                                */
   /* --------------------------------------------------------------- */
   %INCLUDE INQACC;

   /* --------------------------------------------------------------- */
   /*  DELACC commarea                                                */
   /* --------------------------------------------------------------- */
   %INCLUDE DELACC;

   /* --------------------------------------------------------------- */
   /*  CICS response codes                                            */
   /* --------------------------------------------------------------- */
   DCL WS_CICS_RESP          FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2         FIXED BIN(31) INIT(0);

   /* --------------------------------------------------------------- */
   /*  Fail info (mirrors WS-FAIL-INFO)                               */
   /* --------------------------------------------------------------- */
   DCL 1 WS_FAIL_INFO,
         2 WS_FI_PGM         CHAR(9)  INIT('BNK1DAC  '),
         2 WS_CICS_FAIL_MSG  CHAR(70) INIT(' '),
         2 WS_FI_RESP_LBL    CHAR(6)  INIT(' RESP='),
         2 WS_CICS_RESP_DISP CHAR(10) INIT('0000000000'),
         2 WS_FI_RESP2_LBL   CHAR(7)  INIT(' RESP2='),
         2 WS_CICS_RESP2_DISP CHAR(10) INIT('0000000000'),
         2 WS_FI_ABEND       CHAR(15) INIT(' ABENDING TASK.');

   /* --------------------------------------------------------------- */
   /*  Switches and flags                                             */
   /* --------------------------------------------------------------- */
   DCL VALID_DATA_SW         CHAR(1) INIT('Y');
   DCL SEND_FLAG             CHAR(1);
   DCL SEND_ERASE_C          CHAR(1) INIT('1'); /* SEND-ERASE        */
   DCL SEND_DATAONLY_C       CHAR(1) INIT('2'); /* SEND-DATAONLY     */
   DCL SEND_DATAONLY_ALARM_C CHAR(1) INIT('3'); /* DATAONLY+ALARM    */

   /* --------------------------------------------------------------- */
   /*  End of session message                                         */
   /* --------------------------------------------------------------- */
   DCL END_OF_SESSION_MSG    CHAR(13) INIT('Session Ended');

   /* --------------------------------------------------------------- */
   /*  Response code                                                  */
   /* --------------------------------------------------------------- */
   DCL RESPONSE_CODE         FIXED BIN(31) INIT(0);

   /* --------------------------------------------------------------- */
   /*  Communication area (1-byte placeholder)                        */
   /* --------------------------------------------------------------- */
   DCL COMMUNICATION_AREA    CHAR(1) INIT(' ');

   /* --------------------------------------------------------------- */
   /*  DFHAID constants                                               */
   /* --------------------------------------------------------------- */
   DCL DFHENTER  CHAR(1) INIT('7D'X);
   DCL DFHCLEAR  CHAR(1) INIT('6D'X);
   DCL DFHPA1    CHAR(1) INIT('6C'X);
   DCL DFHPA2    CHAR(1) INIT('6E'X);
   DCL DFHPA3    CHAR(1) INIT('6B'X);
   DCL DFHPF3    CHAR(1) INIT('F3'X);
   DCL DFHPF5    CHAR(1) INIT('C5'X);
   DCL DFHPF12   CHAR(1) INIT('7C'X);

   /* --------------------------------------------------------------- */
   /*  Date / time working storage                                    */
   /* --------------------------------------------------------------- */
   DCL WS_U_TIME     FIXED DEC(15,0) INIT(0);
   DCL WS_ORIG_DATE  CHAR(10);
   DCL WS_TIME_NOW   CHAR(6);

   /* --------------------------------------------------------------- */
   /*  Date split structures (opened / last-stmt / next-stmt)        */
   /* --------------------------------------------------------------- */
   DCL 1 COMM_OPENED_SPLIT,
         2 COMM_OPENED_DD   CHAR(2),
         2 COMM_OPENED_MM   CHAR(2),
         2 COMM_OPENED_YY   CHAR(4);

   DCL 1 COMM_LAST_ST_SPLIT,
         2 COMM_LAST_ST_DD  CHAR(2),
         2 COMM_LAST_ST_MM  CHAR(2),
         2 COMM_LAST_ST_YY  CHAR(4);

   DCL 1 COMM_NEXT_ST_SPLIT,
         2 COMM_NEXT_ST_DD  CHAR(2),
         2 COMM_NEXT_ST_MM  CHAR(2),
         2 COMM_NEXT_ST_YY  CHAR(4);

   /* --------------------------------------------------------------- */
   /*  Balance display                                                */
   /* --------------------------------------------------------------- */
   DCL AVAIL_BAL_DISP  CHAR(14);
   DCL ACTUAL_BAL_DISP CHAR(14);

   /* --------------------------------------------------------------- */
   /*  Abend program name / misc                                      */
   /* --------------------------------------------------------------- */
   DCL WS_ABEND_PGM   CHAR(8) INIT('ABNDPROC');
   DCL WS_CA_LEN      FIXED BIN(15);

   /* --------------------------------------------------------------- */
   /*  Working storage commarea copy (for RETURN COMMAREA)           */
   /* --------------------------------------------------------------- */
   DCL 1 WS_COMM_AREA,
         2 WS_COMM_EYE         CHAR(4),
         2 WS_COMM_CUSTNO      CHAR(10),
         2 WS_COMM_SCODE       CHAR(6),
         2 WS_COMM_ACCNO       FIXED DEC(8,0),
         2 WS_COMM_ACC_TYPE    CHAR(8),
         2 WS_COMM_INT_RATE    FIXED DEC(6,2),
         2 WS_COMM_OPENED      FIXED DEC(8,0),
         2 WS_COMM_OVERDRAFT   FIXED DEC(8,0),
         2 WS_COMM_LAST_STMT   FIXED DEC(8,0),
         2 WS_COMM_NEXT_STMT   FIXED DEC(8,0),
         2 WS_COMM_AVAIL_BAL   FIXED DEC(12,2),
         2 WS_COMM_ACTUAL_BAL  FIXED DEC(12,2),
         2 WS_COMM_SUCCESS     CHAR(1),
         2 WS_COMM_FAIL_CD     CHAR(1),
         2 WS_COMM_DEL_SUCCESS CHAR(1),
         2 WS_COMM_DEL_FAIL_CD CHAR(1);

   /* =============================================================== */
   /*  MAIN LOGIC (PREMIERE SECTION / A010)                          */
   /* =============================================================== */

   INQACC_COMMAREA = '';
   DELACC_COMMAREA = '';

   /* Set up abend handler */
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING) ;

   IF EIBCALEN = 0 THEN DO;
     BNK1DAI = '';
     ACCNOL = -1;
     SEND_FLAG = SEND_ERASE_C;
     WS_COMM_AREA = '';
     CALL SEND_MAP;
   END;
   ELSE IF EIBAID = DFHPA1 | EIBAID = DFHPA2 |
           EIBAID = DFHPA3 THEN DO;
     /* PA key - just continue */
   END;
   ELSE IF EIBAID = DFHPF3 THEN DO;
     EXEC CICS RETURN TRANSID('OMEN')
          IMMEDIATE
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2) ;
   END;
   ELSE IF EIBAID = DFHPF5 THEN DO;
     CALL PROCESS_MAP;
   END;
   ELSE IF EIBAID = DFHPF12 THEN DO;
     CALL SEND_TERMINATION_MSG;
     EXEC CICS RETURN ;
   END;
   ELSE IF EIBAID = DFHCLEAR THEN DO;
     EXEC CICS SEND CONTROL ERASE FREEKB ;
     EXEC CICS RETURN ;
   END;
   ELSE IF EIBAID = DFHENTER THEN DO;
     CALL PROCESS_MAP;
   END;
   ELSE DO;
     BNK1DAI = '';
     MESSAGEO = 'Invalid key pressed.';
     ACCNOL = -1;
     SEND_FLAG = SEND_DATAONLY_ALARM_C;
     CALL SEND_MAP;
   END;

   /* Update WS_COMM_AREA from INQACC results if not first time */
   IF EIBCALEN ^= 0 THEN DO;
     IF INQACC_EYE = 'ACCT' THEN DO;
       WS_COMM_EYE        = INQACC_EYE;
       WS_COMM_CUSTNO     = INQACC_CUSTNO;
       WS_COMM_SCODE      = INQACC_SCODE;
       WS_COMM_ACCNO      = INQACC_ACCNO;
       WS_COMM_ACC_TYPE   = INQACC_ACC_TYPE;
       WS_COMM_INT_RATE   = INQACC_INT_RATE;
       WS_COMM_OPENED     = INQACC_OPENED;
       WS_COMM_OVERDRAFT  = INQACC_OVERDRAFT;
       WS_COMM_LAST_STMT  = INQACC_LAST_STMT_DT;
       WS_COMM_NEXT_STMT  = INQACC_NEXT_STMT_DT;
       WS_COMM_AVAIL_BAL  = INQACC_AVAIL_BAL;
       WS_COMM_ACTUAL_BAL = INQACC_ACTUAL_BAL;
       WS_COMM_SUCCESS    = INQACC_SUCCESS;
     END;
     ELSE DO;
       WS_COMM_AREA = '';
     END;
   END;

   WS_CA_LEN = 102;
   EXEC CICS RETURN TRANSID('ODAC')
        COMMAREA(WS_COMM_AREA)
        LENGTH(WS_CA_LEN)
        RESP(WS_CICS_RESP)
        RESP2(WS_CICS_RESP2) ;

   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
     ABNDINFO_REC = '';
     ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
     ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
     EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
     ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
     ABND_TRANID     = EIBTRNID;
     CALL POPULATE_TIME_DATE;
     ABND_DATE  = WS_ORIG_DATE;
     ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                  SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                  SUBSTR(WS_TIME_NOW,5,2);
     ABND_UTIME_KEY = WS_U_TIME;
     ABND_CODE      = 'HBNK';
     EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
     ABND_SQLCODE  = '0';
     ABND_FREEFORM =
       'A010 - RETURN TRANSID(ODAC) FAIL.' ||
       ' EIBRESP=' || ABND_RESPCODE ||
       ' RESP2='   || ABND_RESP2CODE;
     WS_CA_LEN = SIZE(ABNDINFO_REC);
     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                    COMMAREA(ABNDINFO_REC)
                    LENGTH(WS_CA_LEN) ;
     WS_FAIL_INFO = '';
     WS_CICS_FAIL_MSG  =
       'BNK1DAC - A010 - RETURN TRANSID(ODAC) FAIL';
     WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
     WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
     CALL ABEND_THIS_TASK;
   END;

   /* =============================================================== */
   /*  PROCESS_MAP (PROCESS-MAP SECTION)                             */
   /* =============================================================== */
   PROCESS_MAP: PROCEDURE;

     CALL RECEIVE_MAP;

     IF EIBAID = DFHENTER THEN DO;
       CALL EDIT_DATA;
       IF VALID_DATA_SW = 'Y' THEN
         CALL GET_ACC_DATA;
       ELSE
         DELACC_COMMAREA = '';
     END;

     IF EIBAID = DFHPF5 THEN DO;
       CALL VALIDATE_DATA;
       IF VALID_DATA_SW = 'Y' THEN
         CALL DEL_ACC_DATA;
     END;

     SEND_FLAG = SEND_DATAONLY_ALARM_C;
     CALL SEND_MAP;

   END PROCESS_MAP;

   /* =============================================================== */
   /*  RECEIVE_MAP (RECEIVE-MAP SECTION)                              */
   /* =============================================================== */
   RECEIVE_MAP: PROCEDURE;

     EXEC CICS RECEIVE MAP('BNK1DA')
          MAPSET('BNK1DAM')
          INTO(BNK1DAI)
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2) ;

     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       ABNDINFO_REC = '';
       ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
       ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
       EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
       ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
       ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABND_DATE  = WS_ORIG_DATE;
       ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                    SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                    SUBSTR(WS_TIME_NOW,5,2);
       ABND_UTIME_KEY = WS_U_TIME;
       ABND_CODE      = 'HBNK';
       EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
       ABND_SQLCODE  = '0';
       ABND_FREEFORM =
         'RM010 - RECEIVE MAP FAIL.' ||
         ' EIBRESP=' || ABND_RESPCODE ||
         ' RESP2='   || ABND_RESP2CODE;
       WS_CA_LEN = SIZE(ABNDINFO_REC);
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                      COMMAREA(ABNDINFO_REC)
                      LENGTH(WS_CA_LEN) ;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG  =
         'BNK1DAC - RM010 - RECEIVE MAP FAIL';
       WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
       WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
       CALL ABEND_THIS_TASK;
     END;

   END RECEIVE_MAP;

   /* =============================================================== */
   /*  EDIT_DATA (EDIT-DATA SECTION)                                  */
   /* =============================================================== */
   EDIT_DATA: PROCEDURE;

     IF ACCNOI = '' | ACCNOL = 0 THEN DO;
       MESSAGEO = 'Please enter an account number.';
       VALID_DATA_SW = 'N';
       RETURN;
     END;

     EXEC CICS BIF DEEDIT FIELD(ACCNOI) ;

     IF VERIFY(ACCNOI, '0123456789 ') ^= 0 THEN DO;
       MESSAGEO = 'Please enter an account number.';
       VALID_DATA_SW = 'N';
     END;

   END EDIT_DATA;

   /* =============================================================== */
   /*  VALIDATE_DATA (VALIDATE-DATA SECTION)                         */
   /* =============================================================== */
   VALIDATE_DATA: PROCEDURE;

     IF SORTCI = '' | SORTCI = '000000' THEN DO;
       VALID_DATA_SW = 'N';
       MESSAGEO = 'Please enter an account number.';
       ACCNOL = -1;
     END;

   END VALIDATE_DATA;

   /* =============================================================== */
   /*  GET_ACC_DATA (GET-ACC-DATA SECTION)                           */
   /* =============================================================== */
   GET_ACC_DATA: PROCEDURE;

     INQACC_COMMAREA = '';
     INQACC_PCB1_POINTER = SYSNULL();
     INQACC_ACCNO = ACCNOI;

     EXEC CICS LINK PROGRAM('INQACC')
          COMMAREA(INQACC_COMMAREA)
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2)
          SYNCONRETURN ;

     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       ABNDINFO_REC = '';
       ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
       ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
       EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
       ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
       ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABND_DATE  = WS_ORIG_DATE;
       ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                    SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                    SUBSTR(WS_TIME_NOW,5,2);
       ABND_UTIME_KEY = WS_U_TIME;
       ABND_CODE      = 'HBNK';
       EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
       ABND_SQLCODE  = '0';
       ABND_FREEFORM =
         'GAD010  - LINK INQACC FAIL.' ||
         ' EIBRESP=' || ABND_RESPCODE ||
         ' RESP2='   || ABND_RESP2CODE;
       WS_CA_LEN = SIZE(ABNDINFO_REC);
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                      COMMAREA(ABNDINFO_REC)
                      LENGTH(WS_CA_LEN) ;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG  =
         'BNK1DAC - GAD010 - LINK INQACC  FAIL';
       WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
       WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
       CALL ABEND_THIS_TASK;
     END;

     /* Check if account was found */
     IF INQACC_ACC_TYPE = ' ' &
        INQACC_INT_RATE = 0   &
        INQACC_SUCCESS  = 'N' THEN DO;
       MESSAGEO =
         'Sorry, but that account number was not found.';
       VALID_DATA_SW = 'N';
       SORTCO    = ' ';
       CUSTNOO   = ' ';
       ACCNO2O   = ' ';
       ACTYPEO   = ' ';
       INTRTO    = ' ';
       COMM_OPENED_SPLIT = '';
       OPENDDO   = ' ';
       OPENMMO   = ' ';
       OPENYYO   = ' ';
       OVERDRO   = ' ';
       COMM_LAST_ST_SPLIT = '';
       LSTMTDDO  = ' ';
       LSTMTMMO  = ' ';
       LSTMTYYO  = ' ';
       COMM_NEXT_ST_SPLIT = '';
       NSTMTDDO  = ' ';
       NSTMTMMO  = ' ';
       NSTMTYYO  = ' ';
       AVBALO    = ' ';
       ACTBALO   = ' ';
       RETURN;
     END;

     /* Populate map output fields */
     SORTCO  = INQACC_SCODE;
     CUSTNOO = INQACC_CUSTNO;
     ACCNO2O = INQACC_ACCNO;
     ACTYPEO = INQACC_ACC_TYPE;
     INTRTO  = CHAR(INQACC_INT_RATE);

     /* Opened date split */
     COMM_OPENED_SPLIT = CHAR(INQACC_OPENED);
     OPENDDO = COMM_OPENED_DD;
     OPENMMO = COMM_OPENED_MM;
     OPENYYO = COMM_OPENED_YY;

     /* Overdraft */
     OVERDRO = CHAR(INQACC_OVERDRAFT);

     /* Last statement date split */
     COMM_LAST_ST_SPLIT = CHAR(INQACC_LAST_STMT_DT);
     LSTMTDDO = COMM_LAST_ST_DD;
     LSTMTMMO = COMM_LAST_ST_MM;
     LSTMTYYO = COMM_LAST_ST_YY;

     /* Next statement date split */
     COMM_NEXT_ST_SPLIT = CHAR(INQACC_NEXT_STMT_DT);
     NSTMTDDO = COMM_NEXT_ST_DD;
     NSTMTMMO = COMM_NEXT_ST_MM;
     NSTMTYYO = COMM_NEXT_ST_YY;

     /* Balance fields */
     AVBALO  = CHAR(INQACC_AVAIL_BAL);
     ACTBALO = CHAR(INQACC_ACTUAL_BAL);

     MESSAGEO = ' ';
     MESSAGEO =
       'If you wish to delete the Account press <PF5>.';

   END GET_ACC_DATA;

   /* =============================================================== */
   /*  DEL_ACC_DATA (DEL-ACC-DATA SECTION)                           */
   /* =============================================================== */
   DEL_ACC_DATA: PROCEDURE;

     DELACC_COMMAREA = '';
     DELACC_ACCNO = ACCNO2I;
     DELACC_DEL_PCB1 = SYSNULL();
     DELACC_DEL_PCB2 = SYSNULL();
     DELACC_DEL_PCB3 = SYSNULL();

     EXEC CICS LINK PROGRAM('DELACC')
          COMMAREA(DELACC_COMMAREA)
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2)
          SYNCONRETURN ;

     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG  =
         'BNK1DAC - DAD010 - LINK DELACC  FAIL';
       WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
       WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
       CALL ABEND_THIS_TASK;
     END;

     /* Account not found */
     IF DELACC_DEL_SUCCESS = 'N' &
        DELACC_DEL_FAIL_CD = '1' THEN DO;
       MESSAGEO = ' ';
       MESSAGEO =
         'Sorry, but that account number was not found.'
         || ' Account NOT deleted.';
       VALID_DATA_SW = 'N';
       SORTCO = DELACC_SCODE;
       RETURN;
     END;

     /* Datastore error */
     IF DELACC_DEL_SUCCESS = 'N' &
        DELACC_DEL_FAIL_CD = '2' THEN DO;
       MESSAGEO = ' ';
       MESSAGEO =
         'Sorry, but a datastore error occurred.'
         || ' Account NOT deleted.';
       VALID_DATA_SW = 'N';
       SORTCO = DELACC_SCODE;
       RETURN;
     END;

     /* Delete error (code 3) */
     IF DELACC_DEL_SUCCESS = 'N' &
        DELACC_DEL_FAIL_CD = '3' THEN DO;
       MESSAGEO = ' ';
       MESSAGEO =
         'Sorry, but a delete error occurred.'
         || ' Account NOT deleted.';
       VALID_DATA_SW = 'N';
       SORTCO = DELACC_SCODE;
       RETURN;
     END;

     /* Any other failure */
     IF DELACC_DEL_SUCCESS = 'N' THEN DO;
       MESSAGEO = ' ';
       MESSAGEO =
         'Sorry, but a delete error occurred.'
         || ' Account NOT deleted.';
       VALID_DATA_SW = 'N';
       SORTCO = DELACC_SCODE;
       RETURN;
     END;

     /* Success - clear the map fields */
     SORTCO   = ' ';
     CUSTNOO  = ' ';
     ACCNO2O  = ' ';
     ACTYPEO  = ' ';
     INTRTO   = ' ';
     OPENDDO  = ' ';
     OPENMMO  = ' ';
     OPENYYO  = ' ';
     OVERDRO  = ' ';
     LSTMTDDO = ' ';
     LSTMTMMO = ' ';
     LSTMTYYO = ' ';
     NSTMTDDO = ' ';
     NSTMTMMO = ' ';
     NSTMTYYO = ' ';
     AVBALO   = ' ';
     ACTBALO  = ' ';
     MESSAGEO = ' ';
     MESSAGEO = 'Account ' || DELACC_ACCNO ||
                ' was successfully deleted.';

   END DEL_ACC_DATA;

   /* =============================================================== */
   /*  SEND_MAP (SEND-MAP SECTION)                                    */
   /* =============================================================== */
   SEND_MAP: PROCEDURE;

     /* SEND-ERASE */
     IF SEND_FLAG = SEND_ERASE_C THEN DO;
       EXEC CICS SEND MAP('BNK1DA')
            MAPSET('BNK1DAM')
            FROM(BNK1DAO)
            ERASE
            FREEKB
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2) ;

       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         ABNDINFO_REC = '';
         ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
         ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
         EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
         ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
         ABND_TRANID     = EIBTRNID;
         CALL POPULATE_TIME_DATE;
         ABND_DATE  = WS_ORIG_DATE;
         ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                      SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                      SUBSTR(WS_TIME_NOW,5,2);
         ABND_UTIME_KEY = WS_U_TIME;
         ABND_CODE      = 'HBNK';
         EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
         ABND_SQLCODE  = '0';
         ABND_FREEFORM =
           'SM010 - SEND MAP ERASE FAIL.' ||
           ' EIBRESP=' || ABND_RESPCODE ||
           ' RESP2='   || ABND_RESP2CODE;
         WS_CA_LEN = SIZE(ABNDINFO_REC);
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                        COMMAREA(ABNDINFO_REC)
                        LENGTH(WS_CA_LEN) ;
         WS_FAIL_INFO = '';
         WS_CICS_FAIL_MSG  =
           'BNK1DAC - SM010 - SEND MAP ERASE FAIL';
         WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
         WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;

     /* SEND-DATAONLY */
     IF SEND_FLAG = SEND_DATAONLY_C THEN DO;
       IF MESSAGEO ^= ' ' & MESSAGEO ^= '' THEN
         MESSAGEO = 'Account lookup successful.';

       EXEC CICS SEND MAP('BNK1DA')
            MAPSET('BNK1DAM')
            FROM(BNK1DAO)
            DATAONLY
            FREEKB
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2) ;

       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         ABNDINFO_REC = '';
         ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
         ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
         EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
         ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
         ABND_TRANID     = EIBTRNID;
         CALL POPULATE_TIME_DATE;
         ABND_DATE  = WS_ORIG_DATE;
         ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                      SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                      SUBSTR(WS_TIME_NOW,5,2);
         ABND_UTIME_KEY = WS_U_TIME;
         ABND_CODE      = 'HBNK';
         EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
         ABND_SQLCODE  = '0';
         ABND_FREEFORM =
           'SM010 - SEND MAP DATAONLY FAIL.' ||
           ' EIBRESP=' || ABND_RESPCODE ||
           ' RESP2='   || ABND_RESP2CODE;
         WS_CA_LEN = SIZE(ABNDINFO_REC);
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                        COMMAREA(ABNDINFO_REC)
                        LENGTH(WS_CA_LEN) ;
         WS_FAIL_INFO = '';
         WS_CICS_FAIL_MSG  =
           'BNK1DAC - SM010 - SEND MAP DATAONLY FAIL';
         WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
         WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;

     /* SEND-DATAONLY-ALARM */
     IF SEND_FLAG = SEND_DATAONLY_ALARM_C THEN DO;
       EXEC CICS SEND MAP('BNK1DA')
            MAPSET('BNK1DAM')
            FROM(BNK1DAO)
            DATAONLY
            ALARM
            FREEKB
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2) ;

       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         ABNDINFO_REC = '';
         ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
         ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
         EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
         ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
         ABND_TRANID     = EIBTRNID;
         CALL POPULATE_TIME_DATE;
         ABND_DATE  = WS_ORIG_DATE;
         ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                      SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                      SUBSTR(WS_TIME_NOW,5,2);
         ABND_UTIME_KEY = WS_U_TIME;
         ABND_CODE      = 'HBNK';
         EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
         ABND_SQLCODE  = '0';
         ABND_FREEFORM =
           'SM010 - SEND MAP DATAONLY ALARM FAIL.' ||
           ' EIBRESP=' || ABND_RESPCODE ||
           ' RESP2='   || ABND_RESP2CODE;
         WS_CA_LEN = SIZE(ABNDINFO_REC);
         EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                        COMMAREA(ABNDINFO_REC)
                        LENGTH(WS_CA_LEN) ;
         WS_FAIL_INFO = '';
         WS_CICS_FAIL_MSG  =
           'BNK1DAC - SM010 - SEND MAP ALARM FAIL';
         WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
         WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;

   END SEND_MAP;

   /* =============================================================== */
   /*  SEND_TERMINATION_MSG (SEND-TERMINATION-MSG SECTION)           */
   /* =============================================================== */
   SEND_TERMINATION_MSG: PROCEDURE;

     EXEC CICS SEND TEXT
          FROM(END_OF_SESSION_MSG)
          ERASE
          FREEKB
          RESP(WS_CICS_RESP)
          RESP2(WS_CICS_RESP2) ;

     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       ABNDINFO_REC = '';
       ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
       ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
       EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
       ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
       ABND_TRANID     = EIBTRNID;
       CALL POPULATE_TIME_DATE;
       ABND_DATE  = WS_ORIG_DATE;
       ABND_TIME  = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                    SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                    SUBSTR(WS_TIME_NOW,5,2);
       ABND_UTIME_KEY = WS_U_TIME;
       ABND_CODE      = 'HBNK';
       EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
       ABND_SQLCODE  = '0';
       ABND_FREEFORM =
         'STM010 - SEND TEXT FAIL.' ||
         ' EIBRESP=' || ABND_RESPCODE ||
         ' RESP2='   || ABND_RESP2CODE;
       WS_CA_LEN = SIZE(ABNDINFO_REC);
       EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                      COMMAREA(ABNDINFO_REC)
                      LENGTH(WS_CA_LEN) ;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG  =
         'BNK1DAC - STM010 - SEND TEXT FAIL';
       WS_CICS_RESP_DISP  = SUBSTR(CHAR(WS_CICS_RESP),  1, 10);
       WS_CICS_RESP2_DISP = SUBSTR(CHAR(WS_CICS_RESP2), 1, 10);
       CALL ABEND_THIS_TASK;
     END;

   END SEND_TERMINATION_MSG;

   /* =============================================================== */
   /*  ABEND_THIS_TASK (ABEND-THIS-TASK SECTION)                     */
   /* =============================================================== */
   ABEND_THIS_TASK: PROCEDURE;

     EXEC CICS ABEND ABCODE('HBNK') NODUMP ;

   END ABEND_THIS_TASK;

   /* =============================================================== */
   /*  POPULATE_TIME_DATE (POPULATE-TIME-DATE SECTION)               */
   /* =============================================================== */
   POPULATE_TIME_DATE: PROCEDURE;

     EXEC CICS ASKTIME ABSTIME(WS_U_TIME) ;

     EXEC CICS FORMATTIME
          ABSTIME(WS_U_TIME)
          DDMMYYYY(WS_ORIG_DATE)
          TIME(WS_TIME_NOW)
          DATESEP ;

   END POPULATE_TIME_DATE;

   /* =============================================================== */
   /*  ABEND_HANDLING label (HANDLE ABEND target)                    */
   /* =============================================================== */
   ABEND_HANDLING:
     EXEC CICS RETURN ;

 END BNK1DAC;
