 *PROCESS CICS;
 /* ----------------------------------------------------------------- */
 /*  Copyright IBM Corp. 2023                                         */
 /*  CRDTAGY5 - Dummy Credit Agency 5 (container CIPE)               */
 /* ----------------------------------------------------------------- */
 CRDTAGY5: PROCEDURE OPTIONS(MAIN REENTRANT);

   %INCLUDE SORTCODE;
   %INCLUDE CUSTOMER;
   %INCLUDE ABNDINFO;

   DCL 1 WS_CONT_IN LIKE CUSTOMER_RECORD;
   DCL WS_CICS_RESP        FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2       FIXED BIN(31) INIT(0);
   DCL WS_DELAY_AMT        FIXED BIN(31) INIT(0);
   DCL WS_CONTAINER_NAME   CHAR(16)      INIT('CIPE            ');
   DCL WS_CHANNEL_NAME     CHAR(16)      INIT('CIPCREDCHANN    ');
   DCL WS_CONTAINER_LEN    FIXED BIN(31) INIT(0);
   DCL WS_NEW_CREDSCORE    FIXED DEC(3,0) INIT(0);
   DCL WS_SEED             FIXED DEC(15,0) INIT(0);
   DCL WS_U_TIME           FIXED DEC(15,0) INIT(0);
   DCL WS_ORIG_DATE        CHAR(10);
   DCL WS_TIME_NOW         CHAR(6);
   DCL WS_ABEND_PGM        CHAR(8) INIT('ABNDPROC');
   DCL WS_CA_LEN           FIXED BIN(15);

   WS_SEED = EIBTASKN;
   WS_DELAY_AMT = TRUNC(((3 - 1) * RAND(WS_SEED)) + 1);

   EXEC CICS DELAY FOR SECONDS(WS_DELAY_AMT)
        RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2) ;

   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
     ABND_RESPCODE  = SUBSTR(CHAR(EIBRESP),  1, 10);
     ABND_RESP2CODE = SUBSTR(CHAR(EIBRESP2), 1, 10);
     EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
     ABND_TASKNO_KEY = SUBSTR(CHAR(EIBTASKN), 1, 4);
     ABND_TRANID     = EIBTRNID;
     CALL POPULATE_TIME_DATE;
     ABND_DATE = WS_ORIG_DATE;
     ABND_TIME = SUBSTR(WS_TIME_NOW,1,2)||':'||
                 SUBSTR(WS_TIME_NOW,3,2)||':'||SUBSTR(WS_TIME_NOW,5,2);
     ABND_UTIME_KEY = WS_U_TIME;
     ABND_CODE = 'PLOP';
     EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
     ABND_SQLCODE  = '0';
     ABND_FREEFORM = 'A010 - DELAY FAILED EIBRESP='||
                     SUBSTR(CHAR(EIBRESP),1,10);
     WS_CA_LEN = SIZE(ABNDINFO_REC);
     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                    COMMAREA(ABNDINFO_REC) LENGTH(WS_CA_LEN) ;
     PUT SKIP LIST('*** The delay messed up ! ***');
     EXEC CICS ABEND ABCODE('PLOP') ;
   END;

   WS_CONTAINER_LEN = SIZE(WS_CONT_IN);
   EXEC CICS GET CONTAINER(WS_CONTAINER_NAME)
                 CHANNEL(WS_CHANNEL_NAME)
                 INTO(WS_CONT_IN) FLENGTH(WS_CONTAINER_LEN)
                 RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2) ;
   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
     PUT SKIP LIST('CRDTAGY5 - UNABLE TO GET CONTAINER.');
     CALL GET_ME_OUT_OF_HERE;
   END;

   WS_NEW_CREDSCORE = TRUNC(((999 - 1) * RAND()) + 1);
   WS_CONT_IN.CUSTOMER_CREDIT_SCORE = WS_NEW_CREDSCORE;

   WS_CONTAINER_LEN = SIZE(WS_CONT_IN);
   EXEC CICS PUT CONTAINER(WS_CONTAINER_NAME)
                 FROM(WS_CONT_IN) FLENGTH(WS_CONTAINER_LEN)
                 CHANNEL(WS_CHANNEL_NAME)
                 RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2) ;
   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
     PUT SKIP LIST('CRDTAGY5 - UNABLE TO PUT CONTAINER.');
     CALL GET_ME_OUT_OF_HERE;
   END;

   CALL GET_ME_OUT_OF_HERE;

 GET_ME_OUT_OF_HERE: PROCEDURE;
   EXEC CICS RETURN ;
 END GET_ME_OUT_OF_HERE;

 POPULATE_TIME_DATE: PROCEDURE;
   EXEC CICS ASKTIME ABSTIME(WS_U_TIME) ;
   EXEC CICS FORMATTIME ABSTIME(WS_U_TIME)
        DDMMYYYY(WS_ORIG_DATE) TIME(WS_TIME_NOW) DATESEP ;
 END POPULATE_TIME_DATE;

 END CRDTAGY5;
