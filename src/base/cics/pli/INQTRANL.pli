 *PROCESS CICS,SQL;
 /* ----------------------------------------------------------------- */
 /*  Copyright IBM Corp. 2026                                         */
 /* ----------------------------------------------------------------- */
 /*  INQTRANL - Enquire Transaction List                              */
 /*                                                                   */
 /*  Retrieves a paginated list of transactions for an account from   */
 /*  the PROCTRAN table with optional date range filter.              */
 /*  Also returns a total count of matching transactions.             */
 /* ----------------------------------------------------------------- */
 INQTRANL: PROCEDURE OPTIONS(MAIN REENTRANT);

   /* ----------------------------------------------------------------*/
   /*  SQLCA - must be first EXEC SQL statement                       */
   /* ----------------------------------------------------------------*/
   EXEC SQL INCLUDE SQLCA;

   /* ----------------------------------------------------------------*/
   /*  PROCTRAN table declaration                                     */
   /* ----------------------------------------------------------------*/
   EXEC SQL DECLARE PROCTRAN TABLE
     ( PROCTRAN_EYECATCHER  CHAR(4),
       PROCTRAN_SORTCODE    CHAR(6)         NOT NULL,
       PROCTRAN_NUMBER      CHAR(8)         NOT NULL,
       PROCTRAN_DATE        DATE            NOT NULL,
       PROCTRAN_TIME        CHAR(6)         NOT NULL,
       PROCTRAN_REF         CHAR(12)        NOT NULL,
       PROCTRAN_TYPE        CHAR(3),
       PROCTRAN_DESC        CHAR(40),
       PROCTRAN_AMOUNT      DECIMAL(12,2) );

   /* ----------------------------------------------------------------*/
   /*  TRAN_CURSOR - transactions for account within date range       */
   /* ----------------------------------------------------------------*/
   EXEC SQL DECLARE TRAN_CURSOR CURSOR FOR
     SELECT PROCTRAN_EYECATCHER,
            PROCTRAN_SORTCODE,
            PROCTRAN_NUMBER,
            PROCTRAN_DATE,
            PROCTRAN_TIME,
            PROCTRAN_REF,
            PROCTRAN_TYPE,
            PROCTRAN_DESC,
            PROCTRAN_AMOUNT
     FROM   PROCTRAN
     WHERE  PROCTRAN_SORTCODE = :HV_QUERY_SORTCODE
     AND    PROCTRAN_NUMBER   = :HV_QUERY_ACCNO
     AND    PROCTRAN_DATE    >= :HV_QUERY_FROM_DATE
     AND    PROCTRAN_DATE    <= :HV_QUERY_TO_DATE
     ORDER BY PROCTRAN_DATE DESC,
              PROCTRAN_TIME DESC
     FOR FETCH ONLY;

   /* ----------------------------------------------------------------*/
   /*  TRAN_COUNT_CURSOR - count of matching transactions             */
   /* ----------------------------------------------------------------*/
   EXEC SQL DECLARE TRAN_COUNT_CURSOR CURSOR FOR
     SELECT COUNT(*)
     FROM   PROCTRAN
     WHERE  PROCTRAN_SORTCODE = :HV_QUERY_SORTCODE
     AND    PROCTRAN_NUMBER   = :HV_QUERY_ACCNO
     AND    PROCTRAN_DATE    >= :HV_QUERY_FROM_DATE
     AND    PROCTRAN_DATE    <= :HV_QUERY_TO_DATE;

   /* ----------------------------------------------------------------*/
   /*  Sort code constant                                             */
   /* ----------------------------------------------------------------*/
   %INCLUDE SORTCODE;

   /* ----------------------------------------------------------------*/
   /*  DB2 host variables for PROCTRAN table                          */
   /* ----------------------------------------------------------------*/
   DCL HV_PROCTRAN_EYECATCHER     CHAR(4);
   DCL HV_PROCTRAN_SORTCODE       CHAR(6);
   DCL HV_PROCTRAN_NUMBER         CHAR(8);
   DCL HV_PROCTRAN_DATE           CHAR(10);   /* DATE as CHAR(10)     */
   DCL HV_PROCTRAN_TIME           CHAR(6);
   DCL HV_PROCTRAN_REF            CHAR(12);
   DCL HV_PROCTRAN_TYPE           CHAR(3);
   DCL HV_PROCTRAN_DESC           CHAR(40);
   DCL HV_PROCTRAN_AMOUNT         FIXED DEC(12,2);

   /* Host variables for query parameters */
   DCL HV_QUERY_SORTCODE          CHAR(6);
   DCL HV_QUERY_ACCNO             CHAR(8);
   DCL HV_QUERY_FROM_DATE         CHAR(10);
   DCL HV_QUERY_TO_DATE           CHAR(10);
   DCL HV_QUERY_LIMIT             FIXED BIN(15) INIT(50);
   DCL HV_QUERY_OFFSET            FIXED BIN(31) INIT(0);

   /* ----------------------------------------------------------------*/
   /*  CICS response codes                                            */
   /* ----------------------------------------------------------------*/
   DCL WS_CICS_RESP               FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2              FIXED BIN(31) INIT(0);

   /* ----------------------------------------------------------------*/
   /*  Working counters                                               */
   /* ----------------------------------------------------------------*/
   DCL WS_TRANSACTION_COUNT       FIXED BIN(31) INIT(0);
   DCL WS_FETCH_COUNT             FIXED BIN(15) INIT(0);
   DCL WS_TOTAL_COUNT             FIXED BIN(31) INIT(0);
   DCL WS_SKIP_COUNT              FIXED BIN(31) INIT(0);
   DCL WS_ROW_COUNT               FIXED BIN(31) INIT(0);

   /* ----------------------------------------------------------------*/
   /*  Miscellaneous work variables                                   */
   /* ----------------------------------------------------------------*/
   DCL SQLCODE_DISPLAY             FIXED BIN(31);
   DCL MY_ABEND_CODE               CHAR(4);
   DCL WS_ABEND_PGM                CHAR(8)  INIT('ABNDPROC');
   DCL WS_CA_LEN                   FIXED BIN(15);

   /* Time / date working storage */
   DCL WS_U_TIME                   FIXED DEC(15,0) INIT(0);
   DCL WS_ORIG_DATE                CHAR(10);
   DCL WS_TIME_NOW                 CHAR(6);

   /* Date conversion working storage */
   DCL WS_DATE_ISO                 CHAR(10);
   DCL 1 WS_DATE_ISO_GRP BASED(ADDR(WS_DATE_ISO)),
         2 WS_DATE_ISO_YYYY        CHAR(4),
         2 WS_DATE_ISO_SEP1        CHAR(1),
         2 WS_DATE_ISO_MM          CHAR(2),
         2 WS_DATE_ISO_SEP2        CHAR(1),
         2 WS_DATE_ISO_DD          CHAR(2);
   DCL WS_DATE_YYYYMMDD            FIXED DEC(8,0) INIT(0);
   DCL WS_DATE_NUM_CHAR            CHAR(8);

   /* Transaction ID build area */
   DCL 1 WS_TRAN_ID_PARTS,
         2 WS_TRAN_ID_SC           CHAR(6),
         2 WS_TRAN_ID_SEP1         CHAR(1)  INIT('-'),
         2 WS_TRAN_ID_NUM          CHAR(8),
         2 WS_TRAN_ID_SEP2         CHAR(1)  INIT('-'),
         2 WS_TRAN_ID_DATE         CHAR(8),
         2 WS_TRAN_ID_SEP3         CHAR(1)  INIT('-'),
         2 WS_TRAN_ID_TIME         CHAR(6),
         2 WS_TRAN_ID_SEP4         CHAR(1)  INIT('-'),
         2 WS_TRAN_ID_REF          CHAR(12);

   /* ----------------------------------------------------------------*/
   /*  Abend info record                                              */
   /* ----------------------------------------------------------------*/
   %INCLUDE ABNDINFO;

   /* ----------------------------------------------------------------*/
   /*  COMMAREA (INQTRANL interface)                                  */
   /* ----------------------------------------------------------------*/
   DCL COMMAREA_PTR                POINTER;
   %INCLUDE INQTRANL;
   DCL 1 DFHCOMMAREA BASED(COMMAREA_PTR)
                     LIKE INQTRANL_COMMAREA;

   /* ================================================================*/
   /*  MAIN PROCEDURE LOGIC                                           */
   /* ================================================================*/

   WS_TRANSACTION_COUNT = 0;
   WS_FETCH_COUNT       = 0;
   WS_TOTAL_COUNT       = 0;

   /* Set up abend handler */
   EXEC CICS HANDLE ABEND LABEL(ABEND_HANDLING) ;

   /* Get the COMMAREA address */
   EXEC CICS ADDRESS
        COMMAREA(COMMAREA_PTR)
        RESP(WS_CICS_RESP)
        RESP2(WS_CICS_RESP2) ;

   /* Validate eyecatcher */
   IF INQTRANL_EYE = ' ' | INQTRANL_EYE = '' THEN
     INQTRANL_EYE = 'ITRL';

   /* Apply defaults if dates or limit not provided */
   IF INQTRANL_FROM_DATE = 0 THEN
     INQTRANL_FROM_DATE = 0;
   IF INQTRANL_TO_DATE = 0 THEN
     INQTRANL_TO_DATE = 99999999;
   IF INQTRANL_LIMIT = 0 THEN
     INQTRANL_LIMIT = 50;
   IF INQTRANL_LIMIT > 100 THEN
     INQTRANL_LIMIT = 100;

   /* Get total count */
   CALL GET_TOTAL_COUNT;

   /* Get transaction list */
   CALL READ_TRANSACTIONS_DB2;

   /* Return results to COMMAREA */
   INQTRANL_TOTAL_COUNT    = WS_TOTAL_COUNT;
   INQTRANL_RETURNED_COUNT = WS_FETCH_COUNT;
   INQTRANL_SUCCESS        = 'Y';

   CALL GET_ME_OUT_OF_HERE;

 /* ------------------------------------------------------------------*/
 /*  GET_TOTAL_COUNT - Count matching transactions via cursor         */
 /* ------------------------------------------------------------------*/
 GET_TOTAL_COUNT: PROCEDURE;

   /* Prepare query parameters */
   HV_QUERY_SORTCODE = INQTRANL_SORTCODE;
   HV_QUERY_ACCNO    = INQTRANL_ACCNO;

   /* Convert FROM_DATE YYYYMMDD to YYYY-MM-DD */
   WS_DATE_NUM_CHAR = CHAR(INQTRANL_FROM_DATE, 8);
   WS_DATE_ISO_YYYY = SUBSTR(WS_DATE_NUM_CHAR, 1, 4);
   WS_DATE_ISO_SEP1 = '-';
   WS_DATE_ISO_MM   = SUBSTR(WS_DATE_NUM_CHAR, 5, 2);
   WS_DATE_ISO_SEP2 = '-';
   WS_DATE_ISO_DD   = SUBSTR(WS_DATE_NUM_CHAR, 7, 2);
   HV_QUERY_FROM_DATE = WS_DATE_ISO;

   /* Convert TO_DATE YYYYMMDD to YYYY-MM-DD */
   WS_DATE_NUM_CHAR = CHAR(INQTRANL_TO_DATE, 8);
   WS_DATE_ISO_YYYY = SUBSTR(WS_DATE_NUM_CHAR, 1, 4);
   WS_DATE_ISO_SEP1 = '-';
   WS_DATE_ISO_MM   = SUBSTR(WS_DATE_NUM_CHAR, 5, 2);
   WS_DATE_ISO_SEP2 = '-';
   WS_DATE_ISO_DD   = SUBSTR(WS_DATE_NUM_CHAR, 7, 2);
   HV_QUERY_TO_DATE = WS_DATE_ISO;

   /* Open count cursor */
   EXEC SQL OPEN TRAN_COUNT_CURSOR ;

   IF SQLCODE ^= 0 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     CALL ABEND_ROUTINE;
   END;

   /* Fetch count */
   EXEC SQL FETCH TRAN_COUNT_CURSOR
     INTO :WS_TOTAL_COUNT ;

   IF SQLCODE ^= 0 & SQLCODE ^= 100 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     CALL ABEND_ROUTINE;
   END;

   /* Close count cursor */
   EXEC SQL CLOSE TRAN_COUNT_CURSOR ;

   IF SQLCODE ^= 0 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     CALL ABEND_ROUTINE;
   END;

 END GET_TOTAL_COUNT;

 /* ------------------------------------------------------------------*/
 /*  READ_TRANSACTIONS_DB2 - Open cursor, fetch paginated rows, close */
 /* ------------------------------------------------------------------*/
 READ_TRANSACTIONS_DB2: PROCEDURE;

   /* Prepare query parameters */
   HV_QUERY_SORTCODE = INQTRANL_SORTCODE;
   HV_QUERY_ACCNO    = INQTRANL_ACCNO;

   /* Convert FROM_DATE */
   WS_DATE_NUM_CHAR = CHAR(INQTRANL_FROM_DATE, 8);
   WS_DATE_ISO_YYYY = SUBSTR(WS_DATE_NUM_CHAR, 1, 4);
   WS_DATE_ISO_SEP1 = '-';
   WS_DATE_ISO_MM   = SUBSTR(WS_DATE_NUM_CHAR, 5, 2);
   WS_DATE_ISO_SEP2 = '-';
   WS_DATE_ISO_DD   = SUBSTR(WS_DATE_NUM_CHAR, 7, 2);
   HV_QUERY_FROM_DATE = WS_DATE_ISO;

   /* Convert TO_DATE */
   WS_DATE_NUM_CHAR = CHAR(INQTRANL_TO_DATE, 8);
   WS_DATE_ISO_YYYY = SUBSTR(WS_DATE_NUM_CHAR, 1, 4);
   WS_DATE_ISO_SEP1 = '-';
   WS_DATE_ISO_MM   = SUBSTR(WS_DATE_NUM_CHAR, 5, 2);
   WS_DATE_ISO_SEP2 = '-';
   WS_DATE_ISO_DD   = SUBSTR(WS_DATE_NUM_CHAR, 7, 2);
   HV_QUERY_TO_DATE = WS_DATE_ISO;

   HV_QUERY_LIMIT  = INQTRANL_LIMIT;
   HV_QUERY_OFFSET = INQTRANL_OFFSET;

   /* Open the transaction cursor */
   EXEC SQL OPEN TRAN_CURSOR ;

   IF SQLCODE ^= 0 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     CALL ABEND_ROUTINE;
   END;

   /* Fetch transaction rows */
   CALL FETCH_TRANSACTION_DATA;

   /* Close the transaction cursor */
   EXEC SQL CLOSE TRAN_CURSOR ;

   IF SQLCODE ^= 0 THEN DO;
     SQLCODE_DISPLAY = SQLCODE;
     CALL ABEND_ROUTINE;
   END;

 END READ_TRANSACTIONS_DB2;

 /* ------------------------------------------------------------------*/
 /*  FETCH_TRANSACTION_DATA - Fetch rows with offset pagination       */
 /* ------------------------------------------------------------------*/
 FETCH_TRANSACTION_DATA: PROCEDURE;

   WS_FETCH_COUNT = 0;
   WS_SKIP_COUNT  = 0;
   WS_ROW_COUNT   = 0;

   DO WHILE (SQLCODE ^= 100 & WS_FETCH_COUNT < HV_QUERY_LIMIT);

     EXEC SQL FETCH TRAN_CURSOR
       INTO :HV_PROCTRAN_EYECATCHER,
            :HV_PROCTRAN_SORTCODE,
            :HV_PROCTRAN_NUMBER,
            :HV_PROCTRAN_DATE,
            :HV_PROCTRAN_TIME,
            :HV_PROCTRAN_REF,
            :HV_PROCTRAN_TYPE,
            :HV_PROCTRAN_DESC,
            :HV_PROCTRAN_AMOUNT ;

     IF SQLCODE = 0 THEN DO;
       WS_ROW_COUNT = WS_ROW_COUNT + 1;

       /* Skip rows for OFFSET pagination */
       IF WS_SKIP_COUNT < HV_QUERY_OFFSET THEN
         WS_SKIP_COUNT = WS_SKIP_COUNT + 1;
       ELSE DO;
         /* Process this row - we are past the offset */
         WS_FETCH_COUNT = WS_FETCH_COUNT + 1;

         /* Convert DATE from YYYY-MM-DD to YYYYMMDD */
         WS_DATE_ISO      = HV_PROCTRAN_DATE;
         WS_DATE_YYYYMMDD = DEC(WS_DATE_ISO_YYYY || WS_DATE_ISO_MM ||
                                WS_DATE_ISO_DD, 8, 0);

         /* Build composite transaction ID */
         WS_TRAN_ID_SC   = HV_PROCTRAN_SORTCODE;
         WS_TRAN_ID_NUM  = HV_PROCTRAN_NUMBER;
         WS_TRAN_ID_DATE = CHAR(WS_DATE_YYYYMMDD, 8);
         WS_TRAN_ID_TIME = HV_PROCTRAN_TIME;
         WS_TRAN_ID_REF  = HV_PROCTRAN_REF;

         INQTRANL_TRAN_ID(WS_FETCH_COUNT)       =
           SUBSTR(WS_TRAN_ID_PARTS, 1, 50);
         INQTRANL_TRAN_SORTCODE(WS_FETCH_COUNT) = HV_PROCTRAN_SORTCODE;
         INQTRANL_TRAN_ACCNO(WS_FETCH_COUNT)    = HV_PROCTRAN_NUMBER;
         INQTRANL_TRAN_DATE(WS_FETCH_COUNT)     = WS_DATE_YYYYMMDD;
         INQTRANL_TRAN_TIME(WS_FETCH_COUNT)     =
           DEC(HV_PROCTRAN_TIME, 6, 0);
         INQTRANL_TRAN_REF(WS_FETCH_COUNT)      =
           DEC(HV_PROCTRAN_REF, 12, 0);
         INQTRANL_TRAN_TYPE(WS_FETCH_COUNT)     = HV_PROCTRAN_TYPE;
         INQTRANL_TRAN_DESC(WS_FETCH_COUNT)     = HV_PROCTRAN_DESC;
         INQTRANL_TRAN_AMOUNT(WS_FETCH_COUNT)   = HV_PROCTRAN_AMOUNT;
       END;
     END;
     ELSE DO;
       IF SQLCODE ^= 100 THEN DO;
         SQLCODE_DISPLAY = SQLCODE;
         CALL ABEND_ROUTINE;
       END;
     END;

   END; /* DO WHILE */

 END FETCH_TRANSACTION_DATA;

 /* ------------------------------------------------------------------*/
 /*  GET_ME_OUT_OF_HERE - Return control to CICS                      */
 /* ------------------------------------------------------------------*/
 GET_ME_OUT_OF_HERE: PROCEDURE;

   EXEC CICS RETURN ;

 END GET_ME_OUT_OF_HERE;

 /* ------------------------------------------------------------------*/
 /*  ABEND_ROUTINE - Standard DB2 error abend                         */
 /* ------------------------------------------------------------------*/
 ABEND_ROUTINE: PROCEDURE;

   ABNDINFO_REC       = '' ;
   ABND_RESPCODE      = SUBSTR(CHAR(EIBRESP),  1, 10);
   ABND_RESP2CODE     = SUBSTR(CHAR(EIBRESP2), 1, 10);
   EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
   ABND_TASKNO_KEY    = SUBSTR(CHAR(EIBTASKN), 1, 4);
   ABND_TRANID        = EIBTRNID;
   CALL POPULATE_TIME_DATE;
   ABND_DATE          = WS_ORIG_DATE;
   ABND_TIME          = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                        SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                        SUBSTR(WS_TIME_NOW,5,2);
   ABND_UTIME_KEY     = WS_U_TIME;
   ABND_CODE          = 'ITRL';
   EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
   ABND_SQLCODE       = SUBSTR(CHAR(SQLCODE_DISPLAY), 1, 10);
   ABND_FREEFORM      = 'INQTRANL - DB2 Error. SQLCODE=' ||
                        CHAR(SQLCODE_DISPLAY);
   WS_CA_LEN = SIZE(ABNDINFO_REC);
   EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                  COMMAREA(ABNDINFO_REC)
                  LENGTH(WS_CA_LEN) ;
   EXEC CICS ABEND ABCODE('ITRL') CANCEL NODUMP ;

 END ABEND_ROUTINE;

 /* ------------------------------------------------------------------*/
 /*  POPULATE_TIME_DATE - Get current date and time via CICS          */
 /* ------------------------------------------------------------------*/
 POPULATE_TIME_DATE: PROCEDURE;

   EXEC CICS ASKTIME ABSTIME(WS_U_TIME) ;

   EXEC CICS FORMATTIME
        ABSTIME(WS_U_TIME)
        DDMMYYYY(WS_ORIG_DATE)
        TIME(WS_TIME_NOW)
        DATESEP('/') ;

 END POPULATE_TIME_DATE;

 /* ------------------------------------------------------------------*/
 /*  ABEND_HANDLING - Handle CICS abends                              */
 /* ------------------------------------------------------------------*/
 ABEND_HANDLING:
   EXEC CICS ASSIGN ABCODE(MY_ABEND_CODE) ;

   ABNDINFO_REC       = '' ;
   ABND_RESPCODE      = SUBSTR(CHAR(EIBRESP),  1, 10);
   ABND_RESP2CODE     = SUBSTR(CHAR(EIBRESP2), 1, 10);
   EXEC CICS ASSIGN APPLID(ABND_APPLID) ;
   ABND_TASKNO_KEY    = SUBSTR(CHAR(EIBTASKN), 1, 4);
   ABND_TRANID        = EIBTRNID;
   CALL POPULATE_TIME_DATE;
   ABND_DATE          = WS_ORIG_DATE;
   ABND_TIME          = SUBSTR(WS_TIME_NOW,1,2) || ':' ||
                        SUBSTR(WS_TIME_NOW,3,2) || ':' ||
                        SUBSTR(WS_TIME_NOW,5,2);
   ABND_UTIME_KEY     = WS_U_TIME;
   ABND_CODE          = 'ITRL';
   EXEC CICS ASSIGN PROGRAM(ABND_PROGRAM) ;
   ABND_FREEFORM      = 'INQTRANL - Abend occurred';
   WS_CA_LEN = SIZE(ABNDINFO_REC);
   EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
                  COMMAREA(ABNDINFO_REC)
                  LENGTH(WS_CA_LEN) ;
   EXEC CICS RETURN ;

 END INQTRANL;
