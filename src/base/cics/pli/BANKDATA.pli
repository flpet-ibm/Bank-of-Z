 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* BANKDATA - Batch data population program                       */
 /* Populates CUSTOMER, ACCOUNT, and CONTROL DB2 tables with      */
 /* randomly generated test data.                                  */
 /*                                                                */
 /* Input parm: 'fffffff,ttttttt,sssssss,rrrrrrr'                  */
 /*   f = start customer number, t = end, s = step, r = rand seed */
 /***************************************************************** */
*PROCESS SQL MARGINS(1,72);
 BANKDATA: PROCEDURE OPTIONS(MAIN REENTRANT);

   /*****************************************************************/
   /* CUSTOMER DB2 table declaration                                */
   /*****************************************************************/
   EXEC SQL INCLUDE CUSTDB2;

   /*****************************************************************/
   /* ACCOUNT DB2 table declaration                                 */
   /*****************************************************************/
   EXEC SQL INCLUDE ACCDB2;

   /*****************************************************************/
   /* CONTROL DB2 table declaration                                 */
   /*****************************************************************/
   EXEC SQL INCLUDE CONTDB2;

   /*****************************************************************/
   /* SQLCA                                                         */
   /*****************************************************************/
   DCL 1 SQLCA,
     3 SQLCAID    CHAR(8),
     3 SQLCABC    FIXED BIN(31),
     3 SQLCODE    FIXED BIN(31),
     3 SQLERRM,
       5 SQLERRML FIXED BIN(15),
       5 SQLERRMC CHAR(70),
     3 SQLERRP    CHAR(8),
     3 SQLERRD    (6) FIXED BIN(31),
     3 SQLWARN,
       5 SQLWARN0 CHAR(1),
       5 SQLWARN1 CHAR(1),
       5 SQLWARN2 CHAR(1),
       5 SQLWARN3 CHAR(1),
       5 SQLWARN4 CHAR(1),
       5 SQLWARN5 CHAR(1),
       5 SQLWARN6 CHAR(1),
       5 SQLWARN7 CHAR(1),
     3 SQLSTATE   CHAR(5);

   /*****************************************************************/
   /* Sort code constant                                            */
   /*****************************************************************/
   %INCLUDE SORTCODE;

   /*****************************************************************/
   /* CUSTOMER host variables                                       */
   /*****************************************************************/
   DCL 1 HOST_CUSTOMER_ROW,
     3 HV_CUSTOMER_EYECATCHER    CHAR(4),
     3 HV_CUSTOMER_SORTCODE      CHAR(6),
     3 HV_CUSTOMER_NUMBER        CHAR(10),
     3 HV_CUSTOMER_TITLE         CHAR(10),
     3 HV_CUSTOMER_FIRST_NAME    CHAR(50),
     3 HV_CUSTOMER_LAST_NAME     CHAR(50),
     3 HV_CUSTOMER_DOB           FIXED BIN(31),
     3 HV_CUSTOMER_PHONE         CHAR(20),
     3 HV_CUSTOMER_ADDR_LINE1    CHAR(50),
     3 HV_CUSTOMER_ADDR_LINE2    CHAR(50),
     3 HV_CUSTOMER_CITY          CHAR(50),
     3 HV_CUSTOMER_POSTCODE      CHAR(10),
     3 HV_CUSTOMER_COUNTRY       CHAR(50),
     3 HV_CUSTOMER_STATUS        CHAR(10),
     3 HV_CUSTOMER_CREATE_DATE   FIXED BIN(31),
     3 HV_CUSTOMER_CREDIT_SCORE  FIXED BIN(15),
     3 HV_CUSTOMER_CS_REVIEW_DATE FIXED BIN(31);

   /*****************************************************************/
   /* ACCOUNT host variables                                        */
   /*****************************************************************/
   DCL 1 HOST_ACCOUNT_ROW,
     3 HV_ACCOUNT_EYECATCHER     CHAR(4),
     3 HV_ACCOUNT_CUST_NO        CHAR(10),
     3 HV_ACCOUNT_SORT_CODE      CHAR(6),
     3 HV_ACCOUNT_NUMBER         CHAR(8),
     3 HV_ACCOUNT_TYPE           CHAR(8),
     3 HV_ACCOUNT_INTEREST_RATE  FIXED DEC(6,2),
     3 * UNION,
       5 HV_ACCOUNT_OPENED       CHAR(10),
       5 HV_ACCOUNT_OPENED_GROUP,
         7 HV_ACCOUNT_OPENED_DAY    CHAR(2),
         7 HV_ACCOUNT_OPENED_DELIM1 CHAR(1),
         7 HV_ACCOUNT_OPENED_MONTH  CHAR(2),
         7 HV_ACCOUNT_OPENED_DELIM2 CHAR(1),
         7 HV_ACCOUNT_OPENED_YEAR   CHAR(4),
     3 HV_ACCOUNT_OVERDRAFT_LIMIT FIXED BIN(31),
     3 * UNION,
       5 HV_ACCOUNT_LAST_STMT_DATE CHAR(10),
       5 HV_ACCOUNT_LAST_STMT_GROUP,
         7 HV_ACCOUNT_LAST_STMT_DAY    CHAR(2),
         7 HV_ACCOUNT_LAST_STMT_DELIM1 CHAR(1),
         7 HV_ACCOUNT_LAST_STMT_MONTH  CHAR(2),
         7 HV_ACCOUNT_LAST_STMT_DELIM2 CHAR(1),
         7 HV_ACCOUNT_LAST_STMT_YEAR   CHAR(4),
     3 * UNION,
       5 HV_ACCOUNT_NEXT_STMT_DATE CHAR(10),
       5 HV_ACCOUNT_NEXT_STMT_GROUP,
         7 HV_ACCOUNT_NEXT_STMT_DAY    CHAR(2),
         7 HV_ACCOUNT_NEXT_STMT_DELIM1 CHAR(1),
         7 HV_ACCOUNT_NEXT_STMT_MONTH  CHAR(2),
         7 HV_ACCOUNT_NEXT_STMT_DELIM2 CHAR(1),
         7 HV_ACCOUNT_NEXT_STMT_YEAR   CHAR(4),
     3 HV_ACCOUNT_AVAILABLE_BALANCE FIXED DEC(12,2),
     3 HV_ACCOUNT_ACTUAL_BALANCE    FIXED DEC(12,2);

   /*****************************************************************/
   /* CONTROL host variables                                        */
   /*****************************************************************/
   DCL 1 HOST_CONTROL_ROW,
     3 HV_CONTROL_NAME          CHAR(32),
     3 HV_CONTROL_VALUE_NUM     FIXED BIN(31),
     3 HV_CONTROL_VALUE_STR     CHAR(40);

   /*****************************************************************/
   /* CUSTOMER working area                                         */
   /*****************************************************************/
   DCL 1 WS_CUSTOMER_RECORD,
   %INCLUDE CUSTOMER;

   /*****************************************************************/
   /* CUSTOMER CONTROL area                                         */
   /*****************************************************************/
   DCL 1 CUSTOMER_CONTROL,
   %INCLUDE CUSTCTRL;

   /*****************************************************************/
   /* ACCOUNT CONTROL area                                          */
   /*****************************************************************/
   DCL 1 ACCOUNT_CONTROL,
   %INCLUDE ACCTCTRL;

   /*****************************************************************/
   /* Reference data arrays                                         */
   /*****************************************************************/
   DCL FORENAME        (100) CHAR(20) INIT((100)' ');
   DCL FORENAMES_CNT   FIXED BIN(31) INIT(0);
   DCL FORENAMES_PTR   FIXED BIN(31) INIT(0);

   DCL STREET_NAME_TREE (26)  CHAR(20) INIT((26)' ');
   DCL STREET_NAME_T_CNT FIXED BIN(31) INIT(0);
   DCL STREET_NAME_T_PTR FIXED BIN(31) INIT(0);

   DCL STREET_NAME_ROAD (19)  CHAR(20) INIT((19)' ');
   DCL STREET_NAME_R_CNT FIXED BIN(31) INIT(0);
   DCL STREET_NAME_R_PTR FIXED BIN(31) INIT(0);

   DCL TOWN            (50)  CHAR(20) INIT((50)' ');
   DCL TOWN_COUNT      FIXED BIN(31) INIT(0);
   DCL TOWN_PTR        FIXED BIN(31) INIT(0);

   DCL INITIAL_CHARACTER (30) CHAR(1) INIT((30)' ');
   DCL INITIALS_CNT    FIXED BIN(31) INIT(0);
   DCL INITIALS_PTR    FIXED BIN(31) INIT(0);

   DCL TITLE_WORD      (36)  CHAR(9) INIT((36)' ');

   DCL SURNAME         (100) CHAR(20) INIT((100)' ');
   DCL SURNAMES_CNT    FIXED BIN(31) INIT(0);
   DCL SURNAMES_PTR    FIXED BIN(31) INIT(0);

   DCL WS_ACCOUNT_TYPE    (5) CHAR(8) INIT((5)' ');
   DCL ACCOUNT_TYPES_COUNT FIXED BIN(31) INIT(0);
   DCL ACCOUNT_TYPES_PTR   FIXED BIN(31) INIT(0);

   DCL WS_ACCOUNT_INT_RATE   (5) FIXED DEC(6,2) INIT((5)0);
   DCL ACCOUNT_INT_RATES_COUNT FIXED BIN(31) INIT(0);
   DCL ACCOUNT_INT_RATES_PTR   FIXED BIN(31) INIT(0);

   DCL WS_ACCOUNT_OVERDRAFT_LIM (5) FIXED BIN(31) INIT((5)0);
   DCL ACCOUNT_OVERDRAFT_COUNT  FIXED BIN(31) INIT(0);
   DCL ACCOUNT_OVERDRAFT_PTR    FIXED BIN(31) INIT(0);

   /*****************************************************************/
   /* Working variables                                             */
   /*****************************************************************/
   DCL START_KEY       FIXED BIN(31) INIT(0);
   DCL END_KEY         FIXED BIN(31) INIT(0);
   DCL STEP_KEY        FIXED BIN(31) INIT(0);
   DCL RANDOM_SEED_NUM FIXED BIN(31) INIT(0);
   DCL NEXT_KEY        FIXED BIN(31) INIT(0);
   DCL COMMIT_COUNT    FIXED BIN(31) INIT(0);
   DCL NO_OF_ACCOUNTS  FIXED BIN(31) INIT(0);
   DCL WS_ACCOUNT_NUMBER FIXED BIN(31) INIT(1);
   DCL WS_CNT          FIXED BIN(31) INIT(0);
   DCL TITLE_NUMBER    FIXED BIN(31) INIT(0);
   DCL HOUSE_NUMBER    FIXED BIN(31) INIT(0);
   DCL WS_POSTCODE_NUM FIXED BIN(31) INIT(0);

   DCL WS_TODAY_INT          FIXED BIN(31) INIT(0);
   DCL WS_REVIEW_DATE_ADD    FIXED BIN(31) INIT(0);
   DCL WS_NEW_REVIEW_DATE_INT FIXED BIN(31) INIT(0);
   DCL WS_NEW_REVIEW_YYYYMMDD CHAR(8)       INIT(' ');
   DCL WS_CURRENT_DATE_9     CHAR(8)        INIT(' ');

   DCL OPENED_DATE_ATTEMPTS  FIXED BIN(31) INIT(0);
   DCL OPENED_DATE_VALID     CHAR(1)       INIT('N');
   DCL WS_ACCOUNT_OPENED_DAY   FIXED BIN(31) INIT(0);
   DCL WS_ACCOUNT_OPENED_MONTH FIXED BIN(31) INIT(0);
   DCL WS_ACCOUNT_OPENED_YEAR  FIXED BIN(31) INIT(0);
   DCL WS_OVERDRAFT_CONVERSION FIXED BIN(31) INIT(0);

   DCL WS_SQLCODE_DISPLAY    CHAR(9)  INIT(' ');
   DCL DISP_REASON_CODE      CHAR(18) INIT(' ');

   /* For CEEGMT / CEEDATM timestamp */
   /* IBM LE callable services - resolved at link time */
   DCL CEEGMT  ENTRY EXT;
   DCL CEEDATM ENTRY EXT;
   DCL GMT_LILIAN     FIXED BIN(31) INIT(0);
   DCL GMT_SECONDS    FLOAT DEC(16) INIT(0);
   DCL PERIOD_NEXT    FLOAT DEC(16) INIT(0);
   DCL PERIOD_NEXT_F  CHAR(14) INIT(' ');
   DCL FC             CHAR(12) INIT(' ');
   DCL DATM_CONV      CHAR(80) INIT(' ');
   DCL 1 DATM_PICTURE,
     3 DATM_LENGTH    FIXED BIN(15) INIT(14),
     3 DATM_FORMAT    CHAR(14) INIT('YYYYMMDDHHMISS');
   DCL TIMESTAMP_FUNCTION CHAR(40) INIT(' ');

   /* Parm parsing work variables */
   DCL PARM_DATA  CHAR(256) INIT(' ');
   DCL PARM_LEN   FIXED BIN(15) INIT(0);
   DCL PARM_WORK  CHAR(256) INIT(' ');
   DCL PARM_POS   FIXED BIN(31) INIT(1);
   DCL PARM_FIELD (4) CHAR(10) INIT((4)' ');
   DCL I FIXED BIN(31) INIT(0);
   DCL J FIXED BIN(31) INIT(0);

   DCL LAST_CUSTOMER_NUMBER CHAR(10) INIT(' ');
   DCL LAST_ACCOUNT_NUMBER  CHAR(8)  INIT(' ');
   DCL NUMBER_OF_CUSTOMERS  FIXED BIN(31) INIT(0);
   DCL NUMBER_OF_ACCOUNTS_TOTAL FIXED BIN(31) INIT(0);
   DCL STOP_CODE            FIXED BIN(31) INIT(0);

   /*****************************************************************/
   /* MAIN PROCEDURE                                                */
   /*****************************************************************/
   TIMESTAMP_FUNCTION = 'Starting BANKDATA';
   CALL DO_TIMESTAMP;

   CALL INITIALISE_ARRAYS;

   /* Parse parm: START,END,STEP,SEED */
   CALL PARSE_PARM;

   IF END_KEY < START_KEY THEN DO;
     PUT SKIP LIST('Final customer number cannot be smaller than' ||
                   ' first customer number');
     STOP_CODE = 12;
     CALL PROGRAM_DONE;
   END;
   IF STEP_KEY = 0 THEN DO;
     PUT SKIP LIST('Gap between customers cannot be zero');
     STOP_CODE = 12;
     CALL PROGRAM_DONE;
   END;

   CALL GET_TODAYS_DATE;

   CALL DELETE_DB2_ROWS;

   /* Seed the random number generator */
   WS_ACCOUNT_OPENED_DAY = RANDOM(RANDOM_SEED_NUM);
   FORENAMES_PTR = TRUNC(FORENAMES_CNT * RANDOM()) + 1;
   INITIALS_PTR  = TRUNC(INITIALS_CNT  * RANDOM()) + 1;
   SURNAMES_PTR  = TRUNC(SURNAMES_CNT  * RANDOM()) + 1;
   TOWN_PTR      = TRUNC(TOWN_COUNT    * RANDOM()) + 1;
   STREET_NAME_R_PTR = TRUNC(STREET_NAME_R_CNT * RANDOM()) + 1;
   STREET_NAME_T_PTR = TRUNC(STREET_NAME_T_CNT * RANDOM()) + 1;
   ACCOUNT_TYPES_PTR = TRUNC(ACCOUNT_TYPES_COUNT * RANDOM()) + 1;

   /* Populate CUSTOMER and ACCOUNT tables */
   TIMESTAMP_FUNCTION = 'Populating Customer + Account tables';
   CALL DO_TIMESTAMP;
   COMMIT_COUNT         = 0;
   LAST_CUSTOMER_NUMBER = ' ';
   NUMBER_OF_CUSTOMERS  = 0;
   LAST_ACCOUNT_NUMBER  = ' ';
   NUMBER_OF_ACCOUNTS_TOTAL = 0;

   NEXT_KEY = START_KEY;
   DO WHILE (NEXT_KEY <= END_KEY);

     WS_CUSTOMER_RECORD = '';

     CUSTOMER_EYECATCHER = 'CUST';
     CUSTOMER_NUMBER     = SUBSTR(CHAR(NEXT_KEY + 10000000000), 2, 10);
     LAST_CUSTOMER_NUMBER = CUSTOMER_NUMBER;
     NUMBER_OF_CUSTOMERS  = NUMBER_OF_CUSTOMERS + 1;

     TITLE_NUMBER      = TRUNC((35 * RANDOM()) + 1);
     FORENAMES_PTR     = TRUNC(((FORENAMES_CNT - 1) * RANDOM()) + 1);
     INITIALS_PTR      = TRUNC(((INITIALS_CNT  - 1) * RANDOM()) + 1);
     SURNAMES_PTR      = TRUNC(((SURNAMES_CNT  - 1) * RANDOM()) + 1);
     HOUSE_NUMBER      = TRUNC((99 * RANDOM()) + 1);
     STREET_NAME_T_PTR = TRUNC(((STREET_NAME_T_CNT - 1)
                               * RANDOM()) + 1);
     STREET_NAME_R_PTR = TRUNC(((STREET_NAME_R_CNT - 1)
                               * RANDOM()) + 1);
     TOWN_PTR          = TRUNC(((TOWN_COUNT - 1) * RANDOM()) + 1);

     CUSTOMER_NAME     = ' ';
     CUSTOMER_PHONE    = ' ';
     CUSTOMER_ADDRESS  = ' ';
     CUSTOMER_STATUS   = ' ';

     CUSTOMER_TITLE    = TITLE_WORD(TITLE_NUMBER);
     CUSTOMER_FIRST_NAME = TRIM(FORENAME(FORENAMES_PTR)) || ' ' ||
                           TRIM(CHAR(INITIAL_CHARACTER(INITIALS_PTR)));
     CUSTOMER_LAST_NAME  = SURNAME(SURNAMES_PTR);

     CUSTOMER_ADDR_LINE1 =
       TRIM(CHAR(HOUSE_NUMBER)) || ' ' ||
       TRIM(STREET_NAME_TREE(STREET_NAME_T_PTR)) || ' ' ||
       TRIM(STREET_NAME_ROAD(STREET_NAME_R_PTR));
     CUSTOMER_CITY     = TOWN(TOWN_PTR);

     WS_POSTCODE_NUM = TRUNC(((99 - 10) * RANDOM()) + 10);
     CUSTOMER_POSTCODE = 'SW' || CHAR(WS_POSTCODE_NUM) || ' 3CD';

     CUSTOMER_COUNTRY  = 'United Kingdom';
     CUSTOMER_STATUS   = 'ACTIVE';

     CUSTOMER_DOB_DAY   = SUBSTR(CHAR(TRUNC((28 - 1) * RANDOM())
                                      + 1 + 100), 2, 2);
     CUSTOMER_DOB_MONTH = SUBSTR(CHAR(TRUNC((12 - 1) * RANDOM())
                                      + 1 + 100), 2, 2);
     CUSTOMER_DOB_YEAR  = CHAR(TRUNC((2000 - 1900) * RANDOM()) + 1900);

     CUSTOMER_SORTCODE  = SORTCODE;

     CUSTOMER_CREDIT_SCORE =
       SUBSTR(CHAR(TRUNC((999 - 1) * RANDOM()) + 1 + 1000), 2, 3);

     /* CS review date: today + 1-21 days */
     WS_REVIEW_DATE_ADD = TRUNC((21 - 1) * RANDOM()) + 1;
     WS_NEW_REVIEW_DATE_INT = WS_TODAY_INT + WS_REVIEW_DATE_ADD;
     WS_NEW_REVIEW_YYYYMMDD =
       DAYSTODATE(WS_NEW_REVIEW_DATE_INT, 'YYYYMMDD');
     CUSTOMER_CS_REVIEW_DAY   = SUBSTR(WS_NEW_REVIEW_YYYYMMDD, 7, 2);
     CUSTOMER_CS_REVIEW_MONTH = SUBSTR(WS_NEW_REVIEW_YYYYMMDD, 5, 2);
     CUSTOMER_CS_REVIEW_YEAR  = SUBSTR(WS_NEW_REVIEW_YYYYMMDD, 1, 4);

     /* Created date = today */
     CUSTOMER_CREATED_YEAR  = SUBSTR(WS_CURRENT_DATE_9, 1, 4);
     CUSTOMER_CREATED_MONTH = SUBSTR(WS_CURRENT_DATE_9, 5, 2);
     CUSTOMER_CREATED_DAY   = SUBSTR(WS_CURRENT_DATE_9, 7, 2);

     /* Populate CUSTOMER host variables */
     HV_CUSTOMER_EYECATCHER  = 'CUST';
     HV_CUSTOMER_SORTCODE    = CUSTOMER_SORTCODE;
     HV_CUSTOMER_NUMBER      = CUSTOMER_NUMBER;
     HV_CUSTOMER_TITLE       = CUSTOMER_TITLE;
     HV_CUSTOMER_FIRST_NAME  = CUSTOMER_FIRST_NAME;
     HV_CUSTOMER_LAST_NAME   = CUSTOMER_LAST_NAME;
     HV_CUSTOMER_PHONE       = CUSTOMER_PHONE;
     HV_CUSTOMER_ADDR_LINE1  = CUSTOMER_ADDR_LINE1;
     HV_CUSTOMER_ADDR_LINE2  = CUSTOMER_ADDR_LINE2;
     HV_CUSTOMER_CITY        = CUSTOMER_CITY;
     HV_CUSTOMER_POSTCODE    = CUSTOMER_POSTCODE;
     HV_CUSTOMER_COUNTRY     = CUSTOMER_COUNTRY;
     HV_CUSTOMER_STATUS      = CUSTOMER_STATUS;

     /* DOB as INTEGER (YYYYMMDD) */
     HV_CUSTOMER_DOB =
       (CUSTOMER_DOB_YEAR * 10000) +
       (CUSTOMER_DOB_MONTH * 100) +
       CUSTOMER_DOB_DAY;

     /* Created date as INTEGER */
     HV_CUSTOMER_CREATE_DATE =
       (CUSTOMER_CREATED_YEAR * 10000) +
       (CUSTOMER_CREATED_MONTH * 100) +
       CUSTOMER_CREATED_DAY;

     HV_CUSTOMER_CREDIT_SCORE    = CUSTOMER_CREDIT_SCORE;

     /* CS review date as INTEGER */
     HV_CUSTOMER_CS_REVIEW_DATE =
       (CUSTOMER_CS_REVIEW_YEAR * 10000) +
       (CUSTOMER_CS_REVIEW_MONTH * 100) +
       CUSTOMER_CS_REVIEW_DAY;

     EXEC SQL
       INSERT INTO CUSTOMER
              (CUSTOMER_EYECATCHER, CUSTOMER_SORTCODE,
               CUSTOMER_NUMBER, CUSTOMER_TITLE,
               CUSTOMER_FIRST_NAME, CUSTOMER_LAST_NAME,
               CUSTOMER_DATE_OF_BIRTH, CUSTOMER_PHONE,
               CUSTOMER_ADDR_LINE1, CUSTOMER_ADDR_LINE2,
               CUSTOMER_CITY, CUSTOMER_POSTCODE,
               CUSTOMER_COUNTRY, CUSTOMER_STATUS,
               CUSTOMER_CREATED_DATE, CUSTOMER_CREDIT_SCORE,
               CUSTOMER_CS_REVIEW_DATE)
       VALUES (:HV_CUSTOMER_EYECATCHER, :HV_CUSTOMER_SORTCODE,
               :HV_CUSTOMER_NUMBER, :HV_CUSTOMER_TITLE,
               :HV_CUSTOMER_FIRST_NAME, :HV_CUSTOMER_LAST_NAME,
               :HV_CUSTOMER_DOB, :HV_CUSTOMER_PHONE,
               :HV_CUSTOMER_ADDR_LINE1, :HV_CUSTOMER_ADDR_LINE2,
               :HV_CUSTOMER_CITY, :HV_CUSTOMER_POSTCODE,
               :HV_CUSTOMER_COUNTRY, :HV_CUSTOMER_STATUS,
               :HV_CUSTOMER_CREATE_DATE, :HV_CUSTOMER_CREDIT_SCORE,
               :HV_CUSTOMER_CS_REVIEW_DATE);

     IF SQLCODE ^= 0 THEN DO;
       WS_SQLCODE_DISPLAY = CHAR(SQLCODE);
       PUT SKIP LIST('Error inserting CUSTOMER row.' ||
                     ' CUSTOMER=' || HV_CUSTOMER_NUMBER ||
                     ' SORTCODE=' || HV_CUSTOMER_SORTCODE ||
                     ' SQLCODE=' || WS_SQLCODE_DISPLAY ||
                     ' SQLSTATE=' || SQLSTATE);
       STOP_CODE = 12;
       CALL PROGRAM_DONE;
     END;

     CALL DEFINE_ACC;

     COMMIT_COUNT = COMMIT_COUNT + 1;
     IF COMMIT_COUNT > 1000 THEN DO;
       EXEC SQL COMMIT WORK;
       COMMIT_COUNT = 0;
     END;

     NEXT_KEY = NEXT_KEY + STEP_KEY;
   END;  /* DO WHILE next_key */

   /* Update CONTROL table for customer count */
   HV_CONTROL_NAME = ' ';
   HV_CONTROL_NAME = 'BANKZCUST' || SORTCODE || '  ';
   HV_CONTROL_VALUE_NUM = LAST_CUSTOMER_NUMBER;

   EXEC SQL
     UPDATE CONTROL
        SET CONTROL_VALUE_NUM = :HV_CONTROL_VALUE_NUM
      WHERE CONTROL_NAME = :HV_CONTROL_NAME;

   IF SQLCODE = 100 THEN DO;
     HV_CONTROL_VALUE_STR = ' ';
     EXEC SQL
       INSERT INTO CONTROL
              (CONTROL_NAME, CONTROL_VALUE_NUM, CONTROL_VALUE_STR)
       VALUES (:HV_CONTROL_NAME, :HV_CONTROL_VALUE_NUM,
               :HV_CONTROL_VALUE_STR);
   END;

   /* Update ACCOUNT-LAST control */
   HV_CONTROL_NAME = ' ';
   HV_CONTROL_NAME = SORTCODE || '-' || 'ACCOUNT-LAST';
   HV_CONTROL_VALUE_NUM = LAST_ACCOUNT_NUMBER;
   HV_CONTROL_VALUE_STR = ' ';

   EXEC SQL
     UPDATE CONTROL
        SET CONTROL_VALUE_NUM = :HV_CONTROL_VALUE_NUM
      WHERE CONTROL_NAME = :HV_CONTROL_NAME;

   /* Update ACCOUNT-COUNT control */
   HV_CONTROL_NAME = ' ';
   HV_CONTROL_NAME = SORTCODE || '-' || 'ACCOUNT-COUNT';
   HV_CONTROL_VALUE_NUM = NUMBER_OF_ACCOUNTS_TOTAL;
   HV_CONTROL_VALUE_STR = ' ';

   EXEC SQL
     UPDATE CONTROL
        SET CONTROL_VALUE_NUM = :HV_CONTROL_VALUE_NUM
      WHERE CONTROL_NAME = :HV_CONTROL_NAME;

   /* Final commit */
   EXEC SQL COMMIT WORK;

   TIMESTAMP_FUNCTION = 'Finishing BANKDATA';
   CALL DO_TIMESTAMP;

   CALL PROGRAM_DONE;

   /*****************************************************************/
   /* PROGRAM_DONE - Finish program with return code                */
   /*****************************************************************/
   PROGRAM_DONE: PROC;
     CALL PLIRETC(STOP_CODE);
     STOP;
   END PROGRAM_DONE;

   /*****************************************************************/
   /* DEFINE_ACC - Decide number of accounts and populate them      */
   /*****************************************************************/
   DEFINE_ACC: PROC;
     NO_OF_ACCOUNTS = TRUNC((5 - 1) * RANDOM()) + 1;
     DO WS_CNT = 1 TO NO_OF_ACCOUNTS;
       CALL POPULATE_ACC;
     END;
     EXEC SQL COMMIT WORK;
   END DEFINE_ACC;

   /*****************************************************************/
   /* POPULATE_ACC - Generate and insert one account record        */
   /*****************************************************************/
   POPULATE_ACC: PROC;

     HV_ACCOUNT_OPENED_DAY   = '00';
     HV_ACCOUNT_OPENED_MONTH = '00';
     HV_ACCOUNT_OPENED_YEAR  = '0000';
     OPENED_DATE_ATTEMPTS    = 0;
     OPENED_DATE_VALID       = 'N';
     DO WHILE (OPENED_DATE_VALID = 'N');
       CALL GENERATE_OPENED_DATE;
     END;

     HV_ACCOUNT_EYECATCHER = 'ACCT';
     HV_ACCOUNT_CUST_NO    = CUSTOMER_NUMBER;
     HV_ACCOUNT_SORT_CODE  = SORTCODE;
     HV_ACCOUNT_NUMBER     =
       SUBSTR(CHAR(WS_ACCOUNT_NUMBER + 100000000), 2, 8);
     LAST_ACCOUNT_NUMBER   = HV_ACCOUNT_NUMBER;

     HV_ACCOUNT_TYPE            = WS_ACCOUNT_TYPE(WS_CNT);
     HV_ACCOUNT_INTEREST_RATE   = WS_ACCOUNT_INT_RATE(WS_CNT);
     HV_ACCOUNT_OPENED_DELIM1   = '.';
     HV_ACCOUNT_OPENED_DELIM2   = '.';
     WS_OVERDRAFT_CONVERSION    = WS_ACCOUNT_OVERDRAFT_LIM(WS_CNT);
     HV_ACCOUNT_OVERDRAFT_LIMIT = WS_OVERDRAFT_CONVERSION;

     HV_ACCOUNT_LAST_STMT_YEAR    = '2021';
     HV_ACCOUNT_LAST_STMT_DELIM1  = '.';
     HV_ACCOUNT_LAST_STMT_MONTH   = '07';
     HV_ACCOUNT_LAST_STMT_DELIM2  = '.';
     HV_ACCOUNT_LAST_STMT_DAY     = '01';
     HV_ACCOUNT_NEXT_STMT_YEAR    = '2021';
     HV_ACCOUNT_NEXT_STMT_DELIM1  = '.';
     HV_ACCOUNT_NEXT_STMT_MONTH   = '08';
     HV_ACCOUNT_NEXT_STMT_DELIM2  = '.';
     HV_ACCOUNT_NEXT_STMT_DAY     = '01';

     HV_ACCOUNT_AVAILABLE_BALANCE =
       TRUNC((999999 - 1) * RANDOM()) + 1;
     HV_ACCOUNT_ACTUAL_BALANCE = HV_ACCOUNT_AVAILABLE_BALANCE;

     IF HV_ACCOUNT_TYPE = 'LOAN    ' |
        HV_ACCOUNT_TYPE = 'MORTGAGE' THEN DO;
       HV_ACCOUNT_ACTUAL_BALANCE    = -HV_ACCOUNT_ACTUAL_BALANCE;
       HV_ACCOUNT_AVAILABLE_BALANCE = -HV_ACCOUNT_AVAILABLE_BALANCE;
     END;

     EXEC SQL
       INSERT INTO ACCOUNT
              (ACCOUNT_EYECATCHER, ACCOUNT_CUSTOMER_NUMBER,
               ACCOUNT_SORTCODE, ACCOUNT_NUMBER,
               ACCOUNT_TYPE, ACCOUNT_INTEREST_RATE,
               ACCOUNT_OPENED, ACCOUNT_OVERDRAFT_LIMIT,
               ACCOUNT_LAST_STATEMENT, ACCOUNT_NEXT_STATEMENT,
               ACCOUNT_AVAILABLE_BALANCE, ACCOUNT_ACTUAL_BALANCE)
       VALUES (:HV_ACCOUNT_EYECATCHER, :HV_ACCOUNT_CUST_NO,
               :HV_ACCOUNT_SORT_CODE, :HV_ACCOUNT_NUMBER,
               :HV_ACCOUNT_TYPE, :HV_ACCOUNT_INTEREST_RATE,
               :HV_ACCOUNT_OPENED, :HV_ACCOUNT_OVERDRAFT_LIMIT,
               :HV_ACCOUNT_LAST_STMT_DATE, :HV_ACCOUNT_NEXT_STMT_DATE,
               :HV_ACCOUNT_AVAILABLE_BALANCE,
               :HV_ACCOUNT_ACTUAL_BALANCE);

     IF SQLCODE ^= 0 THEN DO;
       WS_SQLCODE_DISPLAY = CHAR(SQLCODE);
       CALL SET_REASON_CODE;
       PUT SKIP LIST('Error inserting rows on ACCOUNT table.' ||
                     ' ACC no=' || HV_ACCOUNT_NUMBER ||
                     ' SORTCODE=' || HV_ACCOUNT_SORT_CODE ||
                     ' SQLCODE=' || WS_SQLCODE_DISPLAY ||
                     ' REASON=' || DISP_REASON_CODE ||
                     ' SQLSTATE=' || SQLSTATE);
       STOP_CODE = 12;
       CALL PROGRAM_DONE;
     END;

     LAST_ACCOUNT_NUMBER      = HV_ACCOUNT_NUMBER;
     NUMBER_OF_ACCOUNTS_TOTAL = NUMBER_OF_ACCOUNTS_TOTAL + 1;
     WS_ACCOUNT_NUMBER        = WS_ACCOUNT_NUMBER + 1;

   END POPULATE_ACC;

   /*****************************************************************/
   /* GENERATE_OPENED_DATE - Generate account open date            */
   /*****************************************************************/
   GENERATE_OPENED_DATE: PROC;

     WS_ACCOUNT_OPENED_DAY   =
       TRUNC((28 - 1) * RANDOM()) + 1;
     WS_ACCOUNT_OPENED_MONTH =
       TRUNC((12 - 1) * RANDOM()) + 1;
     WS_ACCOUNT_OPENED_YEAR  =
       TRUNC(((2014 - CUSTOMER_DOB_YEAR) * RANDOM()) +
             CUSTOMER_DOB_YEAR);
     HV_ACCOUNT_OPENED_DAY   =
       SUBSTR(CHAR(WS_ACCOUNT_OPENED_DAY + 100), 2, 2);
     HV_ACCOUNT_OPENED_MONTH =
       SUBSTR(CHAR(WS_ACCOUNT_OPENED_MONTH + 100), 2, 2);
     HV_ACCOUNT_OPENED_YEAR  =
       CHAR(WS_ACCOUNT_OPENED_YEAR);

     OPENED_DATE_ATTEMPTS = OPENED_DATE_ATTEMPTS + 1;

     IF WS_ACCOUNT_OPENED_YEAR > CUSTOMER_DOB_YEAR THEN DO;
       OPENED_DATE_VALID = 'Y';
       RETURN;
     END;
     IF OPENED_DATE_ATTEMPTS > 100 THEN DO;
       OPENED_DATE_VALID   = 'Y';
       HV_ACCOUNT_OPENED_DAY   = CUSTOMER_DOB_DAY;
       HV_ACCOUNT_OPENED_MONTH = CUSTOMER_DOB_MONTH;
       HV_ACCOUNT_OPENED_YEAR  = CUSTOMER_DOB_YEAR;
     END;

   END GENERATE_OPENED_DATE;

