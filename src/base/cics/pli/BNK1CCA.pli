*PROCESS SYSTEM(CICS) MARGINS(1,72);
 /***************************************************************** */
 /*                                                                */
 /*  Copyright IBM Corp. 2023                                      */
 /*                                                                */
 /***************************************************************** */
 /***************************************************************** */
 /* BNK1CCA - Display accounts for a customer                     */
 /* Receives customer number, links to INQACCCU, displays list    */
 /* of accounts.  Transaction: OCCA                               */
 /***************************************************************** */
 BNK1CCA: PROCEDURE(COMM_AREA_PTR) OPTIONS(MAIN REENTRANT);

   DCL COMM_AREA_PTR POINTER;

   /*****************************************************************/
   /* DFHCOMMAREA                                                   */
   /*****************************************************************/
   DCL 1 DFHCOMMAREA BASED(COMM_AREA_PTR),
     3 COMM_EYE     CHAR(4),
     3 COMM_SCODE   CHAR(6),
     3 COMM_CUSTNO  CHAR(10),
     3 COMM_NAME,
       5 COMM_TITLE CHAR(10),
       5 COMM_FNAME CHAR(50),
       5 COMM_LNAME CHAR(50),
     3 COMM_DOB,
       5 COMM_DOB_DD   CHAR(2),
       5 COMM_DOB_MM   CHAR(2),
       5 COMM_DOB_YYYY CHAR(4),
     3 COMM_PHONE   CHAR(20),
     3 COMM_ADDR,
       5 COMM_ADDR1  CHAR(60),
       5 COMM_ADDR2  CHAR(60),
       5 COMM_ADDR3  CHAR(40);

   /*****************************************************************/
   /* BMS map                                                       */
   /*****************************************************************/
   %INCLUDE BNK1ACC;
   DCL 1 BNK1ACC_MAP LIKE BNK1ACC_TMPL;

   /*****************************************************************/
   /* AID key definitions                                           */
   /*****************************************************************/
   %INCLUDE DFHAID;

   /*****************************************************************/
   /* INQACCCU parameters                                           */
   /*****************************************************************/
   DCL INQACCCU_PROGRAM CHAR(8) INIT('INQACCCU');
   %INCLUDE INQACCCU;
   DCL 1 INQACCCU_COMMAREA LIKE INQACCCU_TMPL;

   /*****************************************************************/
   /* Working storage                                               */
   /*****************************************************************/
   DCL WS_CICS_RESP  FIXED BIN(31) INIT(0);
   DCL WS_CICS_RESP2 FIXED BIN(31) INIT(0);

   DCL 1 WS_FAIL_INFO,
     3 WS_FAIL_PROG        CHAR(9)  INIT('BNK1CCA  '),
     3 WS_CICS_FAIL_MSG    CHAR(70) INIT(' '),
     3 WS_FAIL_RESP_LBL    CHAR(6)  INIT(' RESP='),
     3 WS_CICS_RESP_DISP   CHAR(10) INIT(' '),
     3 WS_FAIL_RESP2_LBL   CHAR(7)  INIT(' RESP2='),
     3 WS_CICS_RESP2_DISP  CHAR(10) INIT(' '),
     3 WS_FAIL_ABEND_MSG   CHAR(15)
                           INIT(' ABENDING TASK.');

   DCL SEND_FLAG      CHAR(1) INIT('E');
   DCL VALID_DATA_SW  CHAR(1) INIT('Y');

   DCL END_OF_SESSION_MESSAGE CHAR(13) INIT('Session Ended');
   DCL COMMUNICATION_AREA     CHAR(1) INIT(' ');

   DCL 1 WS_COMM_AREA,
     3 WS_COMM_EYE     CHAR(4)  INIT(' '),
     3 WS_COMM_SCODE   CHAR(6)  INIT(' '),
     3 WS_COMM_CUSTNO  CHAR(10) INIT(' '),
     3 WS_COMM_NAME,
       5 WS_COMM_TITLE CHAR(10) INIT(' '),
       5 WS_COMM_FNAME CHAR(50) INIT(' '),
       5 WS_COMM_LNAME CHAR(50) INIT(' '),
     3 WS_COMM_DOB,
       5 WS_COMM_DOB_DD   CHAR(2) INIT(' '),
       5 WS_COMM_DOB_MM   CHAR(2) INIT(' '),
       5 WS_COMM_DOB_YYYY CHAR(4) INIT(' '),
     3 WS_COMM_PHONE   CHAR(20) INIT(' '),
     3 WS_COMM_ADDR,
       5 WS_COMM_ADDR1  CHAR(60) INIT(' '),
       5 WS_COMM_ADDR2  CHAR(60) INIT(' '),
       5 WS_COMM_ADDR3  CHAR(40) INIT(' ');

   DCL WS_INDEX               FIXED BIN(31) INIT(0);
   DCL SCODE_CHAR             CHAR(6)       INIT(' ');
   DCL ACCNO_CHAR             CHAR(8)       INIT(' ');
   DCL NUMBER_OF_ACCOUNTS_DISPLAY CHAR(2)   INIT(' ');
   DCL WS_AVAIL_BAL_SIGN      CHAR(1) INIT(' ');
   DCL WS_ACT_BAL_SIGN        CHAR(1) INIT(' ');
   DCL COMPANY_NAME_FULL      CHAR(32) INIT(' ');

   DCL 1 WS_CONVERSION,
     3 WS_AVAIL_BAL_9       FIXED DEC(12,2) INIT(0),
     3 * UNION,
       5 WS_AVAIL_BAL_CONV_X CHAR(12),
         7 WS_AVAIL_BAL_X_PND  CHAR(10),
         7 WS_AVAIL_BAL_X_PNCE CHAR(2);

   DCL 1 WS_ACT_CONVERSION,
     3 WS_ACT_BAL_9          FIXED DEC(12,2) INIT(0),
     3 * UNION,
       5 WS_ACT_BAL_CONV_X   CHAR(12),
         7 WS_ACT_BAL_X_PND  CHAR(10),
         7 WS_ACT_BAL_X_PNCE CHAR(2);

   DCL DUMP_TITLE CHAR(16) INIT('BNK1CCA DUMP    ');

   /*****************************************************************/
   /* Date/Time                                                     */
   /*****************************************************************/
   DCL WS_U_TIME     FIXED BIN(63) INIT(0);
   DCL WS_ORIG_DATE  CHAR(10) INIT(' ');
   DCL 1 WS_ORIG_DATE_GRP DEFINED(WS_ORIG_DATE),
     3 WS_ORIG_DATE_DD   CHAR(2),
     3 WS_ORIG_DATE_SEP1 CHAR(1),
     3 WS_ORIG_DATE_MM   CHAR(2),
     3 WS_ORIG_DATE_SEP2 CHAR(1),
     3 WS_ORIG_DATE_YYYY CHAR(4);

   DCL 1 WS_TIME_DATA,
     3 WS_TIME_NOW CHAR(6) INIT(' '),
     3 * DEFINED(WS_TIME_NOW),
       5 WS_TIME_NOW_HH CHAR(2),
       5 WS_TIME_NOW_MM CHAR(2),
       5 WS_TIME_NOW_SS CHAR(2);

   DCL WS_ABEND_PGM CHAR(8) INIT('ABNDPROC');

   %INCLUDE ABNDINFO;
   DCL 1 ABNDINFO_REC LIKE ABNDINFO_TMPL;

   /*****************************************************************/
   /* MAIN PROCEDURE                                                */
   /*****************************************************************/
   SELECT;
     WHEN (EIBCALEN = 0) DO;
       BNK1ACC_MAP = LOW(LENGTH(BNK1ACC_MAP));
       BNK1ACC_MAP.CUSTNOL = -1;
       SEND_FLAG = 'E';
       CALL SEND_MAP;
     END;
     WHEN (EIBAID = DFHPA1 | EIBAID = DFHPA2 |
           EIBAID = DFHPA3) DO;
       /* PA key - ignore */
     END;
     WHEN (EIBAID = DFHPF3) DO;
       EXEC CICS RETURN TRANSID('OMEN')
            IMMEDIATE
            RESP(WS_CICS_RESP)
            RESP2(WS_CICS_RESP2);
     END;
     WHEN (EIBAID = DFHAID | EIBAID = DFHPF12) DO;
       CALL SEND_TERMINATION_MSG;
       EXEC CICS RETURN;
     END;
     WHEN (EIBAID = DFHCLEAR) DO;
       EXEC CICS SEND CONTROL ERASE FREEKB;
       EXEC CICS RETURN;
     END;
     WHEN (EIBAID = DFHENTER) DO;
       CALL PROCESS_MAP;
     END;
     OTHERWISE DO;
       BNK1ACC_MAP = LOW(LENGTH(BNK1ACC_MAP));
       BNK1ACC_MAP.MESSAGEI = 'Invalid key pressed.';
       BNK1ACC_MAP.CUSTNOL = -1;
       SEND_FLAG = 'A';
       CALL SEND_MAP;
     END;
   END;

   EXEC CICS RETURN
        TRANSID('OCCA')
        COMMAREA(WS_COMM_AREA)
        LENGTH(248)
        RESP(WS_CICS_RESP)
        RESP2(WS_CICS_RESP2);

   IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
     WS_FAIL_INFO = '';
     WS_CICS_FAIL_MSG =
       'BNK1CCA - A010 - RETURN TRANSID(OCCA) FAIL';
     WS_CICS_RESP_DISP  = CHAR(WS_CICS_RESP);
     WS_CICS_RESP2_DISP = CHAR(WS_CICS_RESP2);
     CALL SETUP_ABND_INFO(
       'A010 - RETURN TRANSID(OCCA) FAIL');
     CALL ABEND_THIS_TASK;
   END;

   /*****************************************************************/
   /* PROCESS_MAP                                                   */
   /*****************************************************************/
   PROCESS_MAP: PROC;
     CALL RECEIVE_MAP;
     CALL EDIT_DATA;
     IF VALID_DATA_SW = 'Y' THEN
       CALL GET_CUST_DATA;
     SEND_FLAG = 'A';
     CALL SEND_MAP;
   END PROCESS_MAP;

   /*****************************************************************/
   /* RECEIVE_MAP                                                   */
   /*****************************************************************/
   RECEIVE_MAP: PROC;
     INQACCCU_COMMAREA = '';
     EXEC CICS RECEIVE MAP('BNK1ACC')
               MAPSET('BNK1ACC')
               INTO(BNK1ACC_MAP)
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2);
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG =
         'BNK1CCA - RM010 - RECEIVE MAP FAIL ';
       WS_CICS_RESP_DISP  = CHAR(WS_CICS_RESP);
       WS_CICS_RESP2_DISP = CHAR(WS_CICS_RESP2);
       CALL SETUP_ABND_INFO('RM010 - RECEIVE MAP FAIL');
       CALL ABEND_THIS_TASK;
     END;
   END RECEIVE_MAP;

   /*****************************************************************/
   /* EDIT_DATA                                                     */
   /*****************************************************************/
   EDIT_DATA: PROC;
     IF ^VERIFY(TRIM(BNK1ACC_MAP.CUSTNOI),'0123456789') = 0 THEN DO;
       BNK1ACC_MAP.MESSAGEI = 'Please enter a customer number.';
       VALID_DATA_SW = 'N';
     END;
   END EDIT_DATA;

   /*****************************************************************/
   /* GET_CUST_DATA - link to INQACCCU                             */
   /*****************************************************************/
   GET_CUST_DATA: PROC;
     INQACCCU_COMMAREA.NUMBER_OF_ACCOUNTS = 20;
     INQACCCU_COMMAREA.COMM_SUCCESS = 'N';
     INQACCCU_COMMAREA.CUSTOMER_NUMBER = BNK1ACC_MAP.CUSTNOI;
     INQACCCU_COMMAREA.COMM_PCB_POINTER = SYSNULL();

     EXEC CICS LINK PROGRAM(INQACCCU_PROGRAM)
               COMMAREA(INQACCCU_COMMAREA)
               RESP(WS_CICS_RESP)
               RESP2(WS_CICS_RESP2)
               SYNCONRETURN;

     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_FAIL_INFO = '';
       WS_CICS_FAIL_MSG =
         'BNK1CCA - GCD010 - LINK INQACCCU  FAIL      ';
       WS_CICS_RESP_DISP  = CHAR(WS_CICS_RESP);
       WS_CICS_RESP2_DISP = CHAR(WS_CICS_RESP2);
       CALL SETUP_ABND_INFO(
         'GCD010 - LINK INQACCCU FAIL');
       CALL ABEND_THIS_TASK;
     END;

     IF INQACCCU_COMMAREA.CUSTOMER_FOUND = 'N' THEN DO;
       BNK1ACC_MAP.MESSAGEI = ' ';
       BNK1ACC_MAP.MESSAGEI = 'Unable to find customer ' ||
                  TRIM(INQACCCU_COMMAREA.CUSTOMER_NUMBER);
       DO WS_INDEX = 1 TO 10;
         BNK1ACC_MAP.ACCOUNT(WS_INDEX) = ' ';
       END;
       RETURN;
     END;

     DO WS_INDEX = 1 TO 10;
       BNK1ACC_MAP.ACCOUNT(WS_INDEX) = ' ';
     END;

     IF INQACCCU_COMMAREA.NUMBER_OF_ACCOUNTS = 0 THEN
       BNK1ACC_MAP.MESSAGEI = 'No accounts found for customer';
     ELSE DO;
       IF INQACCCU_COMMAREA.COMM_SUCCESS = 'N' THEN DO;
         BNK1ACC_MAP.MESSAGEI = ' ';
         BNK1ACC_MAP.MESSAGEI =
           'Error accessing accounts for customer ' ||
           TRIM(INQACCCU_COMMAREA.CUSTOMER_NUMBER) || '.';
       END;
       ELSE DO;
         NUMBER_OF_ACCOUNTS_DISPLAY =
           CHAR(INQACCCU_COMMAREA.NUMBER_OF_ACCOUNTS);
         BNK1ACC_MAP.MESSAGEI = ' ';
         BNK1ACC_MAP.MESSAGEI = TRIM(NUMBER_OF_ACCOUNTS_DISPLAY) ||
           ' accounts found';
         DO WS_INDEX = 1 TO
            INQACCCU_COMMAREA.NUMBER_OF_ACCOUNTS
            WHILE (WS_INDEX <= 10);
           SCODE_CHAR =
             INQACCCU_COMMAREA.COMM_SCODE(WS_INDEX);
           ACCNO_CHAR =
             CHAR(INQACCCU_COMMAREA.COMM_ACCNO(WS_INDEX));
           BNK1ACC_MAP.ACCOUNT(WS_INDEX) = ' ';
           WS_AVAIL_BAL_SIGN = ' ';
           WS_ACT_BAL_SIGN = ' ';
           IF INQACCCU_COMMAREA.COMM_AVAIL_BAL(WS_INDEX)
              < 0 THEN
             WS_AVAIL_BAL_SIGN = '-';
           ELSE
             WS_AVAIL_BAL_SIGN = '+';
           IF INQACCCU_COMMAREA.COMM_ACTUAL_BAL(WS_INDEX)
              < 0 THEN
             WS_ACT_BAL_SIGN = '-';
           ELSE
             WS_ACT_BAL_SIGN = '+';
           WS_AVAIL_BAL_9 =
             ABS(INQACCCU_COMMAREA.COMM_AVAIL_BAL(
                 WS_INDEX));
           WS_ACT_BAL_9   =
             ABS(INQACCCU_COMMAREA.COMM_ACTUAL_BAL(
                 WS_INDEX));
           BNK1ACC_MAP.ACCOUNT(WS_INDEX) =
             SCODE_CHAR || '      ' ||
             ACCNO_CHAR || '         ' ||
             INQACCCU_COMMAREA.COMM_ACC_TYPE(WS_INDEX) ||
             '       ' ||
             WS_AVAIL_BAL_SIGN || WS_AVAIL_BAL_X_PND ||
             '.' || WS_AVAIL_BAL_X_PNCE || '  ' ||
             WS_ACT_BAL_SIGN || WS_ACT_BAL_X_PND ||
             '.' || WS_ACT_BAL_X_PNCE;
         END;
       END;
     END;
   END GET_CUST_DATA;

   /*****************************************************************/
   /* SEND_MAP                                                      */
   /*****************************************************************/
   SEND_MAP: PROC;
     IF SEND_FLAG = 'E' THEN DO;
       EXEC CICS SEND MAP('BNK1ACC')
                 MAPSET('BNK1ACC')
                 FROM(BNK1ACC_MAP)
                 ERASE CURSOR FREEKB
                 RESP(WS_CICS_RESP)
                 RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         WS_CICS_FAIL_MSG =
           'BNK1CCA - SM010 - SEND MAP ERASE FAIL';
         CALL SETUP_ABND_INFO('SM010 - SEND MAP ERASE FAIL');
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;
     IF SEND_FLAG = 'D' THEN DO;
       EXEC CICS SEND MAP('BNK1ACC')
                 MAPSET('BNK1ACC')
                 FROM(BNK1ACC_MAP)
                 DATAONLY CURSOR FREEKB
                 RESP(WS_CICS_RESP)
                 RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         WS_CICS_FAIL_MSG =
           'BNK1CCA - SM010 - SEND MAP DATAONLY FAIL';
         CALL SETUP_ABND_INFO(
           'SM010 - SEND MAP DATAONLY FAIL');
         CALL ABEND_THIS_TASK;
       END;
       RETURN;
     END;
     IF SEND_FLAG = 'A' THEN DO;
       EXEC CICS SEND MAP('BNK1ACC')
                 MAPSET('BNK1ACC')
                 FROM(BNK1ACC_MAP)
                 DATAONLY ALARM CURSOR FREEKB
                 RESP(WS_CICS_RESP)
                 RESP2(WS_CICS_RESP2);
       IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
         WS_CICS_FAIL_MSG =
           'BNK1CCA - SM010 - SEND MAP ALARM FAIL';
         CALL SETUP_ABND_INFO(
           'SM010 - SEND MAP ALARM FAIL');
         CALL ABEND_THIS_TASK;
       END;
     END;
   END SEND_MAP;

   /*****************************************************************/
   /* SEND_TERMINATION_MSG                                          */
   /*****************************************************************/
   SEND_TERMINATION_MSG: PROC;
     EXEC CICS SEND TEXT
               FROM(END_OF_SESSION_MESSAGE)
               ERASE FREEKB
               RESP(WS_CICS_RESP) RESP2(WS_CICS_RESP2);
     IF WS_CICS_RESP ^= DFHRESP(NORMAL) THEN DO;
       WS_CICS_FAIL_MSG =
         'BNK1CCA - STM010 - SEND TEXT FAIL';
       CALL SETUP_ABND_INFO('STM010 - SEND TEXT FAIL');
       CALL ABEND_THIS_TASK;
     END;
   END SEND_TERMINATION_MSG;

   /*****************************************************************/
   /* ABEND_THIS_TASK                                               */
   /*****************************************************************/
   ABEND_THIS_TASK: PROC;
     PUT SKIP LIST(WS_FAIL_INFO);
     EXEC CICS ABEND ABCODE('HBNK') NODUMP;
   END ABEND_THIS_TASK;

   /*****************************************************************/
   /* SETUP_ABND_INFO                                               */
   /*****************************************************************/
   SETUP_ABND_INFO: PROC (P_MSG);
     DCL P_MSG CHAR(*);
     ABNDINFO_REC = '';
     ABNDINFO_REC.ABND_RESPCODE  = EIBRESP;
     ABNDINFO_REC.ABND_RESP2CODE = EIBRESP2;
     EXEC CICS ASSIGN APPLID(ABNDINFO_REC.ABND_APPLID);
     ABNDINFO_REC.ABND_TASKNO_KEY = EIBTASKN;
     ABNDINFO_REC.ABND_TRANID     = EIBTRNID;
     CALL POPULATE_TIME_DATE;
     ABNDINFO_REC.ABND_DATE = WS_ORIG_DATE;
     ABNDINFO_REC.ABND_TIME = WS_TIME_NOW_HH || ':' ||
                 WS_TIME_NOW_MM || ':' || WS_TIME_NOW_SS;
     ABNDINFO_REC.ABND_UTIME_KEY = WS_U_TIME;
     ABNDINFO_REC.ABND_CODE = 'HBNK';
     EXEC CICS ASSIGN PROGRAM(ABNDINFO_REC.ABND_PROGRAM);
     ABNDINFO_REC.ABND_SQLCODE = '0';
     ABNDINFO_REC.ABND_FREEFORM = SUBSTR(P_MSG || ' EIBRESP=' ||
       CHAR(EIBRESP) || ' RESP2=' || CHAR(EIBRESP2),1,80);
     EXEC CICS LINK PROGRAM(WS_ABEND_PGM)
               COMMAREA(ABNDINFO_REC);
   END SETUP_ABND_INFO;

   /*****************************************************************/
   /* POPULATE_TIME_DATE                                            */
   /*****************************************************************/
   POPULATE_TIME_DATE: PROC;
     EXEC CICS ASKTIME ABSTIME(WS_U_TIME);
     EXEC CICS FORMATTIME
               ABSTIME(WS_U_TIME)
               DDMMYYYY(WS_ORIG_DATE)
               TIME(WS_TIME_NOW)
               DATESEP;
   END POPULATE_TIME_DATE;

 END BNK1CCA;
